# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces mean a line break in markdown.
trim_trailing_whitespace = false

[*.po]
# Translation catalogues are edited by native speakers, not programmers.
# Never reformat them automatically.
trim_trailing_whitespace = false
insert_final_newline = true
