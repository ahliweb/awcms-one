# awcms-one — root configuration
#
# This file covers variables read by ROOT-LEVEL scripts (packages/gerbang/,
# tools/) and root `compose.yaml` only.
#
#   - apps/cms's own runtime configuration (DATABASE_URL, APP_URL, and the
#     rest of its ~24KB of documented variables) lives in its OWN
#     apps/cms/.env.example, copied to apps/cms/.env. It is a separate
#     deployable with its own database and its own concerns; this file does
#     not duplicate it.
#   - apps/storefront does not exist yet (issue #5). It will need its own
#     env vars — at minimum an origin to reach apps/cms's public API — and
#     they will be documented here, or in its own .env.example, once it
#     lands. Nothing is declared for it now: an unset variable nobody reads
#     yet is a worse kind of documentation than no variable at all.
#
#   cp .env.example .env
#
# `.env` is never committed (`.gitignore` / the CI "hygiene" job's own
# check). Every default below the "Local PostgreSQL" heading is a
# DEVELOPMENT convenience, never a production credential — see
# docs/deployment.md's "Local database" for the full sequence these
# variables plug into.

# Overrides "today" for packages/gerbang/audit-rilis.mjs's changeset-age
# arithmetic. Read as a LOCAL date, `YYYY-MM-DD`.
#
# Not something a contributor normally sets. It exists so the gate's own
# wall-clock logic can be tested against a fixed date instead of the real
# clock — a test that computed its expected dates from the same clock the
# gate reads would only prove that subtraction works, not that the gate
# reads the calendar correctly. Leave this unset for ordinary use; the gate
# then reads the machine's real local date.
# RELEASE_TODAY=2026-09-15

# Overrides the repo root tools/knowledge-graph-combine.mjs and
# tools/knowledge-obsidian-export.mjs operate on (issue #11). Exists so
# tests/knowledge-no-subtree-write.test.mjs can run those tools for real
# against a disposable fixture tree instead of this repo's own apps/cms/ —
# see either tool's own top-of-file comment. Never set this for ordinary
# use; both tools then resolve the real repo root as before.
# KNOWLEDGE_GRAPH_ROOT=/path/to/a/fixture/tree

# ---------------------------------------------------------------------------
# Local PostgreSQL via docker compose (`bun run db:up` / `db:down` / `db:reset`)
# ---------------------------------------------------------------------------
#
# The database every role below connects to.
POSTGRES_DB=awcms
# The Postgres image's own superuser. This is ALSO the migration OWNER
# connection `bun run db:migrate:cms` must run as — never the app's own
# runtime connection, which this repo's own compose.yaml never grants
# `POSTGRES_USER` any special role for: it is a superuser by construction of
# the official postgres image, and a superuser bypasses `FORCE ROW LEVEL
# SECURITY` outright (see apps/cms/.env.example's own `DATABASE_URL` comment
# and apps/cms/sql/019_awcms_db_role_separation.sql's header). Leaving this
# or the password below unset
# makes `bun run db:up` refuse to start (compose.yaml's `${VAR:?...}` guard)
# rather than start a database with a guessable superuser password.
POSTGRES_USER=awcms
POSTGRES_PASSWORD=awcms_dev_password
# Host port the container's own 5432 is published on. Defaults to 5433, not
# 5432: a development machine commonly already has something listening on
# 5432, and colliding with it is a more confusing failure than picking a
# different port. `bun run db:migrate:cms` and `bun run db:seed:cms` both
# need this to match if you change it.
POSTGRES_PORT=5433

# The three roles apps/cms's own migrations create `NOLOGIN` and passwordless
# ON PURPOSE — a password is a secret and never belongs in a committed
# migration (apps/cms/sql/019_awcms_db_role_separation.sql creates
# `awcms_app`, apps/cms/sql/022_awcms_db_worker_setup_roles.sql creates
# `awcms_worker`/`awcms_setup`; doc 18 §Model role database in apps/cms).
# `docker/postgres-init/01-create-least-privilege-roles.sh` activates LOGIN
# with these passwords BEFORE any migration runs, so each migration's own
# `IF NOT EXISTS` guard is then a no-op that preserves LOGIN — see that
# migration's own header. Leaving any of these unset makes `bun run db:up`
# refuse to start (the init script's own guard) rather than silently create a
# role nothing can then authenticate as.
AWCMS_APP_PASSWORD=awcms_app_dev_password
AWCMS_WORKER_PASSWORD=awcms_worker_dev_password
AWCMS_SETUP_PASSWORD=awcms_setup_dev_password

# ---------------------------------------------------------------------------
# Seed script (tools/seed-borneojek-mart.ts, `bun run db:seed:cms`)
# ---------------------------------------------------------------------------
#
# This script does NOT start apps/cms itself — it drives an ALREADY RUNNING
# instance over HTTP, the same way apps/storefront's build does (see
# docs/deployment.md). Start one yourself first (`cd apps/cms && bun run
# dev`, or `bun run build && bun run start`), then run `bun run db:seed:cms`
# from the repo root in a second terminal. Leaving this unset targets
# `bun run dev`'s own default origin, so a fresh clone needs no edit here.
AWCMS_BASE_URL=http://localhost:4321

# The tenant this script bootstraps via `POST /api/v1/setup/initialize`.
# Leaving these unset seeds the borneojek-mart tenant these defaults name;
# only change them to seed a DIFFERENT tenant into the same empty database
# (setup is once-only per database — a second run with the same values is a
# no-op, see the script's own docblock).
SEED_TENANT_CODE=borneojek-mart
SEED_TENANT_NAME=BjekMart
SEED_OFFICE_CODE=HQ-BJEKMART
SEED_OFFICE_NAME=BjekMart Head Office

# The owner account this script creates through the same bootstrap call.
# Deliberately NOT a real address this platform owns — it is a sign-in
# identifier only, and this script never sends it any mail. Leaving
# SEED_OWNER_PASSWORD unset makes the script generate a random one and print
# it once (never stored, never retrievable again — same convention as
# media-lenterakalteng's own seed script); set it yourself to choose one
# instead.
SEED_OWNER_EMAIL=owner@borneojek-mart.local
SEED_OWNER_PASSWORD=

# Issue #29 — `ensureTenantDomains` registers the storefront's own origins in
# `awcms_tenant_domains` so the anonymous storefront routes can resolve a
# tenant from the request Origin/Host. It connects to Postgres DIRECTLY (the
# one exception to this script's HTTP-only rule — see its own docblock),
# reusing POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_PORT/POSTGRES_DB above
# (the same owner connection `bun run db:migrate:cms` uses). Empty means
# "localhost" (`bun run db:up`'s own default host); set it only when
# Postgres runs somewhere else.
SEED_DB_HOST=

# The CUSTOM domain this script marks `active` (manually attested — see
# `ensureTenantDomains`'s own docblock) alongside a fixed second one,
# `localhost` (what a `bun run dev`/`astro dev` storefront's Origin header
# names). Empty means "mart.borneojek.com", the real production hostname
# this demo tenant would use.
SEED_STOREFRONT_HOSTNAME=

# The `Origin` header `ensureOrders` sends when calling the anonymous
# `POST /api/v1/commerce/storefront/orders` endpoint — must name one of the
# two hostnames `ensureTenantDomains` just registered, or the call resolves
# no tenant and answers the same neutral 404 a genuinely unknown origin
# would. Empty means "http://localhost:4321", matching the `localhost` row
# above.
SEED_STOREFRONT_ORIGIN=

# ---------------------------------------------------------------------------
# seputarborneo importer (tools/import-seputarborneo.ts, `bun run
# import:seputarborneo`, issue #58) — an EXPORTER to apps/cms's own
# `blog:legacy:import` pipeline, see docs/deployment.md's "Importing
# seputarborneo" for the full runbook.
# ---------------------------------------------------------------------------
#
# The default (export) mode reads only the one variable below and makes no
# network call at all — it needs no `apps/cms` running. `--assign-
# institutions` (a small follow-up pass, run AFTER `bun run blog:legacy
# :import --commit`) additionally reuses AWCMS_BASE_URL/SEED_TENANT_CODE/
# SEED_OWNER_EMAIL/SEED_OWNER_PASSWORD above — the SAME `borneojek-mart`
# tenant `tools/seed-borneojek-mart.ts` bootstraps, never a second set of
# tenant variables.

# Absolute path to the seputarborneo MariaDB dump (`.sql.gz`, gzip-compressed
# `mariadb-dump` output). Streamed straight through a gunzip transform and
# never copied anywhere under this repository — see the script's own header.
# Left unset, the script refuses to run rather than guessing a path.
SEPUTARBORNEO_DUMP=
