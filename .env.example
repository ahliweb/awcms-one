# awcms-one — root configuration
#
# This file covers variables read by ROOT-LEVEL scripts (packages/gerbang/,
# tools/) and root `compose.yaml` only.
#
#   - apps/cms's own runtime configuration (DATABASE_URL, APP_URL, and the
#     rest of its ~24KB of documented variables) lives in its OWN
#     apps/cms/.env.example, copied to apps/cms/.env. It is a separate
#     deployable with its own database and its own concerns; this file does
#     not duplicate it.
#   - apps/storefront does not exist yet (issue #5). It will need its own
#     env vars — at minimum an origin to reach apps/cms's public API — and
#     they will be documented here, or in its own .env.example, once it
#     lands. Nothing is declared for it now: an unset variable nobody reads
#     yet is a worse kind of documentation than no variable at all.
#
#   cp .env.example .env
#
# `.env` is never committed (`.gitignore` / the CI "hygiene" job's own
# check). Every default below the "Local PostgreSQL" heading is a
# DEVELOPMENT convenience, never a production credential — see
# docs/deployment.md's "Local database" for the full sequence these
# variables plug into.

# Overrides "today" for packages/gerbang/audit-rilis.mjs's changeset-age
# arithmetic. Read as a LOCAL date, `YYYY-MM-DD`.
#
# Not something a contributor normally sets. It exists so the gate's own
# wall-clock logic can be tested against a fixed date instead of the real
# clock — a test that computed its expected dates from the same clock the
# gate reads would only prove that subtraction works, not that the gate
# reads the calendar correctly. Leave this unset for ordinary use; the gate
# then reads the machine's real local date.
# RELEASE_TODAY=2026-09-15

# Overrides the repo root tools/knowledge-graph-combine.mjs and
# tools/knowledge-obsidian-export.mjs operate on (issue #11). Exists so
# tests/knowledge-no-subtree-write.test.mjs can run those tools for real
# against a disposable fixture tree instead of this repo's own apps/cms/ —
# see either tool's own top-of-file comment. Never set this for ordinary
# use; both tools then resolve the real repo root as before.
# KNOWLEDGE_GRAPH_ROOT=/path/to/a/fixture/tree

# ---------------------------------------------------------------------------
# Local PostgreSQL via docker compose (`bun run db:up` / `db:down` / `db:reset`)
# ---------------------------------------------------------------------------
#
# The database every role below connects to.
POSTGRES_DB=awcms
# The Postgres image's own superuser. This is ALSO the migration OWNER
# connection `bun run db:migrate:cms` must run as — never the app's own
# runtime connection, which this repo's own compose.yaml never grants
# `POSTGRES_USER` any special role for: it is a superuser by construction of
# the official postgres image, and a superuser bypasses `FORCE ROW LEVEL
# SECURITY` outright (see apps/cms/.env.example's own `DATABASE_URL` comment
# and apps/cms/sql/019_awcms_db_role_separation.sql's header). Leaving this
# or the password below unset
# makes `bun run db:up` refuse to start (compose.yaml's `${VAR:?...}` guard)
# rather than start a database with a guessable superuser password.
POSTGRES_USER=awcms
POSTGRES_PASSWORD=awcms_dev_password
# Host port the container's own 5432 is published on. Defaults to 5433, not
# 5432: a development machine commonly already has something listening on
# 5432, and colliding with it is a more confusing failure than picking a
# different port. `bun run db:migrate:cms` and `bun run db:seed:cms` both
# need this to match if you change it.
POSTGRES_PORT=5433

# The three roles apps/cms's own migrations create `NOLOGIN` and passwordless
# ON PURPOSE — a password is a secret and never belongs in a committed
# migration (apps/cms/sql/019_awcms_db_role_separation.sql creates
# `awcms_app`, apps/cms/sql/022_awcms_db_worker_setup_roles.sql creates
# `awcms_worker`/`awcms_setup`; doc 18 §Model role database in apps/cms).
# `docker/postgres-init/01-create-least-privilege-roles.sh` activates LOGIN
# with these passwords BEFORE any migration runs, so each migration's own
# `IF NOT EXISTS` guard is then a no-op that preserves LOGIN — see that
# migration's own header. Leaving any of these unset makes `bun run db:up`
# refuse to start (the init script's own guard) rather than silently create a
# role nothing can then authenticate as.
AWCMS_APP_PASSWORD=awcms_app_dev_password
AWCMS_WORKER_PASSWORD=awcms_worker_dev_password
AWCMS_SETUP_PASSWORD=awcms_setup_dev_password

# ---------------------------------------------------------------------------
# Seed script (tools/seed-borneojek-mart.ts, `bun run db:seed:cms`)
# ---------------------------------------------------------------------------
#
# This script does NOT start apps/cms itself — it drives an ALREADY RUNNING
# instance over HTTP, the same way apps/storefront's build does (see
# docs/deployment.md). Start one yourself first (`cd apps/cms && bun run
# dev`, or `bun run build && bun run start`), then run `bun run db:seed:cms`
# from the repo root in a second terminal. Leaving this unset targets
# `bun run dev`'s own default origin, so a fresh clone needs no edit here.
AWCMS_BASE_URL=http://localhost:4321

# The tenant this script bootstraps via `POST /api/v1/setup/initialize`.
# Leaving these unset seeds the borneojek-mart tenant these defaults name;
# only change them to seed a DIFFERENT tenant into the same empty database
# (setup is once-only per database — a second run with the same values is a
# no-op, see the script's own docblock).
SEED_TENANT_CODE=borneojek-mart
SEED_TENANT_NAME=BjekMart
SEED_OFFICE_CODE=HQ-BJEKMART
SEED_OFFICE_NAME=BjekMart Head Office

# The owner account this script creates through the same bootstrap call.
# Deliberately NOT a real address this platform owns — it is a sign-in
# identifier only, and this script never sends it any mail. Leaving
# SEED_OWNER_PASSWORD unset makes the script generate a random one and print
# it once (never stored, never retrievable again — same convention as
# media-lenterakalteng's own seed script); set it yourself to choose one
# instead.
SEED_OWNER_EMAIL=owner@borneojek-mart.local
SEED_OWNER_PASSWORD=

# Issue #29 — `ensureTenantDomains` registers the storefront's own origins in
# `awcms_tenant_domains` so the anonymous storefront routes can resolve a
# tenant from the request Origin/Host. It connects to Postgres DIRECTLY (the
# one exception to this script's HTTP-only rule — see its own docblock),
# reusing POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_PORT/POSTGRES_DB above
# (the same owner connection `bun run db:migrate:cms` uses). Empty means
# "localhost" (`bun run db:up`'s own default host); set it only when
# Postgres runs somewhere else.
SEED_DB_HOST=

# The CUSTOM domain this script marks `active` (manually attested — see
# `ensureTenantDomains`'s own docblock) alongside a fixed second one,
# `localhost` (what a `bun run dev`/`astro dev` storefront's Origin header
# names). Empty means "mart.borneojek.com", the real production hostname
# this demo tenant would use.
SEED_STOREFRONT_HOSTNAME=

# The `Origin` header `ensureOrders` sends when calling the anonymous
# `POST /api/v1/commerce/storefront/orders` endpoint — must name one of the
# two hostnames `ensureTenantDomains` just registered, or the call resolves
# no tenant and answers the same neutral 404 a genuinely unknown origin
# would. Empty means "http://localhost:4321", matching the `localhost` row
# above.
SEED_STOREFRONT_ORIGIN=

# ---------------------------------------------------------------------------
# seputarborneo importer (tools/import-seputarborneo.ts, `bun run
# import:seputarborneo`, issue #58) — an EXPORTER to apps/cms's own
# `blog:legacy:import` pipeline, see docs/deployment.md's "Importing
# seputarborneo" for the full runbook.
# ---------------------------------------------------------------------------
#
# The default (export) mode reads only the one variable below and makes no
# network call at all — it needs no `apps/cms` running. `--push-redirects`
# (posts redirects.json in 200-item, idempotency-keyed chunks; a dry run
# unless `--commit` is added) and `--assign-institutions` (a small follow-up
# pass, run AFTER `bun run blog:legacy:import --commit`) additionally reuse
# AWCMS_BASE_URL/SEED_TENANT_CODE/SEED_OWNER_EMAIL/SEED_OWNER_PASSWORD above
# — the SAME `borneojek-mart` tenant `tools/seed-borneojek-mart.ts`
# bootstraps, never a second set of tenant variables.

# Absolute path to the seputarborneo MariaDB dump (`.sql.gz`, gzip-compressed
# `mariadb-dump` output). Streamed straight through a gunzip transform and
# never copied anywhere under this repository — see the script's own header.
# Left unset, the script refuses to run rather than guessing a path.
SEPUTARBORNEO_DUMP=

# ---------------------------------------------------------------------------
# Production preflight (tools/deploy-preflight.mjs, `bun run deploy:preflight`
# — issue #150, ADR-0019)
# ---------------------------------------------------------------------------
#
# This gate checks the SHAPE of apps/storefront's own build env — the real,
# authoritative documentation for each variable below lives in
# apps/storefront/.env.example, which this repeats only the names of so the
# root-level script that reads them is covered by AGENTS.md's "every env
# variable a root-level script reads belongs in .env.example" rule. Set these
# in whatever env apps/storefront's own build actually reads (its own `.env`,
# or CI/CD secrets) — not here; this file documents the ROOT gate's
# expectations, not a second copy of the storefront's runtime config.
#
# SITE_PROFILE=toko            # toko | berita | landing — see docs/template.md
# SITE_URL=https://shop.example.test
# AWCMS_API_URL=https://cms.example.test
# AWCMS_API_TOKEN=             # build-time only, read-only, NEVER `PUBLIC_`-prefixed
# PUBLIC_AWCMS_ORIGIN=https://cms.example.test
# PUBLIC_GA_ID=                # optional, GA4 measurement id — public by design, exempted from the "PUBLIC_* looks like a secret" check
#
# `deploy:preflight` also spawns `bun run commerce:deploy:preflight` inside
# apps/cms — every variable THAT reads is documented in apps/cms/.env.example
# instead, per the same rule applied to that workspace's own gate.

# ---------------------------------------------------------------------------
# Server-side production deployment (tools/deploy/*.sh, `bun run
# deploy:production`/`deploy:remote`/`deploy:health`/`deploy:rollback` —
# issue #224, ADR-0022)
# ---------------------------------------------------------------------------
#
# These scripts run ONLY on the deployment/production host (or a host with
# this checkout and compose.production.yaml on it) — GitHub Actions never
# reads any variable in this section and never holds the credentials it
# implies. See docs/deployment.md's "Production deployment (server-side,
# explicit)" section for the full runbook.

# Where the deployment lock, the append-only audit log, and "what is
# currently deployed" state live. Left unset, every script defaults to
# /var/lib/awcms-one-deploy — a real production host creates this directory
# once (docs/deployment.md's "first-time host setup") with restrictive
# permissions; the test suite (tests/deploy-production.test.mjs) overrides
# this to a disposable temp directory so no test ever touches a real path.
# DEPLOY_STATE_DIR=/var/lib/awcms-one-deploy

# "true" skips the pre-migration backup step entirely. Never set this
# against a database holding real data — it exists only for a brand-new
# database with nothing yet to back up (e.g. the very first deploy that also
# runs the very first migration).
# DEPLOY_SKIP_BACKUP=false

# When set, deploy-production.sh calls this executable with the resolved
# image ref (name@sha256:digest) as its one argument to verify a signature
# before pulling proceeds to migration — e.g. a wrapper around
# `cosign verify --key <...>`. Left unset, signature verification is skipped
# entirely; digest pinning (this script never accepts a floating tag for an
# image target) and the SBOM/provenance attestation verification
# docs/deployment.md's "Published images" section already documents
# (ADR-0020, `gh attestation verify`) still apply independently of this
# variable. Signing/verification TOOLING itself is out of this issue's own
# scope — this variable only names the command this script calls.
# DEPLOY_COSIGN_VERIFY_COMMAND=

# Overridable external-command names/paths — every one of docker/git/bun/
# curl/ssh/cosign/flock tools/deploy/*.sh calls is read from a variable
# rather than hardcoded, so a host with an unusual PATH (or the hermetic test
# suite) can point each one at an exact binary. Ordinary use leaves all of
# these unset — every script then reads the command name as it normally
# would from PATH.
# DOCKER=docker
# GIT=git
# BUN=bun
# CURL=curl
# SSH=ssh
# COSIGN=cosign
# FLOCK=flock

# Overrides the liveness URLs healthcheck-production.sh and
# deploy-production.sh's own smoke step call. Left unset, they default to
# this host's own cms/storefront containers (http://localhost:4321/api/v1/health,
# http://localhost:8080/healthz) — set these only when the deploy host
# reaches those services through a different address (e.g. a reverse proxy
# on a different port).
# DEPLOY_SMOKE_CMS_URL=http://localhost:4321/api/v1/health
# DEPLOY_SMOKE_STOREFRONT_URL=http://localhost:8080/healthz

# `tools/deploy/deploy-remote.sh <ssh-host> <target>` only — the fixed path
# to deploy-production.sh on the REMOTE host, relative to the remote
# checkout's own root. Left unset, it defaults to this repository's own path
# (tools/deploy/deploy-production.sh) — set this only when the remote
# checkout root differs from this one, or a forced-command SSH key names a
# wrapper script at a different path.
# DEPLOY_REMOTE_SCRIPT_PATH=tools/deploy/deploy-production.sh

# ---------------------------------------------------------------------------
# tools/release/images.ts and tools/release/publish.ts (`bun run
# release:images` / `bun run release:publish` — issue #225 part 2), the
# trusted-release-host replacement for `.github/workflows/images.yml` and
# `.github/workflows/release.yml`. See docs/rilis.md for the full runbook
# and docs/adr/0023-release-images-are-built-signed-and-published-from-a-trusted-release-host.md
# for why a cosign key on the release host is now this repo's own image
# trust root, superseding ADR-0020's GitHub-native attestation.
# ---------------------------------------------------------------------------

# GHCR credentials `release:images -- --publish` logs in with — never
# echoed; passed to `docker login --password-stdin`. GHCR_TOKEN must carry
# `write:packages` ONLY (least privilege — no `repo`, no `admin:org`).
# Leaving either unset makes `--publish` refuse to run rather than attempt a
# push that would fail anyway on an unauthenticated registry.
GHCR_USER=
GHCR_TOKEN=

# The cosign signing key `release:images -- --publish` signs each pushed
# image's digest with — a file path (read with 0600 permissions expected) or
# a KMS URI (`awskms://…`, `gcpkms://…`, `azurekms://…`, `hashivault://…`).
# Left unset, `--publish` refuses outright rather than generating a
# throw-away key on the fly (docs/adr/0023-...md's own key-custody
# reasoning). Never a repo secret — this is a release-HOST-local credential.
COSIGN_KEY=
# The password protecting COSIGN_KEY when it is an encrypted file-based key
# (cosign's own convention). Left unset, cosign is asked for it interactively
# — fine for a human running this by hand, wrong for an unattended run.
COSIGN_PASSWORD=
# The public key `release:images -- --publish` immediately verifies its own
# signature against, right after signing — a file path. Distributed to
# anyone who needs to verify a published image themselves (docs/rilis.md's
# "Verifying a published image").
COSIGN_PUBLIC_KEY=
# Whether a signature is recorded in the public Sigstore Rekor transparency
# log ("true"/"false"). Left unset, a real registry uploads (the images are
# public; the log makes every use of the key visible) and a localhost
# rehearsal registry does not. Verification skips the Rekor check only when
# the upload was skipped (tools/release/lib/cosign.mjs).
COSIGN_TLOG_UPLOAD=

# Overrides where `release:images` writes its evidence JSON, SBOMs, and
# SHA256SUMS. Left unset, it defaults to a directory under the OS temp
# directory — deliberately OUTSIDE this repository's own working tree, so
# evidence from a real publish is never accidentally committed.
# RELEASE_EVIDENCE_DIR=/var/lib/awcms-one-release/evidence

# Test/rehearsal-only escape hatch: when set to exactly "1", `--publish`
# skips its check that the tag being published is an ancestor of
# `origin/main` — the ONE precondition that cannot hold for a throwaway tag
# created purely to rehearse this tool against a local, disposable registry
# (docs/rilis.md's "Rehearsing without touching GHCR"). Every use is logged
# loudly by the script itself. NEVER set this for an actual publish — a real
# release always tags a commit already on origin/main, so the real check
# always passes for it and this variable is never needed.
# RELEASE_DANGEROUSLY_SKIP_ANCESTOR_CHECK=1

# The token `release:publish` uses to call the GitHub API (`gh release
# create`/`edit`/`upload`). Left unset, it falls back to `gh auth token` —
# the CLI's own already-authenticated credential — so an operator who has
# already run `gh auth login` needs nothing here.
RELEASE_GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Local CI (tools/ci/, `bun run ci` / `ci:pr` / `ci:watch` — issue #225,
# ADR-0021)
# ---------------------------------------------------------------------------
#
# The credential local CI authenticates to GitHub as, for posting
# `local-ci/*` commit statuses (`POST .../statuses/{sha}`) and, with
# `--upload-sarif`, uploading SARIF to code scanning. A dedicated
# fine-grained token or GitHub App installation token is recommended
# (narrowest scope: `statuses:write`, plus `security-events:write` only if
# you use --upload-sarif) — see ADR-0021's "The status credential". Leaving
# this unset falls back to `gh auth token` (your own logged-in `gh`
# session), so a first run needs no extra setup beyond `gh auth login`.
# Never printed by any local-ci command.
# LOCAL_CI_GITHUB_TOKEN=

# Override the (owner, repo) local CI reports statuses against. Leaving
# these unset derives both from this checkout's own `origin` remote — the
# ordinary case, including a derived template repository (docs/template.md)
# whose remote points somewhere other than ahliweb/awcms-one. Set both (never
# just one) only when `origin` is not a github.com remote at all.
# LOCAL_CI_GITHUB_OWNER=
# LOCAL_CI_GITHUB_REPO=

# XDG Base Directory override for where local CI keeps its own state — locks,
# recorded per-(repo, PR, SHA, CI-definition) results, and evidence (leg
# logs, SARIF, Playwright reports). Leaving this unset uses
# ~/.local/state/awcms-one-ci/, per the XDG spec's own default. Nothing here
# is ever written inside this repository's own working tree.
# XDG_STATE_HOME=
