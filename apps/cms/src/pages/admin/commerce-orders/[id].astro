---
/**
 * `/admin/commerce-orders/{id}` (Issue #171) — the order detail view the
 * mockup asks for: lines, totals, and a REAL timeline built from
 * `OrderDetail.timeline` (`order-directory.ts`'s own status-history read,
 * already used by the public tracking page — nothing new is computed here),
 * rendered with the shared `.admin-timeline` primitive. The gateway
 * session/payment-events panel is the same one `commerce-orders.astro`
 * already renders inline on its list row — kept, not duplicated, by loading
 * it through the same `GET /api/v1/commerce/orders/{id}` route client-side.
 *
 * A DYNAMIC page (`[id].astro`) under `commerce-orders/`, not a query-string
 * page — `tests/admin-navigation-registry.test.ts`'s "every admin page is
 * claimed by exactly one descriptor or is a core entry" requires a static
 * page to be a `navigation` target, and a per-order detail view is not a
 * sidebar link; the dynamic-page shape it explicitly carves out instead
 * requires only that its PARENT page exist — `/admin/commerce-orders`,
 * which links to this page from its own order-code cell.
 *
 * ## Payments panel (Issue #285, ADR-0025)
 *
 * A "Payments" panel shows the order's DERIVED settlement (total, paid,
 * reversed, outstanding, overpaid) and its append-only payment ledger. It is
 * gated on `commerce.payments.read`; the "Record a payment" form needs
 * `commerce.payments.create` and the "Record a reversal" form
 * `commerce.payments.revoke` (the endpoints behind both decide for
 * themselves). The page's entry permission is still `commerce.orders.read` —
 * a staff member holding only a payments permission sees nothing here.
 * Nothing on the panel edits a ledger row: a correction is a NEW reversal.
 *
 * Same permission as the list (`commerce.orders.read`); the list's own
 * "Save status" control is NOT duplicated here — this is a read view, so a
 * user with `orders.update` still makes the status change from the list.
 *
 * Issue #246 switches every raw enum render on this page (status pill,
 * channel pill, timeline entry status) to `commerce-admin-labels.ts` (Issue
 * #243), and passes the client-rendered gateway panel's own translated maps
 * through `data-gateway-labels` on the panel element itself — the same JSON
 * shape `commerce-orders.astro`'s own gateway panel uses, so there is one
 * convention to read, not two.
 */
import AdminLayout from "../../../layouts/AdminLayout.astro";
import "../../../styles/admin-screens.css";
import { loadAdminScreen } from "../../../lib/auth/admin-screen";
import { logAdminPageError } from "../../../lib/logging/error-log";
import { getTranslatorFor } from "../../../lib/i18n";
import { fetchCommerceFeatures } from "../../../modules/commerce/application/commerce-feature-gate";
import {
  fetchOrderDetailForAdmin,
  toAdminOrderRecord
} from "../../../modules/commerce/application/order-directory";
import {
  fetchOrderPaymentSummary,
  type OrderPaymentSummary
} from "../../../modules/commerce/application/payment-allocation-directory";
import { toCents } from "../../../modules/commerce/domain/price-calculation";
import { mediaLibraryPortAdapter } from "../../../modules/media-library/application/media-library-port-adapter";
import {
  createCommerceLabels,
  commerceLabel,
  orderStatusTone
} from "../../../lib/ui/commerce-admin-labels";

const ssr = Astro.locals.ssrContext!;
const { t } = getTranslatorFor(Astro.locals.locale);
const labels = createCommerceLabels(t);

const orderId = Astro.params.id ?? "";

/** Same shape `commerce-orders.astro` sends its own gateway panel — one convention, not two. */
const gatewayLabels = {
  provider: labels.paymentGatewaySessionProvider,
  status: labels.paymentGatewayStatus,
  outcome: labels.paymentEventOutcome
};

const ORDER_READ = {
  moduleKey: "commerce",
  activityCode: "orders",
  action: "read"
} as const;
/** Issue #285 — the payments panel's three permissions, each claimed here (and enforced by the routes the panel calls). */
const PAYMENTS_READ = {
  moduleKey: "commerce",
  activityCode: "payments",
  action: "read"
} as const;
const PAYMENTS_CREATE = {
  moduleKey: "commerce",
  activityCode: "payments",
  action: "create"
} as const;
const PAYMENTS_REVOKE = {
  moduleKey: "commerce",
  activityCode: "payments",
  action: "revoke"
} as const;

const screen = await loadAdminScreen({
  ssr,
  workClass: "interactive",
  authorize: [ORDER_READ, PAYMENTS_READ, PAYMENTS_CREATE, PAYMENTS_REVOKE],
  load: async ({ tx, entry }) => {
    // The entry is any-of; THIS page's subject is the order, so it still
    // needs `orders.read` itself — holding only a payments permission must
    // not unlock the order detail.
    const canReadOrder = entry[0] === true;
    const canReadPayments = entry[1] === true;
    const canRecordPayment = entry[2] === true;
    const canRecordReversal = entry[3] === true;
    // Issue #288 - gift card / store credit tenders only while the tenant's
    // `storedValue` feature is on (the payments route refuses them otherwise).
    const storedValueEnabled = (await fetchCommerceFeatures(tx, ssr.tenantId))
      .storedValue;
    if (!orderId || !canReadOrder) {
      return {
        order: null,
        canReadOrder,
        canReadPayments,
        canRecordPayment,
        canRecordReversal,
        storedValueEnabled,
        payments: null as OrderPaymentSummary | null
      };
    }
    const detail = await fetchOrderDetailForAdmin(
      tx,
      ssr.tenantId,
      mediaLibraryPortAdapter,
      orderId
    );
    if (!detail) {
      return {
        order: null,
        canReadOrder,
        canReadPayments,
        canRecordPayment,
        canRecordReversal,
        storedValueEnabled,
        payments: null as OrderPaymentSummary | null
      };
    }
    const record = await toAdminOrderRecord(tx, ssr.tenantId, detail);
    const payments = canReadPayments
      ? await fetchOrderPaymentSummary(tx, ssr.tenantId, orderId)
      : null;
    return {
      order: record,
      canReadOrder,
      canReadPayments,
      canRecordPayment,
      canRecordReversal,
      storedValueEnabled,
      payments
    };
  },
  onError: (error) => {
    logAdminPageError(
      "admin/commerce-order-detail.astro: failed to load order",
      error,
      { correlationId: Astro.locals.correlationId }
    );
  }
});

const canRead =
  screen.state !== "denied" &&
  (screen.state !== "allowed" || screen.data.canReadOrder);
const loadError = screen.state === "error";
const order = screen.state === "allowed" ? screen.data.order : null;
const notFound = screen.state === "allowed" && canRead && !order;
const payments = screen.state === "allowed" ? screen.data.payments : null;
const canRecordPayment =
  screen.state === "allowed" && screen.data.canRecordPayment;
const canRecordReversal =
  screen.state === "allowed" && screen.data.canRecordReversal;
const storedValueEnabled =
  screen.state === "allowed" && screen.data.storedValueEnabled;
/** Succeeded payment legs that still have something left to reverse — the reversal form's choices. */
const reversiblePayments = (payments?.allocations ?? []).filter((leg) => {
  if (leg.kind !== "payment" || leg.status !== "succeeded") return false;
  const reversed = (payments?.allocations ?? [])
    .filter((other) => other.reversesAllocationId === leg.id)
    .reduce((sum, other) => sum + toCents(other.amount), 0n);
  return toCents(leg.amount) > reversed;
});
---

<AdminLayout
  title={t("Order detail")}
  description={t("Lines, totals, and the order's own status timeline.")}
>
  {!canRead && (
    <p class="state-notice fade-in-up" id="order-detail-denied">
      {t("You do not have permission to view this order.")}
    </p>
  )}
  {canRead && loadError && (
    <p class="state-notice fade-in-up" id="order-detail-error">
      {t("The order could not be loaded right now. Please try again later.")}
    </p>
  )}
  {canRead && !loadError && notFound && (
    <p class="state-notice fade-in-up" id="order-detail-not-found">
      {t("This order could not be found.")}
    </p>
  )}

  {canRead && !loadError && order && (
    <div class="fade-in-up">
      <p>
        <span class="cell-code">{order.orderCode}</span>{" "}
        <span
          class="admin-status-pill"
          data-tone={orderStatusTone[order.status] ?? "neutral"}
          data-status={order.status}
        >
          <span class="admin-status-pill-dot" aria-hidden="true" />
          {commerceLabel(labels.orderStatus, order.status)}
        </span>{" "}
        <span
          class="admin-status-pill"
          data-tone="neutral"
          data-channel={order.channel}
        >
          {commerceLabel(labels.orderChannel, order.channel)}
        </span>
      </p>

      <div class="admin-order-detail-grid">
        <div class="admin-order-detail-panel">
          <h2 class="admin-dashboard-panel-title">{t("Lines")}</h2>
          <div class="data-table-scroll">
            <table class="data-table data-table--stack">
              <caption class="sr-only">{t("Order lines")}</caption>
              <thead>
                <tr>
                  <th scope="col">{t("Product")}</th>
                  <th scope="col">{t("Unit price")}</th>
                  <th scope="col">{t("Qty")}</th>
                  <th scope="col">{t("Line total")}</th>
                </tr>
              </thead>
              <tbody>
                {order.lines.map((line) => (
                  <tr>
                    <td data-label={t("Product")}>
                      {line.name}
                      {line.variantName && <> &mdash; {line.variantName}</>}
                    </td>
                    <td data-label={t("Unit price")}>{line.unitPrice}</td>
                    <td data-label={t("Qty")}>{line.quantity}</td>
                    <td data-label={t("Line total")}>{line.lineTotal}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h2 class="admin-dashboard-panel-title">{t("Totals")}</h2>
          <ul class="admin-order-totals">
            <li>
              <span>{t("Subtotal")}</span>
              <span>{order.subtotal}</span>
            </li>
            <li>
              <span>{t("Discount")}</span>
              <span>{order.discount}</span>
            </li>
            <li>
              <span>{t("Shipping")}</span>
              <span>{order.shippingCost}</span>
            </li>
            <li>
              <span>{t("Insurance")}</span>
              <span>{order.insuranceFee}</span>
            </li>
            <li>
              <span>{t("Tax")}</span>
              <span>{order.tax}</span>
            </li>
            <li class="admin-order-total-grand">
              <span>{t("Total")}</span>
              <span>{order.total}</span>
            </li>
          </ul>

          {payments && (
            <section
              id="order-payments"
              aria-labelledby="order-payments-heading"
              data-order-id={orderId}
              data-msg-overpayment={t(
                "That amount is more than the order still owes."
              )}
              data-msg-not-payable={t(
                "A cancelled or expired order cannot receive a payment."
              )}
              data-msg-exceeds={t(
                "That reversal is more than what is left of the payment."
              )}
              data-msg-not-reversible={t("That payment cannot be reversed.")}
              data-msg-code-required={t("Enter the gift card or credit code.")}
              data-msg-sv-not-found={t(
                "That gift card or credit code was not recognised."
              )}
              data-msg-sv-unavailable={t(
                "That gift card or credit is disabled or has expired."
              )}
              data-msg-sv-insufficient={t(
                "That gift card or credit does not have enough balance for the amount entered."
              )}
              data-msg-sv-throttled={t(
                "Too many code lookups. Wait a moment and try again."
              )}

              data-msg-generic={t(
                "Could not record this. Check the amount and try again."
              )}
              data-busy-label={t("Saving…")}
            >
              <h2
                class="admin-dashboard-panel-title"
                id="order-payments-heading"
              >
                {t("Payments")}
              </h2>
              <ul class="admin-order-totals" id="order-settlement">
                <li>
                  <span>{t("Payment status")}</span>
                  <span>
                    {commerceLabel(
                      labels.paymentStatus,
                      payments.settlement.paymentStatus
                    )}
                  </span>
                </li>
                <li>
                  <span>{t("Total")}</span>
                  <span>{payments.settlement.total}</span>
                </li>
                <li>
                  <span>{t("Paid")}</span>
                  <span>{payments.settlement.paid}</span>
                </li>
                <li>
                  <span>{t("Reversed")}</span>
                  <span>{payments.settlement.reversed}</span>
                </li>
                <li class="admin-order-total-grand">
                  <span>{t("Balance due")}</span>
                  <span>{payments.settlement.outstanding}</span>
                </li>
                {payments.settlement.overpaid !== "0.00" && (
                  <li>
                    <span>{t("Overpaid (to refund)")}</span>
                    <span>{payments.settlement.overpaid}</span>
                  </li>
                )}
              </ul>

              {payments.allocations.length === 0 ? (
                <p class="admin-stat-card-caption">
                  {t("No payments recorded for this order yet.")}
                </p>
              ) : (
                <div class="data-table-scroll">
                  <table class="data-table data-table--stack">
                    <caption class="sr-only">{t("Payment ledger")}</caption>
                    <thead>
                      <tr>
                        <th scope="col">{t("Type")}</th>
                        <th scope="col">{t("Payment method")}</th>
                        <th scope="col">{t("Amount")}</th>
                        <th scope="col">{t("Status")}</th>
                        <th scope="col">{t("Recorded")}</th>
                        <th scope="col">{t("Note")}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {payments.allocations.map((leg) => (
                        <tr data-allocation-id={leg.id}>
                          <th scope="row" data-label={t("Type")}>
                            {commerceLabel(
                              labels.paymentAllocationKind,
                              leg.kind
                            )}
                          </th>
                          <td data-label={t("Payment method")}>
                            {commerceLabel(
                              labels.paymentTenderType,
                              leg.tenderType
                            )}
                            {leg.storedValue && (
                              <span class="cell-muted">
                                {" "}
                                <code>{leg.storedValue.maskedCode}</code>
                              </span>
                            )}
                          </td>
                          <td data-label={t("Amount")}>
                            {leg.kind === "reversal" ? "−" : ""}
                            {leg.amount}
                            {leg.tenderedAmount !== null && (
                              <span class="cell-muted">
                                {" "}
                                ({t("Tendered")} {leg.tenderedAmount},{" "}
                                {t("Change")} {leg.changeAmount})
                              </span>
                            )}
                          </td>
                          <td data-label={t("Status")}>
                            {commerceLabel(
                              labels.paymentAllocationStatus,
                              leg.status
                            )}
                          </td>
                          <td data-label={t("Recorded")}>{leg.createdAt}</td>
                          <td data-label={t("Note")}>{leg.note ?? "—"}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {canRecordPayment && (
                <form class="admin-form" id="order-payment-form">
                  <h3>{t("Record a payment")}</h3>
                  <p
                    id="order-payment-error"
                    class="admin-create-error"
                    role="alert"
                    hidden
                  />
                  <label for="order-payment-tender">
                    {t("Payment method")}
                    <select
                      id="order-payment-tender"
                      name="tenderType"
                      required
                    >
                      <option value="cash">{t("Cash")}</option>
                      <option value="manual_qris">{t("QRIS")}</option>
                      <option value="manual_bank_transfer">
                        {t("Bank transfer")}
                      </option>
                      {storedValueEnabled && (
                        <option value="gift_card">{t("Gift card")}</option>
                      )}
                      {storedValueEnabled && (
                        <option value="store_credit">
                          {t("Store credit")}
                        </option>
                      )}
                    </select>
                  </label>
                  <label
                    for="order-payment-code"
                    id="order-payment-code-label"
                    hidden
                  >
                    {t("Gift card or credit code")}
                    <input
                      type="text"
                      id="order-payment-code"
                      name="storedValueCode"
                      maxlength="64"
                      autocomplete="off"
                      autocapitalize="characters"
                      spellcheck="false"
                    />
                  </label>
                  <label for="order-payment-amount">
                    {t("Amount received")}
                    <input
                      type="text"
                      id="order-payment-amount"
                      name="amount"
                      inputmode="decimal"
                      pattern="\d{1,12}(\.\d{1,2})?"
                      placeholder="0.00"
                      autocomplete="off"
                      required
                    />
                  </label>
                  <p class="form-hint">
                    {t(
                      "For cash, enter the amount handed over; any amount above the balance is returned as change."
                    )}
                  </p>
                  <label for="order-payment-reference">
                    {t("Reference (optional)")}
                    <input
                      type="text"
                      id="order-payment-reference"
                      name="reference"
                      maxlength="100"
                      autocomplete="off"
                    />
                  </label>
                  <label for="order-payment-note">
                    {t("Note")}
                    <textarea
                      id="order-payment-note"
                      name="note"
                      rows="2"
                      maxlength="500"
                    />
                  </label>
                  <div class="admin-form-actions">
                    <button
                      type="submit"
                      class="module-toggle"
                      id="order-payment-submit"
                    >
                      {t("Record payment")}
                    </button>
                  </div>
                </form>
              )}

              {canRecordReversal && reversiblePayments.length > 0 && (
                <form class="admin-form" id="order-reversal-form">
                  <h3>{t("Record a reversal")}</h3>
                  <p
                    id="order-reversal-error"
                    class="admin-create-error"
                    role="alert"
                    hidden
                  />
                  <label for="order-reversal-payment">
                    {t("Payment to reverse")}
                    <select
                      id="order-reversal-payment"
                      name="paymentId"
                      required
                    >
                      {reversiblePayments.map((leg) => (
                        <option value={leg.id}>
                          {commerceLabel(
                            labels.paymentTenderType,
                            leg.tenderType
                          )}{" "}
                          — {leg.amount}
                        </option>
                      ))}
                    </select>
                  </label>
                  <label for="order-reversal-amount">
                    {t("Amount to reverse (blank = all that is left)")}
                    <input
                      type="text"
                      id="order-reversal-amount"
                      name="amount"
                      inputmode="decimal"
                      pattern="\d{1,12}(\.\d{1,2})?"
                      placeholder="0.00"
                      autocomplete="off"
                    />
                  </label>
                  <label for="order-reversal-note">
                    {t("Reason")}
                    <textarea
                      id="order-reversal-note"
                      name="note"
                      rows="2"
                      maxlength="500"
                      required
                    />
                  </label>
                  <p class="form-hint">
                    {t(
                      "A reversal records that money was given back. It does not move the money and does not cancel the order."
                    )}
                  </p>
                  <div class="admin-form-actions">
                    <button
                      type="submit"
                      class="btn-inline btn-inline--danger"
                      id="order-reversal-submit"
                    >
                      {t("Record reversal")}
                    </button>
                  </div>
                </form>
              )}
            </section>
          )}

          <h2 class="admin-dashboard-panel-title">{t("Payment gateway")}</h2>
          <div
            class="order-gateway-panel"
            data-order-gateway-panel={orderId}
            data-gateway-labels={JSON.stringify(gatewayLabels)}
          >
            <p class="order-gateway-panel-loading">{t("Loading…")}</p>
          </div>
          <p
            id="order-gateway-fetch-error"
            class="admin-create-error"
            role="alert"
            hidden
          />
        </div>

        <div class="admin-order-detail-panel">
          <h2 class="admin-dashboard-panel-title">{t("Timeline")}</h2>
          {order.timeline.length === 0 ? (
            <p class="admin-stat-card-caption">
              {t("No status history recorded for this order yet.")}
            </p>
          ) : (
            <ol class="admin-timeline">
              {order.timeline.map((entry) => (
                <li class="admin-timeline-item">
                  <div class="admin-timeline-label" data-status={entry.status}>
                    {commerceLabel(labels.orderStatus, entry.status)}
                  </div>
                  <div class="admin-timeline-meta">
                    {entry.at}
                    {entry.note && <> &mdash; {entry.note}</>}
                  </div>
                </li>
              ))}
            </ol>
          )}
        </div>
      </div>
    </div>
  )}
</AdminLayout>

<template id="order-gateway-panel-template">
  <div class="order-gateway-session">
    <h3>{t("Gateway payment session")}</h3>
    <p data-field="session-empty">
      {t("This order has no gateway payment session.")}
    </p>
    <dl data-field="session-detail" hidden>
      <dt>{t("Provider")}</dt>
      <dd data-field="session-provider"></dd>
      <dt>{t("Status")}</dt>
      <dd data-field="session-status"></dd>
      <dt>{t("Expires at")}</dt>
      <dd data-field="session-expires"></dd>
    </dl>
  </div>
  <div class="order-gateway-events">
    <h3>{t("Payment events")}</h3>
    <ul data-field="events-list"></ul>
    <p data-field="events-empty">{t("No payment events recorded yet.")}</p>
  </div>
</template>

<script>
  // Issue #285 — the payments panel's two mutations. Each posts to the
  // guarded endpoint with a fresh `Idempotency-Key` per submission (a retry of
  // the SAME submission would replay it), then reloads so the server-rendered
  // settlement and ledger are the single source of what is on screen.
  import {
    lockElement,
    messageBox,
    sendJsonForData
  } from "../../../lib/ui/admin-form-client";

  const panel = document.getElementById("order-payments");
  const orderIdForPayments = panel?.dataset.orderId ?? "";
  const m = (key: string): string => panel?.dataset[key] ?? "";
  const MONEY = /^\d{1,12}(\.\d{1,2})?$/;

  function errorMessage(code: string | null): string {
    const map: Record<string, string> = {
      OVERPAYMENT: m("msgOverpayment"),
      ORDER_NOT_PAYABLE: m("msgNotPayable"),
      REVERSAL_EXCEEDS_PAYMENT: m("msgExceeds"),
      PAYMENT_NOT_REVERSIBLE: m("msgNotReversible"),
      STORED_VALUE_NOT_FOUND: m("msgSvNotFound"),
      STORED_VALUE_UNAVAILABLE: m("msgSvUnavailable"),
      STORED_VALUE_INSUFFICIENT: m("msgSvInsufficient"),
      STORED_VALUE_LOOKUP_THROTTLED: m("msgSvThrottled")
    };
    return map[code ?? ""] ?? m("msgGeneric");
  }

  const paymentForm = document.getElementById(
    "order-payment-form"
  ) as HTMLFormElement | null;
  const paymentError = messageBox("order-payment-error");
  /** Issue #288 - a gift card / store credit tender names its account by code. */
  const isStoredValue = (type: string): boolean =>
    type === "gift_card" || type === "store_credit";
  const tenderSelect = document.getElementById(
    "order-payment-tender"
  ) as HTMLSelectElement | null;
  const codeLabel = document.getElementById("order-payment-code-label");
  tenderSelect?.addEventListener("change", () => {
    if (codeLabel) codeLabel.hidden = !isStoredValue(tenderSelect.value);
  });
  paymentForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    paymentError.clear();
    const data = new FormData(paymentForm);
    const amount = String(data.get("amount") ?? "").trim();
    if (!MONEY.test(amount)) {
      paymentError.show(m("msgGeneric"));
      return;
    }
    const tenderType = String(data.get("tenderType") ?? "cash");
    const storedValueCode = String(data.get("storedValueCode") ?? "").trim();
    if (isStoredValue(tenderType) && storedValueCode === "") {
      paymentError.show(m("msgCodeRequired"));
      return;
    }
    const submit = document.getElementById(
      "order-payment-submit"
    ) as HTMLButtonElement | null;
    if (!submit) return;
    const unlock = lockElement(submit, m("busyLabel"));
    try {
      const { ok, errorCode } = await sendJsonForData(
        "POST",
        `/api/v1/commerce/orders/${orderIdForPayments}/payments`,
        {
          tenderType,
          amount,
          reference: isStoredValue(tenderType)
            ? null
            : String(data.get("reference") ?? "").trim() || null,
          note: String(data.get("note") ?? "").trim() || null,
          ...(isStoredValue(tenderType) ? { storedValueCode } : {})
        },
        { "Idempotency-Key": crypto.randomUUID() }
      );
      if (!ok) {
        paymentError.show(errorMessage(errorCode));
        return;
      }
      window.location.reload();
    } finally {
      unlock();
    }
  });

  const reversalForm = document.getElementById(
    "order-reversal-form"
  ) as HTMLFormElement | null;
  const reversalError = messageBox("order-reversal-error");
  reversalForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    reversalError.clear();
    const data = new FormData(reversalForm);
    const amount = String(data.get("amount") ?? "").trim();
    const note = String(data.get("note") ?? "").trim();
    if ((amount !== "" && !MONEY.test(amount)) || note === "") {
      reversalError.show(m("msgGeneric"));
      return;
    }
    const submit = document.getElementById(
      "order-reversal-submit"
    ) as HTMLButtonElement | null;
    if (!submit) return;
    const unlock = lockElement(submit, m("busyLabel"));
    try {
      const { ok, errorCode } = await sendJsonForData(
        "POST",
        `/api/v1/commerce/orders/${orderIdForPayments}/payments/${encodeURIComponent(String(data.get("paymentId") ?? ""))}/reversals`,
        { amount: amount === "" ? null : amount, note },
        { "Idempotency-Key": crypto.randomUUID() }
      );
      if (!ok) {
        reversalError.show(errorMessage(errorCode));
        return;
      }
      window.location.reload();
    } finally {
      unlock();
    }
  });
</script>

<script>
  // A REGULAR `<script>` with an import — never `define:vars` (that
  // attribute forces Astro to treat the tag as `is:inline`, which this CSP's
  // `default-src 'self'`/no-`'unsafe-inline'` then silently drops; see the
  // `awcms-ui-screen` skill's checklist item 6). The order id travels
  // through the existing `data-order-gateway-panel` attribute instead of a
  // templated variable.
  //
  // Re-fetches the SAME `GET /api/v1/commerce/orders/{id}` route
  // `commerce-orders.astro`'s inline panel calls, so there is one gateway
  // rendering implementation to keep correct, not two — this page just
  // shows it expanded by default instead of behind a toggle.
  import { messageBox } from "../../../lib/ui/admin-form-client";

  const fetchError = messageBox("order-gateway-fetch-error");

  /** Server-rendered, translated — never re-translated in the browser (Issue #246). Same JSON shape `commerce-orders.astro`'s own gateway panel carries. */
  interface GatewayLabels {
    provider: Record<string, string>;
    status: Record<string, string>;
    outcome: Record<string, string>;
  }

  function parseGatewayLabels(raw: string | undefined): GatewayLabels {
    const fallback: GatewayLabels = { provider: {}, status: {}, outcome: {} };
    if (!raw) return fallback;
    try {
      return { ...fallback, ...JSON.parse(raw) };
    } catch {
      return fallback;
    }
  }

  async function renderGatewayPanel() {
    const panel = document.querySelector<HTMLElement>(
      "[data-order-gateway-panel]"
    );
    const template = document.getElementById(
      "order-gateway-panel-template"
    ) as HTMLTemplateElement | null;
    const orderId = panel?.dataset.orderGatewayPanel;
    if (!panel || !template || !orderId) return;

    const gatewayLabels = parseGatewayLabels(panel.dataset.gatewayLabels);

    let payload: { success?: boolean; data?: any } | null = null;
    try {
      const response = await fetch(`/api/v1/commerce/orders/${orderId}`, {
        credentials: "same-origin"
      });
      payload = await response.json().catch(() => null);
      if (!response.ok || !payload?.success) payload = null;
    } catch {
      payload = null;
    }

    panel.innerHTML = "";
    panel.appendChild(template.content.cloneNode(true));

    if (!payload) {
      fetchError.show("Could not load payment-gateway status.");
      return;
    }

    const { session, events } = payload.data.gateway;
    const sessionEmpty = panel.querySelector<HTMLElement>(
      '[data-field="session-empty"]'
    );
    const sessionDetail = panel.querySelector<HTMLElement>(
      '[data-field="session-detail"]'
    );
    if (session) {
      if (sessionEmpty) sessionEmpty.hidden = true;
      if (sessionDetail) {
        sessionDetail.hidden = false;
        const provider = sessionDetail.querySelector(
          '[data-field="session-provider"]'
        );
        const status = sessionDetail.querySelector(
          '[data-field="session-status"]'
        );
        const expires = sessionDetail.querySelector(
          '[data-field="session-expires"]'
        );
        if (provider) {
          provider.setAttribute("data-raw-value", session.provider);
          provider.textContent =
            gatewayLabels.provider[session.provider] ?? session.provider;
        }
        if (status) {
          status.setAttribute("data-raw-value", session.status);
          status.textContent =
            gatewayLabels.status[session.status] ?? session.status;
        }
        if (expires) expires.textContent = session.expiresAt;
      }
    }

    const eventsList = panel.querySelector<HTMLElement>(
      '[data-field="events-list"]'
    );
    const eventsEmpty = panel.querySelector<HTMLElement>(
      '[data-field="events-empty"]'
    );
    if (!events || events.length === 0) {
      if (eventsEmpty) eventsEmpty.hidden = false;
    } else {
      if (eventsEmpty) eventsEmpty.hidden = true;
      for (const event of events as {
        receivedAt: string;
        provider: string;
        outcome: string;
        eventKey: string;
      }[]) {
        const item = document.createElement("li");
        item.setAttribute("data-raw-provider", event.provider);
        item.setAttribute("data-raw-outcome", event.outcome);
        const providerLabel =
          gatewayLabels.provider[event.provider] ?? event.provider;
        const outcomeLabel =
          gatewayLabels.outcome[event.outcome] ?? event.outcome;
        item.textContent = `${event.receivedAt} — ${providerLabel} — ${outcomeLabel} (${event.eventKey})`;
        eventsList?.appendChild(item);
      }
    }
  }

  void renderGatewayPanel();
</script>
