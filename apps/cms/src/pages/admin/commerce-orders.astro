---
/**
 * Commerce order list + status transition screen (Issue #29). Orders
 * themselves are created only through the anonymous storefront path
 * (`src/pages/api/v1/commerce/storefront/orders/index.ts`) — there is no
 * create form here, matching `commerce-permissions.ts`'s "no `orders.create`
 * permission" decision.
 *
 * Issue #246 adds a confirm-with-note step before the status PATCH and
 * switches every raw enum render on this screen to `commerce-admin-labels.ts`
 * (Issue #243). The confirm dialog's message is composed almost entirely
 * server-side — order code and the FROM status are already known at render
 * time — except for the TO status, which is only known once the operator
 * changes the `<select>`, client-side. `data-confirm-message` is therefore
 * rendered with a literal `{to}` placeholder left unsubstituted on purpose:
 * `src/lib/i18n/catalog.ts`'s own `interpolate()` leaves an unmatched
 * `{name}` VERBATIM rather than blanking it (see that function's docblock),
 * so the client script's own `.replace("{to}", toLabel)` is completing a
 * translation this file already started, never inventing English text of
 * its own. The translated status-label map and the domain's own terminal-
 * status set travel to the browser as `data-order-status-meta` on
 * `#commerce-orders-table` (JSON) — the "pass a `data-status-labels`-shaped
 * attribute, never translate in the browser" convention `raw-enum-table.md`
 * asks for.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import CommerceConfirmDialog from "../../components/CommerceConfirmDialog.astro";
import "../../styles/admin-screens.css";
import { loadAdminScreen } from "../../lib/auth/admin-screen";
import { logAdminPageError } from "../../lib/logging/error-log";
import { getTranslatorFor } from "../../lib/i18n";
import {
  countOrdersByStatus,
  listOrdersForAdmin
} from "../../modules/commerce/application/order-directory";
import {
  ORDER_STATUSES,
  LEGAL_ORDER_STATUS_TRANSITIONS,
  type OrderStatus
} from "../../modules/commerce/domain/order-status";
import {
  createCommerceLabels,
  commerceLabel,
  orderStatusTone
} from "../../lib/ui/commerce-admin-labels";

const ssr = Astro.locals.ssrContext!;
const { t, tn } = getTranslatorFor(Astro.locals.locale);
const labels = createCommerceLabels(t);

const url = new URL(Astro.request.url);
const rawStatus = url.searchParams.get("status") ?? "";
const activeStatus: OrderStatus | null = (
  ORDER_STATUSES as readonly string[]
).includes(rawStatus)
  ? (rawStatus as OrderStatus)
  : null;

/**
 * Derived from the domain's own transition graph rather than hand-listed —
 * `order-status.ts`'s header already names `completed`/`cancelled`/`expired`
 * as terminal (no outgoing edge), and `docs/cms.md`'s own status-graph
 * section agrees; deriving it here means a future domain change to that
 * graph is reflected automatically instead of silently drifting from a
 * second, hardcoded copy.
 */
const TERMINAL_ORDER_STATUSES: readonly OrderStatus[] = ORDER_STATUSES.filter(
  (status) => LEGAL_ORDER_STATUS_TRANSITIONS[status].length === 0
);

/** Everything the client script needs to finish translating the confirm dialog and decide `danger` — never re-derived in the browser. */
const orderStatusMeta = {
  labels: labels.orderStatus,
  terminal: TERMINAL_ORDER_STATUSES
};

/** The gateway panel's own translated maps (session provider/status, event provider/outcome) — `commerce-orders/[id].astro` carries the identical shape on its own gateway panel element. */
const gatewayLabels = {
  provider: labels.paymentGatewaySessionProvider,
  status: labels.paymentGatewayStatus,
  outcome: labels.paymentEventOutcome
};

const screen = await loadAdminScreen({
  ssr,
  workClass: "interactive",
  authorize: {
    moduleKey: "commerce",
    activityCode: "orders",
    action: "read"
  },
  load: async ({ tx, can }) => {
    const page = await listOrdersForAdmin(tx, ssr.tenantId, null, {
      status: activeStatus ?? undefined
    });
    const statusCounts = await countOrdersByStatus(tx, ssr.tenantId);
    const canUpdate = await can({
      moduleKey: "commerce",
      activityCode: "orders",
      action: "update"
    });

    return { orders: page.items, statusCounts, canUpdate };
  },
  onError: (error) => {
    logAdminPageError(
      "admin/commerce-orders.astro: failed to list orders",
      error,
      {
        correlationId: Astro.locals.correlationId
      }
    );
  }
});

const canRead = screen.state !== "denied";
const loadError = screen.state === "error";
const orders = screen.state === "allowed" ? screen.data.orders : [];
const statusCounts =
  screen.state === "allowed" ? screen.data.statusCounts : null;
const totalOrders = statusCounts
  ? Object.values(statusCounts as Record<OrderStatus, number>).reduce(
      (sum: number, n: number) => sum + n,
      0
    )
  : 0;
const canUpdate = screen.state === "allowed" && screen.data.canUpdate;
---

<AdminLayout
  title={t("Orders")}
  description={t("Guest checkout orders — status, payment, and totals.")}
>
  {
    !canRead && (
      <p class="state-notice fade-in-up" id="orders-denied">
        {t("You do not have permission to view orders.")}
      </p>
    )
  }
  {
    canRead && loadError && (
      <p class="state-notice fade-in-up" id="orders-error">
        {t("Orders could not be loaded right now. Please try again later.")}
      </p>
    )
  }

  {
    canRead && !loadError && (
      <p
        id="order-action-error"
        class="admin-create-error"
        role="alert"
        hidden
      />
    )
  }

  {
    canRead && !loadError && statusCounts && (
      <nav
        class="admin-segmented fade-in-up"
        aria-label={t("Filter by status")}
      >
        <a
          class="admin-segmented-option"
          aria-current={activeStatus === null ? "page" : "false"}
          href="/admin/commerce-orders"
        >
          {t("All")} ({totalOrders})
        </a>
        {ORDER_STATUSES.map((status) => (
          <a
            class="admin-segmented-option"
            aria-current={activeStatus === status ? "page" : "false"}
            data-status={status}
            href={`/admin/commerce-orders?status=${status}`}
          >
            {commerceLabel(labels.orderStatus, status)} ({statusCounts[status]})
          </a>
        ))}
      </nav>
    )
  }

  {
    canRead && !loadError && (
      <div class="data-table-scroll fade-in-up">
        <table
          class="data-table data-table--stack"
          id="commerce-orders-table"
          data-can-update={canUpdate ? "true" : "false"}
          data-order-status-meta={JSON.stringify(orderStatusMeta)}
          data-gateway-labels={JSON.stringify(gatewayLabels)}
        >
          <caption>
            {tn("{count} order", "{count} orders", orders.length, {
              count: orders.length
            })}
          </caption>
          <thead>
            <tr>
              <th scope="col">{t("Order code")}</th>
              <th scope="col">{t("Customer")}</th>
              <th scope="col">{t("Status")}</th>
              <th scope="col">{t("Payment")}</th>
              <th scope="col">{t("Total")}</th>
              <th scope="col">{t("Placed")}</th>
              <th scope="col">{t("Payment gateway")}</th>
              {canUpdate && <th scope="col">{t("Actions")}</th>}
            </tr>
          </thead>
          <tbody>
            {orders.length === 0 ? (
              <tr>
                <td class="data-table-empty" colspan={canUpdate ? 8 : 7}>
                  <div class="empty-state">
                    <span class="empty-state-icon" aria-hidden="true">
                      ◇
                    </span>
                    <span class="empty-state-title">{t("No orders yet")}</span>
                    <span class="empty-state-text">
                      {t(
                        "Orders placed through the storefront will appear here."
                      )}
                    </span>
                  </div>
                </td>
              </tr>
            ) : (
              orders.map((order) => {
                // The confirm dialog's message is composed here with the
                // order code and the FROM status already substituted — the
                // TO status is only known once the operator changes the
                // `<select>`, so `{to}` is deliberately left as a literal
                // placeholder for the client script to finish (see this
                // file's own header comment for why that is safe).
                const confirmMessage = t(
                  "{orderCode} will move from {from} to {to}.",
                  {
                    orderCode: order.orderCode,
                    from: commerceLabel(labels.orderStatus, order.status)
                  }
                );

                return (
                  <>
                    <tr data-order-row={order.id}>
                      <td data-label={t("Order code")}>
                        <a
                          class="cell-code"
                          href={`/admin/commerce-orders/${order.id}`}
                        >
                          {order.orderCode}
                        </a>
                      </td>
                      <td data-label={t("Customer")}>
                        {order.customerName} ({order.customerPhoneMasked})
                      </td>
                      <td
                        data-label={t("Status")}
                        class={canUpdate ? "stacked-block" : ""}
                      >
                        <span
                          class="admin-status-pill"
                          data-tone={orderStatusTone[order.status] ?? "neutral"}
                          data-status={order.status}
                        >
                          <span
                            class="admin-status-pill-dot"
                            aria-hidden="true"
                          />
                          {commerceLabel(labels.orderStatus, order.status)}
                        </span>
                        {canUpdate && (
                          <select
                            class="order-status-input"
                            data-order-status={order.id}
                          >
                            {ORDER_STATUSES.map((status) => (
                              <option
                                value={status}
                                selected={order.status === status}
                              >
                                {commerceLabel(labels.orderStatus, status)}
                              </option>
                            ))}
                          </select>
                        )}
                      </td>
                      <td
                        data-label={t("Payment")}
                        data-payment-status={order.paymentStatus}
                      >
                        {commerceLabel(
                          labels.paymentStatus,
                          order.paymentStatus
                        )}
                      </td>
                      <td data-label={t("Total")}>{order.total}</td>
                      <td data-label={t("Placed")}>{order.createdAt}</td>
                      <td
                        data-label={t("Payment gateway")}
                        class="stacked-block"
                      >
                        <button
                          type="button"
                          class="module-toggle order-gateway-toggle-btn"
                          data-order-id={order.id}
                        >
                          {t("View gateway status")}
                        </button>
                      </td>
                      {canUpdate && (
                        <td data-label={t("Actions")} class="stacked-block">
                          <div class="row-actions">
                            <button
                              type="button"
                              class="module-toggle order-status-save-btn"
                              data-order-id={order.id}
                              data-confirm-title={t("Change order status?")}
                              data-confirm-message={confirmMessage}
                              data-confirm-note-label={t("Note (optional)")}
                              data-confirm-note-max-length="500"
                            >
                              {t("Save")}
                            </button>
                          </div>
                        </td>
                      )}
                    </tr>
                    <tr
                      class="order-gateway-panel-row"
                      data-order-gateway-panel-row={order.id}
                      hidden
                    >
                      <td colspan={canUpdate ? 8 : 7}>
                        <div
                          class="order-gateway-panel"
                          data-order-gateway-panel={order.id}
                        >
                          <p class="order-gateway-panel-loading">
                            {t("Loading…")}
                          </p>
                        </div>
                      </td>
                    </tr>
                  </>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    )
  }
  <CommerceConfirmDialog locale={Astro.locals.locale} />
</AdminLayout>

<style>
  /* Load-bearing, not defensive — the same specificity fix `users.astro`'s
     `.session-panel-row[hidden]` documents in full: `admin.css` turns every
     row of a `.data-table--stack` into a card below `--bp-md` with
     `.data-table--stack tr { display: block }` (specificity 0,1,1), which
     outranks the user-agent `[hidden] { display: none }` (0,1,0) — so on a
     phone the collapsed gateway panel below would NOT collapse.
     `.order-gateway-panel-row[hidden]` is (0,2,0) and wins in both layouts,
     and lives outside any media query on purpose (media queries add no
     specificity, so one rule covers both). */
  .order-gateway-panel-row[hidden] {
    display: none;
  }
</style>

<template id="order-gateway-panel-template">
  <div class="order-gateway-session">
    <h3>{t("Gateway payment session")}</h3>
    <p data-field="session-empty">
      {t("This order has no gateway payment session.")}
    </p>
    <dl data-field="session-detail" hidden>
      <dt>{t("Provider")}</dt>
      <dd data-field="session-provider"></dd>
      <dt>{t("Status")}</dt>
      <dd data-field="session-status"></dd>
      <dt>{t("Expires at")}</dt>
      <dd data-field="session-expires"></dd>
    </dl>
    <button
      type="button"
      class="module-toggle order-gateway-reconcile-btn"
      hidden
    >
      {t("Cek status")}
    </button>
  </div>
  <div class="order-gateway-events">
    <h3>{t("Payment events")}</h3>
    <ul data-field="events-list"></ul>
    <p data-field="events-empty">{t("No payment events recorded yet.")}</p>
  </div>
</template>

<script>
  import {
    messageBox,
    mutateAndReload,
    onAction,
    sendJson
  } from "../../lib/ui/admin-form-client";
  import {
    confirmCommerceActionWithNote,
    readConfirmOptionsWithNote
  } from "../../lib/ui/commerce-confirm-dialog-client";

  const actionError = messageBox("order-action-error");

  const ordersTable = document.querySelector<HTMLTableElement>(
    "#commerce-orders-table"
  );

  /** Read once, server-rendered — never translated in the browser (Issue #246). */
  interface OrderStatusMeta {
    labels: Record<string, string>;
    terminal: string[];
  }
  interface GatewayLabels {
    provider: Record<string, string>;
    status: Record<string, string>;
    outcome: Record<string, string>;
  }

  function parseJsonDataset<T>(raw: string | undefined, fallback: T): T {
    if (!raw) return fallback;
    try {
      return JSON.parse(raw) as T;
    } catch {
      return fallback;
    }
  }

  const orderStatusMeta = parseJsonDataset<OrderStatusMeta>(
    ordersTable?.dataset.orderStatusMeta,
    { labels: {}, terminal: [] }
  );
  const gatewayLabels = parseJsonDataset<GatewayLabels>(
    ordersTable?.dataset.gatewayLabels,
    { provider: {}, status: {}, outcome: {} }
  );

  onAction(".order-status-save-btn", async (button) => {
    const id = button.dataset.orderId;
    if (!id) return;

    const select = document.querySelector<HTMLSelectElement>(
      `[data-order-status="${id}"]`
    );
    const toStatus = select?.value ?? "";
    if (!select || !toStatus) return;

    // The dialog's message was rendered server-side with a literal `{to}`
    // placeholder (see this file's own header comment) — finishing that
    // translation here, from the server-rendered label map, is the ONLY
    // client-side text substitution this screen performs.
    const toLabel = orderStatusMeta.labels[toStatus] ?? toStatus;
    const options = readConfirmOptionsWithNote(button.dataset);
    options.message = options.message.replace("{to}", toLabel);
    // A terminal target status (no outgoing edge in the domain's own
    // transition graph — see `TERMINAL_ORDER_STATUSES` above) is destructive
    // enough to style as `danger`; this cannot be decided server-side since
    // the target is only known once the operator picks it.
    options.danger = orderStatusMeta.terminal.includes(toStatus);

    const result = await confirmCommerceActionWithNote(options);
    if (!result) return; // Cancelled — the select is left at its chosen value; nothing is sent.

    await mutateAndReload(
      button,
      actionError,
      () =>
        sendJson("PATCH", `/api/v1/commerce/orders/${id}/status`, {
          status: toStatus,
          ...(result.note ? { note: result.note } : {})
        }),
      "Could not update the order status. Check the transition is legal from the order's current status.",
      "Saving…"
    );
  });

  // Issue #113 — read-only gateway session + payment-events panel, plus the
  // "Cek status" scoped reconcile action, on the order list's expandable
  // row (this module has no separate order DETAIL page, only this list).
  type GatewaySession = {
    provider: string;
    status: string;
    expiresAt: string;
  } | null;
  type PaymentEvent = {
    id: string;
    provider: string;
    eventKey: string;
    outcome: string;
    receivedAt: string;
  };
  type OrderGatewayDetail = {
    gateway: { session: GatewaySession; events: PaymentEvent[] };
  };

  const canUpdate = ordersTable?.dataset.canUpdate === "true";
  const panelTemplate = document.getElementById(
    "order-gateway-panel-template"
  ) as HTMLTemplateElement | null;
  const loadedOrderIds = new Set<string>();

  async function fetchOrderGatewayDetail(
    orderId: string
  ): Promise<{ ok: boolean; data: OrderGatewayDetail | null }> {
    try {
      const response = await fetch(`/api/v1/commerce/orders/${orderId}`, {
        credentials: "same-origin"
      });
      const payload = (await response.json().catch(() => null)) as {
        success?: boolean;
        data?: OrderGatewayDetail;
      } | null;
      if (!response.ok || !payload?.success || !payload.data) {
        return { ok: false, data: null };
      }
      return { ok: true, data: payload.data };
    } catch {
      return { ok: false, data: null };
    }
  }

  async function renderGatewayPanel(orderId: string, panel: HTMLElement) {
    const { ok, data } = await fetchOrderGatewayDetail(orderId);
    panel.innerHTML = "";
    if (!panelTemplate) return;
    panel.appendChild(panelTemplate.content.cloneNode(true));

    if (!ok || !data) {
      const empty = panel.querySelector<HTMLElement>(
        '[data-field="session-empty"]'
      );
      if (empty) empty.textContent = "Could not load payment-gateway status.";
      return;
    }

    const { session, events } = data.gateway;

    const sessionEmpty = panel.querySelector<HTMLElement>(
      '[data-field="session-empty"]'
    );
    const sessionDetail = panel.querySelector<HTMLElement>(
      '[data-field="session-detail"]'
    );
    const reconcileBtn = panel.querySelector<HTMLButtonElement>(
      ".order-gateway-reconcile-btn"
    );

    if (session) {
      if (sessionEmpty) sessionEmpty.hidden = true;
      if (sessionDetail) {
        sessionDetail.hidden = false;
        const provider = sessionDetail.querySelector(
          '[data-field="session-provider"]'
        );
        const status = sessionDetail.querySelector(
          '[data-field="session-status"]'
        );
        const expires = sessionDetail.querySelector(
          '[data-field="session-expires"]'
        );
        if (provider) {
          provider.setAttribute("data-raw-value", session.provider);
          provider.textContent =
            gatewayLabels.provider[session.provider] ?? session.provider;
        }
        if (status) {
          status.setAttribute("data-raw-value", session.status);
          status.textContent =
            gatewayLabels.status[session.status] ?? session.status;
        }
        if (expires) expires.textContent = session.expiresAt;
      }
      if (reconcileBtn && canUpdate) {
        reconcileBtn.hidden = false;
        reconcileBtn.dataset.orderId = orderId;
      }
    }

    const eventsList = panel.querySelector<HTMLElement>(
      '[data-field="events-list"]'
    );
    const eventsEmpty = panel.querySelector<HTMLElement>(
      '[data-field="events-empty"]'
    );
    if (events.length === 0) {
      if (eventsEmpty) eventsEmpty.hidden = false;
    } else {
      if (eventsEmpty) eventsEmpty.hidden = true;
      for (const event of events) {
        const item = document.createElement("li");
        item.setAttribute("data-raw-provider", event.provider);
        item.setAttribute("data-raw-outcome", event.outcome);
        const providerLabel =
          gatewayLabels.provider[event.provider] ?? event.provider;
        const outcomeLabel =
          gatewayLabels.outcome[event.outcome] ?? event.outcome;
        item.textContent = `${event.receivedAt} — ${providerLabel} — ${outcomeLabel} (${event.eventKey})`;
        eventsList?.appendChild(item);
      }
    }
  }

  onAction(".order-gateway-toggle-btn", async (button) => {
    const id = button.dataset.orderId;
    if (!id) return;
    const row = document.querySelector<HTMLTableRowElement>(
      `[data-order-gateway-panel-row="${id}"]`
    );
    if (!row) return;

    row.hidden = !row.hidden;
    if (!row.hidden && !loadedOrderIds.has(id)) {
      loadedOrderIds.add(id);
      const panel = row.querySelector<HTMLElement>(
        `[data-order-gateway-panel="${id}"]`
      );
      if (panel) await renderGatewayPanel(id, panel);
    }
  });

  onAction(".order-gateway-reconcile-btn", async (button) => {
    const id = button.dataset.orderId;
    if (!id) return;

    await mutateAndReload(
      button,
      actionError,
      () =>
        sendJson(
          "POST",
          `/api/v1/commerce/orders/${id}/payment-gateway/reconcile`,
          undefined,
          { "Idempotency-Key": crypto.randomUUID() }
        ),
      "Could not check the payment-gateway status for this order.",
      "Checking…"
    );
  });
</script>
