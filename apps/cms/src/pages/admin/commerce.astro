---
/**
 * Commerce product CRUD screen (Issue #4, brought to full CRUD by Issue #23):
 * list with filters, a create form covering every core field plus the common
 * merchandising flags, per-row inline edit for the core fields, an "Advanced
 * fields (JSON)" editor for the long tail of Issue #23's parity columns
 * (tiered pricing, insurance, promo banner, size chart, service form,
 * subscription/digital, variant attributes — see this file's own comment on
 * why those are JSON rather than thirty individual controls), an images
 * picker sourced from `media_library`'s registry, a variants editor, status
 * transition, soft delete, and restore.
 *
 * Every control here is UX-only — the API routes it calls are the real
 * authority (same rule `offices.astro` documents).
 *
 * Issue #247 adds three things on top: every product type/status render
 * (badge, table cell, filter/create/inline-edit `<select>`) goes through
 * `commerce-admin-labels.ts`'s shared maps instead of the raw column value;
 * the All/Published/Draft quick-filter tabs show a per-status count
 * (`countProductsByStatus`, one extra grouped query — see its own docblock
 * for why it deliberately ignores this screen's other filters); and the
 * product list gets real bulk Publish/Move to draft/Delete actions, wired
 * entirely by `commerce-products-bulk-client.ts` (read that module's header
 * before touching either the bar or the checkbox column — it explains the
 * `{n}` placeholder trick the live selection count and the delete
 * confirmation message both depend on).
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import CommerceConfirmDialog from "../../components/CommerceConfirmDialog.astro";
import "../../styles/admin-screens.css";
import { loadAdminScreen } from "../../lib/auth/admin-screen";
import { logAdminPageError } from "../../lib/logging/error-log";
import { getTranslatorFor } from "../../lib/i18n";
import { mediaLibraryPortAdapter } from "../../modules/media-library/application/media-library-port-adapter";
import { listMediaObjects } from "../../modules/media-library/application/media-object-directory";
import {
  attachProductRelations,
  countProductsByStatus,
  listDeletedProductsForAdmin,
  listProductsForAdmin,
  type ProductAdminRecord,
  type ProductImageDTO,
  type ProductVariantDTO
} from "../../modules/commerce/application/product-directory";
import { listCategories } from "../../modules/commerce/application/category-directory";
import { PRODUCT_TYPES } from "../../modules/commerce/domain/product-type";
import {
  isProductStatus,
  PRODUCT_STATUSES,
  type ProductStatus
} from "../../modules/commerce/domain/product-status";
import {
  commerceLabel,
  createCommerceLabels
} from "../../lib/ui/commerce-admin-labels";
import CommerceAttributeInputs from "../../components/CommerceAttributeInputs.astro";
import {
  listAttributeDefinitions,
  type AttributeDefinitionRecord
} from "../../modules/commerce/application/attribute-definition-directory";
import { resolveAttributeFilterRequest } from "../../modules/commerce/application/attribute-filter-sql";
import {
  loadAttributeSets,
  type ProductAttributeSet
} from "../../modules/commerce/application/attribute-value-directory";
import { attributeAppliesToTarget } from "../../modules/commerce/domain/attribute-definition";
import { resolveAttributeLabel } from "../../modules/commerce/domain/attribute-definition";
import { ATTRIBUTE_FILTER_OPERATORS } from "../../modules/commerce/domain/attribute-filter";

type AdminProductRow = ProductAdminRecord & {
  images: ProductImageDTO[];
  variants: ProductVariantDTO[];
};

/** The long tail of Issue #23's parity fields, edited as one JSON object rather than thirty individual controls — see this file's header. */
const ADVANCED_FIELD_KEYS = [
  "priceLevel2",
  "priceLevel3",
  "priceLevel4",
  "costPrice",
  "manualRating",
  "manualSoldCount",
  "withInsurance",
  "insuranceRequired",
  "insuranceFee",
  "promoBannerShow",
  "promoBannerTitle",
  "promoBannerSubtitle",
  "promoBannerBadge",
  "promoBannerIcon",
  "promoBannerColor",
  "sizeChartType",
  "sizeChartMediaId",
  "sizeChartDetails",
  "serviceForm",
  "subscriptionPeriod",
  "downloadLink",
  "allowDp",
  "allowFreeShipping",
  "variantAttributes"
] as const;

function advancedFieldsJson(product: ProductAdminRecord): string {
  const picked: Record<string, unknown> = {};
  for (const key of ADVANCED_FIELD_KEYS) {
    picked[key] = (product as unknown as Record<string, unknown>)[key];
  }
  return JSON.stringify(picked, null, 2);
}

const ssr = Astro.locals.ssrContext!;
const { t, tn } = getTranslatorFor(Astro.locals.locale);
const labels = createCommerceLabels(t);

/** Issue #291 — one label per member of the CLOSED attribute-filter operator set. */
const attributeOperatorLabels = {
  eq: t("equals"),
  in: t("is one of (comma-separated)"),
  gte: t("is at least"),
  lte: t("is at most"),
  contains: t("contains")
} satisfies Record<(typeof ATTRIBUTE_FILTER_OPERATORS)[number], string>;

const url = new URL(Astro.request.url);
const filterCategoryId = url.searchParams.get("categoryId") ?? "";
const filterStatus = url.searchParams.get("status") ?? "";
const filterQuery = url.searchParams.get("q") ?? "";
const filterFeatured = url.searchParams.get("featured") === "true";
const filterRecommended = url.searchParams.get("recommended") === "true";

/**
 * Issue #291 — up to three typed attribute filters, submitted as
 * `af<N>Key`/`af<N>Op`/`af<N>Value` and turned into the same
 * `attr=<key>:<operator>:<value>` grammar the API takes. A row with no key or
 * no value is ignored; the grammar's own validators (closed operator set,
 * definition-bound key, typed operand) decide the rest — nothing here builds
 * SQL.
 */
const ATTRIBUTE_FILTER_SLOTS = 3;
const attributeFilterInputs = Array.from(
  { length: ATTRIBUTE_FILTER_SLOTS },
  (_, index) => ({
    key: url.searchParams.get(`af${index + 1}Key`) ?? "",
    op: url.searchParams.get(`af${index + 1}Op`) ?? "eq",
    value: url.searchParams.get(`af${index + 1}Value`) ?? ""
  })
);
const attributeFilterParams = attributeFilterInputs
  .filter((entry) => entry.key.length > 0 && entry.value.length > 0)
  .map((entry) => `${entry.key}:${entry.op}:${entry.value}`);

const screen = await loadAdminScreen({
  ssr,
  workClass: "interactive",
  authorize: {
    moduleKey: "commerce",
    activityCode: "products",
    action: "read"
  },
  load: async ({ tx, can }) => {
    // Issue #291 — attribute definitions/values are an admin-only read
    // (`attributes.read`): without it the screen is exactly what it was.
    const canReadAttributes = await can({
      moduleKey: "commerce",
      activityCode: "attributes",
      action: "read"
    });
    const attributeDefinitions = canReadAttributes
      ? await listAttributeDefinitions(tx, ssr.tenantId, { audience: "admin" })
      : [];

    let attributeFilters: Awaited<
      ReturnType<typeof resolveAttributeFilterRequest>
    > = { valid: true, filters: [] };
    if (canReadAttributes && attributeFilterParams.length > 0) {
      attributeFilters = await resolveAttributeFilterRequest(
        tx,
        ssr.tenantId,
        attributeFilterParams,
        "admin"
      );
    }
    const attributeFilterInvalid = !attributeFilters.valid;

    // One transaction, one awaited query at a time — see `offices.astro`'s
    // comment; nothing here runs in parallel.
    const page = await listProductsForAdmin(tx, ssr.tenantId, null, {
      categoryId: filterCategoryId || undefined,
      status: isProductStatus(filterStatus) ? filterStatus : undefined,
      q: filterQuery || undefined,
      featured: url.searchParams.has("featured") ? filterFeatured : undefined,
      recommended: url.searchParams.has("recommended")
        ? filterRecommended
        : undefined,
      attributeFilters: attributeFilters.valid ? attributeFilters.filters : [],
      // A `products.read`-only operator searches the public attribute set,
      // exactly like the storefront: a non-public value must not be probeable.
      attributeAudience: canReadAttributes ? "admin" : "public"
    });
    const attributeSets: Map<string, ProductAttributeSet> =
      canReadAttributes && attributeDefinitions.length > 0
        ? await loadAttributeSets(
            tx,
            ssr.tenantId,
            page.items.map((product) => product.id),
            "admin"
          )
        : new Map();
    const withRelations = (await attachProductRelations(
      tx,
      ssr.tenantId,
      mediaLibraryPortAdapter,
      page.items
    )) as unknown as AdminProductRow[];
    const statusCounts = await countProductsByStatus(tx, ssr.tenantId);

    const canCreate = await can({
      moduleKey: "commerce",
      activityCode: "products",
      action: "create"
    });
    const canUpdate = await can({
      moduleKey: "commerce",
      activityCode: "products",
      action: "update"
    });
    const canDelete = await can({
      moduleKey: "commerce",
      activityCode: "products",
      action: "delete"
    });
    const canRestore = await can({
      moduleKey: "commerce",
      activityCode: "products",
      action: "restore"
    });

    const categoryPage = await listCategories(tx, ssr.tenantId, null, {});
    const deleted = canRestore
      ? await listDeletedProductsForAdmin(tx, ssr.tenantId)
      : [];
    const mediaOptions = canUpdate
      ? (await listMediaObjects(tx, ssr.tenantId, { deletion: "live" })).items
      : [];
    const canExport = await can({
      moduleKey: "commerce",
      activityCode: "products",
      action: "export"
    });

    return {
      attributeDefinitions,
      attributeSets,
      attributeFilterInvalid,
      canExport,
      products: withRelations,
      categories: categoryPage.items,
      deleted,
      mediaOptions,
      statusCounts,
      canCreate,
      canUpdate,
      canDelete,
      canRestore
    };
  },
  onError: (error) => {
    logAdminPageError("admin/commerce.astro: failed to list products", error, {
      correlationId: Astro.locals.correlationId
    });
  }
});

const canRead = screen.state !== "denied";
const loadError = screen.state === "error";
const products = screen.state === "allowed" ? screen.data.products : [];
const categories = screen.state === "allowed" ? screen.data.categories : [];
const deletedProducts = screen.state === "allowed" ? screen.data.deleted : [];
const mediaOptions = screen.state === "allowed" ? screen.data.mediaOptions : [];
const statusCounts =
  screen.state === "allowed" ? screen.data.statusCounts : null;
const totalProductCount = statusCounts
  ? Object.values(statusCounts as Record<ProductStatus, number>).reduce(
      (sum: number, n: number) => sum + n,
      0
    )
  : 0;
const attributeDefinitions: AttributeDefinitionRecord[] =
  screen.state === "allowed" ? screen.data.attributeDefinitions : [];
const attributeSets: Map<string, ProductAttributeSet> =
  screen.state === "allowed" ? screen.data.attributeSets : new Map();
const attributeFilterInvalid =
  screen.state === "allowed" && screen.data.attributeFilterInvalid;
const canExport = screen.state === "allowed" && screen.data.canExport;
const filterableDefinitions = attributeDefinitions.filter(
  (definition) => definition.isFilterable
);
const productDefinitions = attributeDefinitions.filter((definition) =>
  attributeAppliesToTarget(definition.appliesTo, "product")
);
const variantDefinitions = attributeDefinitions.filter((definition) =>
  attributeAppliesToTarget(definition.appliesTo, "variant")
);
const emptyAttributeSet: ProductAttributeSet = { product: [], variants: {} };
const canCreate = screen.state === "allowed" && screen.data.canCreate;
const canUpdate = screen.state === "allowed" && screen.data.canUpdate;
const canDelete = screen.state === "allowed" && screen.data.canDelete;
const canRestore = screen.state === "allowed" && screen.data.canRestore;
const showActions = canUpdate || canDelete;
/**
 * The header select-all checkbox, the per-row checkbox column, and the
 * `.admin-bulk-bar` are gated on the SAME predicate as the row Actions
 * column (`showActions`): if an operator can neither update nor delete a
 * product, there is no bulk action the selection could ever drive, so the
 * checkboxes are not rendered at all rather than shown disabled. This also
 * fixes the `<td colspan>` the expandable per-row edit panel below needs —
 * it must span every column the header actually has, and the header now has
 * 6 fixed columns (SKU/Name/Type/Price/Stock/Status) plus Select AND
 * Actions together, never one without the other.
 */
const totalTableColumns = 6 + (showActions ? 2 : 0);
---

<AdminLayout
  title={t("Products")}
  description={t(
    "The tenant's product catalog: filters, full create/edit, images, variants, status, soft delete and restore."
  )}
>
  {!canRead && (
    <p class="state-notice fade-in-up" id="commerce-denied">
      {t("You do not have permission to view products.")}
    </p>
  )}

  {canRead && loadError && (
    <p class="state-notice fade-in-up" id="commerce-error">
      {t("Products could not be loaded right now. Please try again later.")}
    </p>
  )}

  {canRead && !loadError && statusCounts && (
    <nav
      class="admin-segmented fade-in-up"
      aria-label={t("Quick status filter")}
    >
      <a
        class="admin-segmented-option"
        aria-current={filterStatus === "" ? "page" : "false"}
        href="/admin/commerce"
      >
        {t("All")} ({totalProductCount})
      </a>
      <a
        class="admin-segmented-option"
        aria-current={filterStatus === "active" ? "page" : "false"}
        href="/admin/commerce?status=active"
      >
        {t("Published")} ({statusCounts.active})
      </a>
      <a
        class="admin-segmented-option"
        aria-current={filterStatus === "draft" ? "page" : "false"}
        href="/admin/commerce?status=draft"
      >
        {t("Draft")} ({statusCounts.draft})
      </a>
    </nav>
  )}

  {canRead && !loadError && (
    <form
      id="product-filter-form"
      class="admin-create-form fade-in-up"
      method="get"
    >
      <p class="form-legend">{t("Filters")}</p>
      <label for="filter-categoryId">{t("Category")}</label>
      <select id="filter-categoryId" name="categoryId">
        <option value="">{t("All categories")}</option>
        {categories.map((category) => (
          <option
            value={category.id}
            selected={category.id === filterCategoryId}
          >
            {category.name}
          </option>
        ))}
      </select>

      <label for="filter-status">{t("Status")}</label>
      <select id="filter-status" name="status">
        <option value="">{t("All statuses")}</option>
        {PRODUCT_STATUSES.map((status) => (
          <option value={status} selected={status === filterStatus}>
            {commerceLabel(labels.productStatus, status)}
          </option>
        ))}
      </select>

      <label for="filter-q">{t("Search (name or SKU)")}</label>
      <input id="filter-q" name="q" type="text" value={filterQuery} />

      <label>
        <input
          type="checkbox"
          name="featured"
          value="true"
          checked={filterFeatured}
        />{" "}
        {t("Featured only")}
      </label>
      <label>
        <input
          type="checkbox"
          name="recommended"
          value="true"
          checked={filterRecommended}
        />{" "}
        {t("Recommended only")}
      </label>

      {filterableDefinitions.length > 0 && (
        <fieldset class="attribute-filters" id="attribute-filters">
          <legend>{t("Attribute filters")}</legend>
          {attributeFilterInputs.map((entry, index) => (
            <div class="attribute-filter-row">
              <label for={`filter-af${index + 1}Key`}>{t("Attribute")}</label>
              <select
                id={`filter-af${index + 1}Key`}
                name={`af${index + 1}Key`}
              >
                <option value="">{t("Not filtered")}</option>
                {filterableDefinitions.map((definition) => (
                  <option
                    value={definition.key}
                    selected={definition.key === entry.key}
                  >
                    {resolveAttributeLabel(definition, Astro.locals.locale)}
                  </option>
                ))}
              </select>
              <label for={`filter-af${index + 1}Op`}>{t("Condition")}</label>
              <select id={`filter-af${index + 1}Op`} name={`af${index + 1}Op`}>
                {ATTRIBUTE_FILTER_OPERATORS.map((operator) => (
                  <option value={operator} selected={operator === entry.op}>
                    {attributeOperatorLabels[operator]}
                  </option>
                ))}
              </select>
              <label for={`filter-af${index + 1}Value`}>{t("Value")}</label>
              <input
                id={`filter-af${index + 1}Value`}
                name={`af${index + 1}Value`}
                type="text"
                value={entry.value}
                autocomplete="off"
              />
            </div>
          ))}
          {attributeFilterInvalid && (
            <p
              class="admin-create-error"
              role="alert"
              id="attribute-filter-error"
            >
              {t(
                "The attribute filters could not be applied: check the attribute, the condition and that the value matches the attribute's type."
              )}
            </p>
          )}
        </fieldset>
      )}

      <button type="submit">{t("Apply filters")}</button>
      {canExport && (
        <a
          class="module-toggle"
          id="product-export-link"
          href="/api/v1/commerce/products/export.csv"
          download="products.csv"
        >
          {t("Export CSV")}
        </a>
      )}
    </form>
  )}

  {canCreate && (
    <form id="product-create-form" class="admin-create-form fade-in-up">
      <p class="form-legend">{t("Create a product")}</p>
      <p
        id="product-create-error"
        class="admin-create-error"
        role="alert"
        hidden
      />

      <label for="create-sku">{t("SKU")}</label>
      <input
        id="create-sku"
        name="sku"
        type="text"
        required
        autocomplete="off"
      />

      <label for="create-name">{t("Name")}</label>
      <input
        id="create-name"
        name="name"
        type="text"
        required
        autocomplete="off"
      />

      <label for="create-slug">{t("Slug")}</label>
      <input
        id="create-slug"
        name="slug"
        type="text"
        required
        autocomplete="off"
      />

      <label for="create-categoryId">{t("Category")}</label>
      <select id="create-categoryId" name="categoryId">
        <option value="">{t("None")}</option>
        {categories.map((category) => (
          <option value={category.id}>{category.name}</option>
        ))}
      </select>

      <label for="create-type">{t("Type")}</label>
      <select id="create-type" name="type">
        {PRODUCT_TYPES.map((type) => (
          <option value={type}>
            {commerceLabel(labels.productType, type)}
          </option>
        ))}
      </select>

      <label for="create-price">{t("Price")}</label>
      <input
        id="create-price"
        name="price"
        type="text"
        required
        autocomplete="off"
      />

      <label for="create-discountPercent">{t("Discount percent")}</label>
      <input
        id="create-discountPercent"
        name="discountPercent"
        type="number"
        min="0"
        max="100"
        value="0"
      />

      <label for="create-stock">{t("Stock")}</label>
      <input id="create-stock" name="stock" type="number" min="0" value="0" />

      <label for="create-minPurchase">{t("Minimum purchase")}</label>
      <input
        id="create-minPurchase"
        name="minPurchase"
        type="number"
        min="1"
        value="1"
      />

      <label for="create-weightGrams">{t("Weight (grams)")}</label>
      <input
        id="create-weightGrams"
        name="weightGrams"
        type="number"
        min="0"
        value="0"
      />

      <label for="create-description">{t("Description")}</label>
      <textarea id="create-description" name="description" />

      <label>
        <input type="checkbox" name="isFeatured" value="true" /> {t("Featured")}
      </label>
      <label>
        <input type="checkbox" name="isRecommended" value="true" />{" "}
        {t("Recommended")}
      </label>

      <label for="create-advancedFields">
        {t("Advanced fields (JSON, optional)")}
      </label>
      <textarea
        id="create-advancedFields"
        name="advancedFields"
        rows="4"
        placeholder="{}"
      />

      <button type="submit" id="product-create-submit">
        {t("Create product")}
      </button>
    </form>
  )}

  {canRead && !loadError && (
    <p
      id="product-action-error"
      class="admin-create-error"
      role="alert"
      hidden
    />
  )}

  {
    /**
     * Bulk selection bar (Issue #247) — CSS-hidden by `hidden` here AND by
     * `.bulk-select-col`'s own default `display: none` below; JavaScript
     * (`commerce-products-bulk-client.ts`) is what reveals both once it
     * actually runs, so a no-JS visitor keeps the per-row-only UI this
     * screen always had. Rendered only when there is at least one bulk
     * action an operator with this permission set could take — the same
     * `showActions` predicate the row Actions column already uses.
     *
     * Every `data-*` attribute below is a translated STRING or TEMPLATE this
     * page renders once, server-side; the client never calls `t()`/`tn()`
     * itself. `data-count-template-one`/`-other` and the delete button's
     * `data-confirm-message-template-*` are the two grammatical forms this
     * locale's plural rule produces (see
     * `commerce-products-bulk-client.ts`'s header for the `{n}` mechanism),
     * still carrying an unfilled `{n}` the client fills with the live
     * selection count.
     */
    canRead && !loadError && showActions && products.length > 0 && (
      <div
        class="admin-bulk-bar fade-in-up"
        id="product-bulk-bar"
        role="region"
        aria-label={t("Bulk actions")}
        data-progress-template={t("Processing {done} of {total}…")}
        data-generic-failure-reason={t(
          "Could not process this product. Please try again."
        )}
        hidden
      >
        <span
          class="admin-bulk-bar-count"
          id="product-bulk-bar-count"
          aria-live="polite"
          data-count-template-one={tn(
            "{n} product selected",
            "{n} products selected",
            1
          )}
          data-count-template-other={tn(
            "{n} product selected",
            "{n} products selected",
            2
          )}
        >
          {t("0 selected")}
        </span>
        <div class="admin-bulk-bar-actions">
          {canUpdate && (
            <button
              type="button"
              class="module-toggle"
              id="product-bulk-publish-btn"
              data-failure-header-template={t(
                "{failedCount} of {totalCount} selected products could not be published."
              )}
            >
              {t("Publish")}
            </button>
          )}
          {canUpdate && (
            <button
              type="button"
              class="module-toggle"
              id="product-bulk-draft-btn"
              data-failure-header-template={t(
                "{failedCount} of {totalCount} selected products could not be moved to draft."
              )}
            >
              {t("Move to draft")}
            </button>
          )}
          {canDelete && (
            <button
              type="button"
              class="module-toggle"
              id="product-bulk-delete-btn"
              data-confirm-title={t("Delete the selected products?")}
              data-confirm-label={t("Delete products")}
              data-confirm-message-template-one={tn(
                "{n} selected product will be moved to trash and can be restored later.",
                "{n} selected products will be moved to trash and can be restored later.",
                1
              )}
              data-confirm-message-template-other={tn(
                "{n} selected product will be moved to trash and can be restored later.",
                "{n} selected products will be moved to trash and can be restored later.",
                2
              )}
              data-failure-header-template={t(
                "{failedCount} of {totalCount} selected products could not be deleted."
              )}
            >
              {t("Delete")}
            </button>
          )}
        </div>
      </div>
    )
  }

  {canRead && !loadError && (
    <div
      class="data-table-scroll fade-in-up"
      role="region"
      tabindex="0"
      aria-label={t("Products")}
    >
      <table class="data-table data-table--stack" id="commerce-products-table">
        <caption>
          {tn("{count} product", "{count} products", products.length, {
            count: products.length
          })}
        </caption>
        <thead>
          <tr>
            {showActions && products.length > 0 && (
              <th scope="col" class="bulk-select-col">
                <input
                  type="checkbox"
                  id="commerce-products-select-all"
                  aria-label={t("Select all products on this page")}
                />
              </th>
            )}
            <th scope="col">{t("SKU")}</th>
            <th scope="col">{t("Name")}</th>
            <th scope="col">{t("Type")}</th>
            <th scope="col">{t("Price")}</th>
            <th scope="col">{t("Stock")}</th>
            <th scope="col">{t("Status")}</th>
            {showActions && <th scope="col">{t("Actions")}</th>}
          </tr>
        </thead>
        <tbody>
          {products.length === 0 ? (
            <tr>
              <td class="data-table-empty" colspan={totalTableColumns}>
                <div class="empty-state">
                  <span class="empty-state-icon" aria-hidden="true">
                    ○
                  </span>
                  <span class="empty-state-title">{t("No products yet")}</span>
                  <span class="empty-state-text">
                    {t("Products created for this tenant will appear here.")}
                  </span>
                </div>
              </td>
            </tr>
          ) : (
            products.map((product) => (
              <>
                <tr data-product-row={product.id}>
                  {showActions && (
                    <td data-label={t("Select")} class="bulk-select-col">
                      <input
                        type="checkbox"
                        class="commerce-product-row-select"
                        data-product-id={product.id}
                        data-product-sku={product.sku}
                        aria-label={t("Select {name}", {
                          name: product.name
                        })}
                      />
                    </td>
                  )}
                  <td data-label={t("SKU")}>
                    <span class="cell-code">{product.sku}</span>
                  </td>
                  <td data-label={t("Name")}>{product.name}</td>
                  <td data-label={t("Type")}>
                    <span class="cell-muted" data-product-type={product.type}>
                      {commerceLabel(labels.productType, product.type)}
                    </span>
                  </td>
                  <td data-label={t("Price")}>{product.price}</td>
                  <td data-label={t("Stock")}>{product.stock}</td>
                  <td data-label={t("Status")}>
                    <span
                      class="admin-status-pill"
                      data-tone={
                        product.status === "active" ? "success" : "neutral"
                      }
                      data-product-status={product.status}
                    >
                      <span class="admin-status-pill-dot" aria-hidden="true" />
                      {commerceLabel(labels.productStatus, product.status)}
                    </span>
                  </td>
                  {showActions && (
                    <td data-label={t("Actions")} class="stacked-block">
                      <div class="row-actions">
                        {canDelete && (
                          <button
                            type="button"
                            class="module-toggle product-delete-btn"
                            data-product-id={product.id}
                            data-confirm-title={t("Delete this product?")}
                            data-confirm-message={t(
                              "Product {sku} will be moved to trash and can be restored later.",
                              { sku: product.sku }
                            )}
                            data-confirm-label={t("Delete product")}
                            data-confirm-danger="true"
                          >
                            {t("Delete")}
                          </button>
                        )}
                      </div>
                    </td>
                  )}
                </tr>
                {canUpdate && (
                  <tr>
                    <td colspan={totalTableColumns}>
                      <details class="admin-section">
                        <summary>{t("Edit")}</summary>

                        <form
                          class="admin-create-form product-edit-form"
                          data-product-id={product.id}
                        >
                          <p
                            id={`product-edit-error-${product.id}`}
                            class="admin-create-error"
                            role="alert"
                            hidden
                          />
                          <label>{t("Name")}</label>
                          <input name="name" type="text" value={product.name} />
                          <label>{t("Slug")}</label>
                          <input name="slug" type="text" value={product.slug} />
                          <label>{t("Category")}</label>
                          <select name="categoryId">
                            <option value="" selected={!product.categoryId}>
                              {t("None")}
                            </option>
                            {categories.map((category) => (
                              <option
                                value={category.id}
                                selected={category.id === product.categoryId}
                              >
                                {category.name}
                              </option>
                            ))}
                          </select>
                          <label>{t("Type")}</label>
                          <select name="type">
                            {PRODUCT_TYPES.map((type) => (
                              <option
                                value={type}
                                selected={type === product.type}
                              >
                                {commerceLabel(labels.productType, type)}
                              </option>
                            ))}
                          </select>
                          <label>{t("Price")}</label>
                          <input
                            name="price"
                            type="text"
                            value={product.price}
                          />
                          <label>{t("Discount percent")}</label>
                          <input
                            name="discountPercent"
                            type="number"
                            min="0"
                            max="100"
                            value={product.discountPercent}
                          />
                          <label>{t("Stock")}</label>
                          <input
                            name="stock"
                            type="number"
                            min="0"
                            value={product.stock}
                          />
                          <label>{t("Status")}</label>
                          <select name="status">
                            {PRODUCT_STATUSES.map((status) => (
                              <option
                                value={status}
                                selected={status === product.status}
                              >
                                {commerceLabel(labels.productStatus, status)}
                              </option>
                            ))}
                          </select>
                          <label>{t("Minimum purchase")}</label>
                          <input
                            name="minPurchase"
                            type="number"
                            min="1"
                            value={product.minPurchase}
                          />
                          <label>{t("Weight (grams)")}</label>
                          <input
                            name="weightGrams"
                            type="number"
                            min="0"
                            value={product.weightGrams}
                          />
                          <label>{t("Description")}</label>
                          <textarea name="description">
                              {product.description ?? ""}
                            </textarea>
                          <label>
                            <input
                              type="checkbox"
                              name="isFeatured"
                              value="true"
                              checked={product.isFeatured}
                            />{" "}
                            {t("Featured")}
                          </label>
                          <label>
                            <input
                              type="checkbox"
                              name="isRecommended"
                              value="true"
                              checked={product.isRecommended}
                            />{" "}
                            {t("Recommended")}
                          </label>
                          <label>{t("Advanced fields (JSON)")}</label>
                          <textarea name="advancedFields" rows="6">
                              {advancedFieldsJson(product)}
                            </textarea>
                          <button type="submit">{t("Save")}</button>
                        </form>

                        {productDefinitions.length > 0 && (
                          <section class="admin-section">
                            <h3 class="admin-section-title">
                              {t("Attributes")}
                              <span class="count-pill">
                                {
                                  (
                                    attributeSets.get(product.id) ??
                                    emptyAttributeSet
                                  ).product.length
                                }
                              </span>
                            </h3>
                            <form
                              class="admin-create-form attributes-form"
                              data-product-id={product.id}
                              data-failure={t(
                                "Could not save the attributes. Check every value matches its type."
                              )}
                            >
                              <p
                                id={`attributes-error-${product.id}`}
                                class="admin-create-error"
                                role="alert"
                                hidden
                              />
                              <CommerceAttributeInputs
                                locale={Astro.locals.locale}
                                idPrefix={`attr-${product.id}`}
                                definitions={productDefinitions}
                                values={
                                  (
                                    attributeSets.get(product.id) ??
                                    emptyAttributeSet
                                  ).product
                                }
                              />
                              <button type="submit" data-busy={t("Saving…")}>
                                {t("Save attributes")}
                              </button>
                            </form>
                          </section>
                        )}

                        <section class="admin-section">
                          <h3 class="admin-section-title">
                            {t("Images")}
                            <span class="count-pill">
                              {product.images.length}
                            </span>
                          </h3>
                          <ul>
                            {product.images.map((image) => (
                              <li data-product-image-row={image.id}>
                                {image.publicUrl ? (
                                  <img
                                    src={image.publicUrl}
                                    alt={image.altText ?? ""}
                                    style="max-height:48px;vertical-align:middle;margin-right:8px;"
                                  />
                                ) : (
                                  <span>{t("(unresolved image)")}</span>
                                )}
                                <span class="cell-muted">
                                  {image.altText ?? ""} · #{image.sortOrder}
                                </span>{" "}
                                <button
                                  type="button"
                                  class="module-toggle product-image-delete-btn"
                                  data-product-id={product.id}
                                  data-image-id={image.id}
                                >
                                  {t("Remove")}
                                </button>
                              </li>
                            ))}
                          </ul>
                          <form
                            class="admin-create-form product-image-add-form"
                            data-product-id={product.id}
                          >
                            <label>{t("Media object")}</label>
                            <select name="mediaObjectId" required>
                              <option value="">
                                {t("Select a media object")}
                              </option>
                              {mediaOptions.map((media) => (
                                <option value={media.id}>
                                  {media.originalFilename ?? media.id}
                                </option>
                              ))}
                            </select>
                            <label>{t("Alt text")}</label>
                            <input name="altText" type="text" />
                            <label>{t("Sort order")}</label>
                            <input name="sortOrder" type="number" value="0" />
                            <button type="submit">{t("Add image")}</button>
                          </form>
                        </section>

                        <section class="admin-section">
                          <h3 class="admin-section-title">
                            {t("Variants")}
                            <span class="count-pill">
                              {product.variants.length}
                            </span>
                          </h3>
                          <ul>
                            {product.variants.map((variant) => (
                              <li data-product-variant-row={variant.id}>
                                <span class="cell-muted">
                                  {variant.name}: {variant.value}
                                  {variant.sku ? ` (${variant.sku})` : ""}
                                  {variant.price
                                    ? ` — ${variant.price}`
                                    : ""} · {t("stock")} {variant.stock}
                                </span>{" "}
                                <button
                                  type="button"
                                  class="module-toggle product-variant-delete-btn"
                                  data-product-id={product.id}
                                  data-variant-id={variant.id}
                                >
                                  {t("Remove")}
                                </button>
                                {variantDefinitions.length > 0 && (
                                  <details class="admin-section">
                                    <summary>{t("Attributes")}</summary>
                                    <form
                                      class="admin-create-form attributes-form"
                                      data-product-id={product.id}
                                      data-variant-id={variant.id}
                                      data-failure={t(
                                        "Could not save the attributes. Check every value matches its type."
                                      )}
                                    >
                                      <p
                                        id={`attributes-error-${variant.id}`}
                                        class="admin-create-error"
                                        role="alert"
                                        hidden
                                      />
                                      <CommerceAttributeInputs
                                        locale={Astro.locals.locale}
                                        idPrefix={`attr-${variant.id}`}
                                        definitions={variantDefinitions}
                                        values={
                                          (
                                            attributeSets.get(product.id) ??
                                            emptyAttributeSet
                                          ).variants[variant.id] ?? []
                                        }
                                      />
                                      <button
                                        type="submit"
                                        data-busy={t("Saving…")}
                                      >
                                        {t("Save attributes")}
                                      </button>
                                    </form>
                                  </details>
                                )}
                              </li>
                            ))}
                          </ul>
                          <form
                            class="admin-create-form product-variant-add-form"
                            data-product-id={product.id}
                          >
                            <label>{t("Attribute name")}</label>
                            <input
                              name="name"
                              type="text"
                              required
                              placeholder="Size"
                            />
                            <label>{t("Value")}</label>
                            <input
                              name="value"
                              type="text"
                              required
                              placeholder="L"
                            />
                            <label>{t("SKU (optional)")}</label>
                            <input name="sku" type="text" />
                            <label>{t("Price (optional)")}</label>
                            <input name="price" type="text" />
                            <label>{t("Stock")}</label>
                            <input
                              name="stock"
                              type="number"
                              min="0"
                              value="0"
                            />
                            <button type="submit">{t("Add variant")}</button>
                          </form>
                        </section>
                      </details>
                    </td>
                  </tr>
                )}
              </>
            ))
          )}
        </tbody>
      </table>
    </div>
  )}

  {canRead && !loadError && canRestore && deletedProducts.length > 0 && (
    <section class="admin-section fade-in-up" id="deleted-products">
      <h2 class="admin-section-title">
        {t("Deleted products")}
        <span class="count-pill">{deletedProducts.length}</span>
      </h2>
      <div
        class="data-table-scroll"
        role="region"
        tabindex="0"
        aria-label={t("Deleted products")}
      >
        <table class="data-table data-table--stack" id="deleted-products-table">
          <thead>
            <tr>
              <th scope="col">{t("SKU")}</th>
              <th scope="col">{t("Name")}</th>
              <th scope="col">{t("Actions")}</th>
            </tr>
          </thead>
          <tbody>
            {deletedProducts.map((product) => (
              <tr data-deleted-product-row={product.id}>
                <td data-label={t("SKU")}>
                  <span class="cell-code">{product.sku}</span>
                </td>
                <td data-label={t("Name")}>{product.name}</td>
                <td data-label={t("Actions")} class="stacked-block">
                  <div class="row-actions">
                    <button
                      type="button"
                      class="module-toggle product-restore-btn"
                      data-product-id={product.id}
                      data-product-sku={product.sku}
                    >
                      {t("Restore")}
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}
  <CommerceConfirmDialog locale={Astro.locals.locale} />
</AdminLayout>

<style>
  /*
   * Issue #247 — the checkbox column is CSS-hidden until
   * `commerce-products-bulk-client.ts` actually runs (adds
   * `.bulk-select-ready` to the table), so a no-JS visitor keeps today's
   * per-row-only UI rather than a column of checkboxes that do nothing.
   * Scoped to THIS table's id, same as `commerce-orders.astro`'s own
   * `.order-gateway-panel-row[hidden]` fix — a class selector alone would
   * also match `#deleted-products-table` below, which never gets a bulk bar.
   */
  #commerce-products-table .bulk-select-col {
    display: none;
  }

  #commerce-products-table.bulk-select-ready .bulk-select-col {
    display: table-cell;
  }

  .bulk-select-col input[type="checkbox"] {
    width: 20px;
    height: 20px;
    cursor: pointer;
  }
</style>

<script>
  import {
    field,
    messageBox,
    mutateAndReload,
    onAction,
    onSubmit,
    onSubmitAll,
    sendJson
  } from "../../lib/ui/admin-form-client";
  import { confirmFromTrigger } from "../../lib/ui/commerce-confirm-dialog-client";
  import { initCommerceProductsBulk } from "../../lib/ui/commerce-products-bulk-client";
  import { collectAttributeValues } from "../../lib/ui/commerce-attributes-client";

  function parseAdvancedFields(raw: string): Record<string, unknown> | null {
    const trimmed = raw.trim();
    if (trimmed.length === 0) return {};
    try {
      const parsed = JSON.parse(trimmed);
      return parsed && typeof parsed === "object" && !Array.isArray(parsed)
        ? (parsed as Record<string, unknown>)
        : null;
    } catch {
      return null;
    }
  }

  const createError = messageBox("product-create-error");

  onSubmit("product-create-form", async ({ data, submit }) => {
    const advanced = parseAdvancedFields(field(data, "advancedFields"));
    if (advanced === null) {
      createError.show(
        "Advanced fields must be valid JSON (an object), or left blank."
      );
      return;
    }

    await mutateAndReload(
      submit,
      createError,
      () =>
        sendJson("POST", "/api/v1/commerce/products", {
          sku: field(data, "sku"),
          name: field(data, "name"),
          slug: field(data, "slug"),
          categoryId: field(data, "categoryId") || null,
          type: field(data, "type"),
          price: field(data, "price"),
          discountPercent: Number(field(data, "discountPercent") || "0"),
          stock: Number(field(data, "stock") || "0"),
          minPurchase: Number(field(data, "minPurchase") || "1"),
          weightGrams: Number(field(data, "weightGrams") || "0"),
          description: field(data, "description") || null,
          isFeatured: data.get("isFeatured") !== null,
          isRecommended: data.get("isRecommended") !== null,
          ...advanced
        }),
      "Could not create the product. Check the required fields and try again."
    );
  });

  const actionError = messageBox("product-action-error");

  onAction(".product-delete-btn", async (button) => {
    const id = button.dataset.productId;
    if (!id) return;
    const confirmed = await confirmFromTrigger(button);
    if (!confirmed) return;

    await mutateAndReload(
      button,
      actionError,
      () => sendJson("DELETE", `/api/v1/commerce/products/${id}`),
      "Could not delete the product. Please try again.",
      "Deleting…"
    );
  });

  onAction(".product-restore-btn", async (button) => {
    const id = button.dataset.productId;
    if (!id) return;

    await mutateAndReload(
      button,
      actionError,
      () => sendJson("POST", `/api/v1/commerce/products/${id}/restore`),
      (errorCode) =>
        errorCode === "PRODUCT_SLUG_ALREADY_EXISTS" ||
        errorCode === "PRODUCT_SKU_ALREADY_EXISTS"
          ? "Cannot restore: another product already uses this slug or SKU."
          : "Could not restore the product. Please try again.",
      "Restoring…"
    );
  });

  onSubmitAll(".product-edit-form", async ({ form, data, submit }) => {
    const id = form.dataset.productId;
    if (!id) return;
    const rowError = messageBox(`product-edit-error-${id}`);

    const advanced = parseAdvancedFields(field(data, "advancedFields"));
    if (advanced === null) {
      rowError.show("Advanced fields must be valid JSON (an object).");
      return;
    }

    await mutateAndReload(
      submit,
      rowError,
      () =>
        sendJson("PATCH", `/api/v1/commerce/products/${id}`, {
          name: field(data, "name"),
          slug: field(data, "slug"),
          categoryId: field(data, "categoryId") || null,
          type: field(data, "type"),
          price: field(data, "price"),
          discountPercent: Number(field(data, "discountPercent") || "0"),
          stock: Number(field(data, "stock") || "0"),
          status: field(data, "status"),
          minPurchase: Number(field(data, "minPurchase") || "1"),
          weightGrams: Number(field(data, "weightGrams") || "0"),
          description: field(data, "description") || null,
          isFeatured: data.get("isFeatured") !== null,
          isRecommended: data.get("isRecommended") !== null,
          ...advanced
        }),
      "Could not save the product. Please try again."
    );
  });

  onSubmitAll(".product-image-add-form", async ({ form, data, submit }) => {
    const id = form.dataset.productId;
    if (!id) return;

    await mutateAndReload(
      submit,
      actionError,
      () =>
        sendJson("POST", `/api/v1/commerce/products/${id}/images`, {
          mediaObjectId: field(data, "mediaObjectId"),
          altText: field(data, "altText") || null,
          sortOrder: Number(field(data, "sortOrder") || "0")
        }),
      "Could not add the image. Make sure a media object is selected."
    );
  });

  onAction(".product-image-delete-btn", async (button) => {
    const productId = button.dataset.productId;
    const imageId = button.dataset.imageId;
    if (!productId || !imageId) return;

    await mutateAndReload(
      button,
      actionError,
      () =>
        sendJson(
          "DELETE",
          `/api/v1/commerce/products/${productId}/images/${imageId}`
        ),
      "Could not remove the image. Please try again.",
      "Removing…"
    );
  });

  onSubmitAll(".product-variant-add-form", async ({ form, data, submit }) => {
    const id = form.dataset.productId;
    if (!id) return;

    await mutateAndReload(
      submit,
      actionError,
      () =>
        sendJson("POST", `/api/v1/commerce/products/${id}/variants`, {
          name: field(data, "name"),
          value: field(data, "value"),
          sku: field(data, "sku") || null,
          price: field(data, "price") || null,
          stock: Number(field(data, "stock") || "0")
        }),
      "Could not add the variant. Please try again."
    );
  });

  onAction(".product-variant-delete-btn", async (button) => {
    const productId = button.dataset.productId;
    const variantId = button.dataset.variantId;
    if (!productId || !variantId) return;

    await mutateAndReload(
      button,
      actionError,
      () =>
        sendJson(
          "DELETE",
          `/api/v1/commerce/products/${productId}/variants/${variantId}`
        ),
      "Could not remove the variant. Please try again.",
      "Removing…"
    );
  });

  // Issue #291 — typed attribute forms (one per product, one per variant).
  // A blank control clears the attribute; the server validates every value
  // against its definition's type and writes nothing if one is invalid.
  onSubmitAll(".attributes-form", async ({ form, data, submit }) => {
    const productId = form.dataset.productId;
    const variantId = form.dataset.variantId;
    if (!productId) return;
    const rowError = messageBox(`attributes-error-${variantId ?? productId}`);
    const path = variantId
      ? `/api/v1/commerce/products/${productId}/variants/${variantId}/attributes`
      : `/api/v1/commerce/products/${productId}/attributes`;

    await mutateAndReload(
      submit,
      rowError,
      () => sendJson("PUT", path, { attributes: collectAttributeValues(data) }),
      form.dataset.failure ?? "",
      submit?.dataset.busy
    );
  });

  // Issue #247 — checkbox column, selection bar, and Publish/Move to
  // draft/Delete, each looping over the existing per-item endpoints above
  // (never a new bulk API). See `commerce-products-bulk-client.ts` for the
  // full contract.
  initCommerceProductsBulk();
</script>
