---
/**
 * Commerce store-settings screen (Issue #26) — a SINGLETON, `PUT`-only
 * screen (`GET/PUT /api/v1/commerce/store-settings`), unlike every other
 * screen in this module: there is nothing to list, create, or delete.
 *
 * Core identity fields (name/tagline/address/contact/logo/favicon ids) are
 * plain inputs; the long tail (FAQs, social links, customer levels,
 * shipping, payment, promo section, per-page meta) is ONE JSON textarea —
 * the same deliberate compression `commerce.astro`'s own "Advanced fields
 * (JSON)" editor uses for the product parity columns: dozens of individual
 * controls would dwarf the screen, and this keeps every field genuinely
 * editable without it. Bank account numbers/QRIS media id live inside that
 * JSON, unmasked, because this IS the owner-only `settings.read` view — see
 * `store-settings-directory.ts`'s header for why the PUBLIC read model
 * strips them instead.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import "../../styles/admin-screens.css";
import { loadAdminScreen } from "../../lib/auth/admin-screen";
import { logAdminPageError } from "../../lib/logging/error-log";
import { getTranslatorFor } from "../../lib/i18n";
import {
  fetchAffiliateCommissionRate,
  fetchStoreSettings
} from "../../modules/commerce/application/store-settings-directory";

const ssr = Astro.locals.ssrContext!;
const { t } = getTranslatorFor(Astro.locals.locale);

const screen = await loadAdminScreen({
  ssr,
  workClass: "interactive",
  authorize: {
    moduleKey: "commerce",
    activityCode: "settings",
    action: "read"
  },
  load: async ({ tx, can }) => {
    const [settings, affiliateCommissionRate] = await Promise.all([
      fetchStoreSettings(tx, ssr.tenantId),
      fetchAffiliateCommissionRate(tx, ssr.tenantId)
    ]);
    const canUpdate = await can({
      moduleKey: "commerce",
      activityCode: "settings",
      action: "update"
    });
    return { settings, affiliateCommissionRate, canUpdate };
  },
  onError: (error) => {
    logAdminPageError(
      "admin/commerce-settings.astro: failed to load store settings",
      error,
      {
        correlationId: Astro.locals.correlationId
      }
    );
  }
});

const canRead = screen.state !== "denied";
const loadError = screen.state === "error";
const settings = screen.state === "allowed" ? screen.data.settings : null;
const affiliateCommissionRate =
  screen.state === "allowed" ? screen.data.affiliateCommissionRate : null;
const canUpdate = screen.state === "allowed" && screen.data.canUpdate;

// Issue #107 — `shipping.courier` gets its own explicit section below (an
// enabled toggle, an origin-destination picker, a couriers multi-select),
// the same "pull the field out of the JSON blob" treatment
// `affiliateCommissionRate` already got. It is therefore EXCLUDED from the
// advanced JSON here so there is exactly one place to edit it, never two
// that can disagree — the submit handler re-attaches it from the dedicated
// controls before sending.
const shippingWithoutCourier = settings
  ? (() => {
      const { courier: _courier, ...rest } = settings.shipping;
      return rest;
    })()
  : null;

const advancedJson = settings
  ? JSON.stringify(
      {
        faqs: settings.faqs,
        social: settings.social,
        customerLevels: settings.customerLevels,
        shipping: shippingWithoutCourier,
        payment: settings.payment,
        promoSection: settings.promoSection,
        meta: settings.meta
      },
      null,
      2
    )
  : "{}";

const courier = settings?.shipping.courier ?? {
  enabled: false,
  originDestinationId: null,
  couriers: []
};

// Issue #107 — fixed courier list the courier settings understand
// (`domain/store-settings-validation.ts`'s `COURIER_CODE_PATTERN` accepts
// any lowercase code, but this screen only ever offers the couriers the
// RajaOngkir adapter is known to carry).
const COURIER_OPTIONS = [
  { value: "jne", label: "JNE" },
  { value: "jnt", label: "J&T Express" },
  { value: "sicepat", label: "SiCepat" },
  { value: "pos", label: "POS Indonesia" },
  { value: "tiki", label: "TIKI" },
  { value: "anteraja", label: "AnterAja" }
] as const;
---

<AdminLayout
  title={t("Store settings")}
  description={t(
    "Store identity, shipping, payment and promo configuration for this tenant."
  )}
>
  {
    !canRead && (
      <p class="state-notice fade-in-up" id="settings-denied">
        {t("You do not have permission to view store settings.")}
      </p>
    )
  }
  {
    canRead && loadError && (
      <p class="state-notice fade-in-up" id="settings-error">
        {t(
          "Store settings could not be loaded right now. Please try again later."
        )}
      </p>
    )
  }

  {
    canRead && !loadError && settings && (
      <form id="store-settings-form" class="admin-create-form fade-in-up">
        <p class="form-legend">{t("Store identity")}</p>
        <p
          id="store-settings-error"
          class="admin-create-error"
          role="alert"
          hidden
        />
        <p id="store-settings-success" class="state-notice" hidden>
          {t("Saved.")}
        </p>

        <label for="settings-storeName">{t("Store name")}</label>
        <input
          id="settings-storeName"
          type="text"
          required
          value={settings.storeName}
        />

        <label for="settings-tagline">{t("Tagline")}</label>
        <input
          id="settings-tagline"
          type="text"
          value={settings.tagline ?? ""}
        />

        <label for="settings-logoMediaObjectId">
          {t("Logo media object id")}
        </label>
        <input
          id="settings-logoMediaObjectId"
          type="text"
          value={settings.logoMediaObjectId ?? ""}
          placeholder="uuid — see /admin/media"
        />

        <label for="settings-faviconMediaObjectId">
          {t("Favicon media object id")}
        </label>
        <input
          id="settings-faviconMediaObjectId"
          type="text"
          value={settings.faviconMediaObjectId ?? ""}
          placeholder="uuid — see /admin/media"
        />

        <label for="settings-address">{t("Address")}</label>
        <textarea id="settings-address" rows="2">
          {settings.address ?? ""}
        </textarea>

        <label for="settings-phone">{t("Phone")}</label>
        <input id="settings-phone" type="text" value={settings.phone ?? ""} />

        <label for="settings-whatsapp">{t("WhatsApp")}</label>
        <input
          id="settings-whatsapp"
          type="text"
          value={settings.whatsapp ?? ""}
        />

        <label for="settings-email">{t("Email")}</label>
        <input id="settings-email" type="email" value={settings.email ?? ""} />

        <label for="settings-mapsEmbedUrl">{t("Maps embed URL")}</label>
        <input
          id="settings-mapsEmbedUrl"
          type="text"
          value={settings.mapsEmbedUrl ?? ""}
        />

        <p class="form-legend">{t("Affiliate program")}</p>
        <p class="cell-muted">
          {t(
            "Leave blank to keep the affiliate program off for this store. Set a rate (0-100, two decimals) to turn it on — new enrolments copy this rate."
          )}
        </p>
        <label for="settings-affiliateCommissionRate">
          {t("Affiliate commission rate (%)")}
        </label>
        <input
          id="settings-affiliateCommissionRate"
          type="text"
          inputmode="decimal"
          placeholder="e.g. 10.00"
          value={affiliateCommissionRate ?? ""}
        />

        <p class="form-legend">{t("Courier rates (RajaOngkir)")}</p>
        <p class="cell-muted">
          {t(
            "Turn on live courier rates for checkout. Requires a courier rate provider configured for this deployment (see the deployment guide) — otherwise shoppers still see a disabled courier option."
          )}
        </p>

        <label>
          <input id="cr-enabled" type="checkbox" checked={courier.enabled} />{" "}
          {t("Enable courier rates")}
        </label>

        <label for="cr-search">
          {t("Store origin (search by city or subdistrict)")}
        </label>
        <input
          id="cr-search"
          type="text"
          list="cr-datalist"
          placeholder="e.g. Sukajadi Bandung"
          autocomplete="off"
          value={courier.originDestinationId ?? ""}
        />
        <datalist id="cr-datalist" />
        <p class="cell-muted">
          {t("Type to search, then pick a suggestion to fill in its id.")}
        </p>

        <label for="cr-couriers">{t("Couriers to quote")}</label>
        <select id="cr-couriers" multiple size={6}>
          {COURIER_OPTIONS.map((option) => (
            <option
              value={option.value}
              selected={courier.couriers.includes(option.value)}
            >
              {option.label}
            </option>
          ))}
        </select>
        <p class="cell-muted">
          {t("Hold Ctrl/Cmd (or Shift) to select more than one courier.")}
        </p>

        <p class="form-legend">{t("Advanced settings (JSON)")}</p>
        <p class="cell-muted">
          {t(
            "FAQs, social links, customer levels, shipping (except courier rates, above), payment (including bank accounts — never shown publicly), promo section, and per-page meta titles."
          )}
        </p>
        <label for="settings-advanced" class="sr-only">
          {t("Advanced settings JSON")}
        </label>
        <textarea id="settings-advanced" rows="20" spellcheck="false">
          {advancedJson}
        </textarea>

        {canUpdate && (
          <button type="submit" id="store-settings-submit">
            {t("Save store settings")}
          </button>
        )}
      </form>
    )
  }
</AdminLayout>

<script>
  import { messageBox, sendJson } from "../../lib/ui/admin-form-client";

  const el = (id: string) => document.getElementById(id);
  const val = (id: string) =>
    (el(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() ??
    "";
  const orNull = (input: string) => (input === "" ? null : input);

  const form = el("store-settings-form");
  const errorBox = messageBox("store-settings-error");
  const successBox = messageBox("store-settings-success");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    errorBox.clear();
    successBox.clear();

    const submit = el("store-settings-submit") as HTMLButtonElement | null;

    let advanced: Record<string, unknown>;
    try {
      advanced = JSON.parse(val("settings-advanced") || "{}");
    } catch {
      errorBox.show("Advanced settings must be valid JSON.");
      return;
    }

    // Issue #107 — re-attach `shipping.courier` from the dedicated controls
    // (excluded from the advanced JSON, see the frontmatter's own comment).
    // Both controls render whenever this form does, same as every other
    // field here, so they are asserted rather than re-guarded.
    advanced.shipping = {
      ...(advanced.shipping as Record<string, unknown> | undefined),
      courier: {
        enabled: (el("cr-enabled") as HTMLInputElement).checked,
        originDestinationId: orNull(val("cr-search")),
        couriers: [
          ...(el("cr-couriers") as HTMLSelectElement).selectedOptions
        ].map((option) => option.value)
      }
    };

    if (submit) {
      submit.disabled = true;
      submit.textContent = "Saving…";
    }

    const result = await sendJson("PUT", "/api/v1/commerce/store-settings", {
      storeName: val("settings-storeName"),
      tagline: orNull(val("settings-tagline")),
      logoMediaObjectId: orNull(val("settings-logoMediaObjectId")),
      faviconMediaObjectId: orNull(val("settings-faviconMediaObjectId")),
      address: orNull(val("settings-address")),
      phone: orNull(val("settings-phone")),
      whatsapp: orNull(val("settings-whatsapp")),
      email: orNull(val("settings-email")),
      mapsEmbedUrl: orNull(val("settings-mapsEmbedUrl")),
      affiliateCommissionRate: orNull(val("settings-affiliateCommissionRate")),
      ...advanced
    });

    if (result.ok) {
      successBox.show("Saved.");
    } else {
      errorBox.show(
        "Could not save store settings. Check the advanced JSON shape and try again."
      );
    }

    if (submit) {
      submit.disabled = false;
      submit.textContent = "Save store settings";
    }
  });

  // Issue #107 — debounced search against the owner-only
  // `GET /api/v1/commerce/shipping/destinations?search=`, offered through a
  // native `<datalist>` (no custom list markup/selection JS to ship): each
  // fetch fills the datalist with one `<option value=id>` per candidate
  // (`textContent` is the visible suggestion text, `value` is what the
  // browser fills THIS SAME field with on pick — the search box doubles as
  // the id field, pre-filled with the currently configured id, so there is
  // no second mirrored control to keep in sync). Provider-supplied text
  // only ever goes through `textContent`, never `innerHTML`. `fetch`
  // defaults to same-origin credentials already, so this never sets that
  // option explicitly. `cr-datalist` renders alongside `cr-search` (same
  // permission gate as every other field on this form), so it is asserted
  // rather than re-guarded.
  const search = el("cr-search") as HTMLInputElement | null;
  const dl = el("cr-datalist") as HTMLDataListElement;
  let timer: ReturnType<typeof setTimeout> | undefined;

  search?.addEventListener("input", () => {
    clearTimeout(timer);
    const query = search.value.trim();
    if (query.length < 2) return;

    timer = setTimeout(async () => {
      const response = await fetch(
        `/api/v1/commerce/shipping/destinations?search=${encodeURIComponent(query)}`
      );
      const payload = response.ok ? await response.json() : null;
      // A failure carries no `data` key at all (the shared error envelope),
      // so this is already `[]` on failure — no separate `success` check.
      const items = (payload?.data?.items ?? []) as {
        id: string;
        label: string;
      }[];

      dl.innerHTML = "";
      for (const item of items) {
        const option = document.createElement("option");
        option.value = item.id;
        option.textContent = item.label;
        dl.appendChild(option);
      }
    }, 300);
  });
</script>
