---
/**
 * POS — counter sales (Issue #116, epic #33 C7, contract #106 D6). A cashier
 * searches the existing product catalog, builds a cart, takes cash/QRIS
 * payment, and submits — the order is created ALREADY `paid` (see
 * `application/pos-directory.ts`'s `createPosOrder` header). The history
 * tab (`?tab=history`) is an SSR table over the same `listPosOrders` the
 * API route serves, filtered `channel = pos`, with date/cashier filters and
 * keyset "next page" links.
 *
 * ## Split tender and due balances (Issue #285, ADR-0025)
 *
 * The payment panel takes ONE OR MORE tender lines (cash, QRIS, bank
 * transfer) and posts the explicit `tenders[]` contract. Non-cash lines are
 * amounts applied to the sale; the (single) cash line is what the customer
 * handed over — the live summary below the lines (and the server, which is
 * authoritative) computes change from the cash line only, after the non-cash
 * lines are subtracted. The "leave the balance due" checkbox appears only for
 * a cashier holding `commerce.pos_due.create` (a SECOND permission, checked
 * by the endpoint as well); it also needs a customer phone. The receipt
 * prints every tender and any balance still due.
 *
 * Entry is any-of `commerce.pos.create` (the sale panel) / `commerce.orders
 * .read` (the history tab) — a staff member holding only the read
 * permission sees the history and never the sale form, and the endpoints
 * behind both still decide for themselves. Both panels are hidden behind the
 * tenant's `pos` feature flag (#118): with POS off the page renders one
 * notice pointing at the settings screen, matching the routes' own
 * `409 FEATURE_DISABLED`.
 *
 * ## Register sessions (Issue #284, ADR-0028)
 *
 * When the tenant's `register` feature is on, a banner above the sale form
 * says which register session the cashier is selling on (their own OPEN
 * sessions only - the same list the endpoint's gate accepts) and the sale
 * posts that `registerId`; with no open session the banner says so and links
 * to `/admin/commerce-registers` (the screen that opens one - it is gated on
 * its own permissions, so a cashier is never shown register data they could
 * not otherwise read). With the feature off the banner does not render and
 * the screen is exactly what it was.
 *
 * The cart/search interaction is the ONE client island this screen ships —
 * a plain array closed over by the bundled `<script>`, rows built from
 * `<template>`s via `textContent` (never `innerHTML` with catalog data), the
 * SAME `sendJsonForData`/`messageBox`/`lockElement` idiom every other admin
 * form uses (skill `awcms-ui-screen` §6: the import is what makes the script
 * an external, CSP-permitted bundle). Every string the script shows is
 * rendered by `t()` into a `data-*` attribute on `#pos-sale` and read from
 * there, so the client half is translated like the SSR half. Money stays a
 * `numeric(14,2)` STRING end to end; the on-screen change preview does its
 * arithmetic in `bigint` cents exactly like `domain/pos-order-validation.ts`
 * (ADR-0003), and the server's own `change` is what the receipt prints.
 *
 * The receipt is printable — `@media print` below hides everything but
 * `#pos-receipt` (a plain 58 mm-ish receipt shape: no images, tabular
 * figures, `page-break-inside: avoid`).
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import "../../styles/admin-screens.css";
import { loadAdminScreen } from "../../lib/auth/admin-screen";
import { logAdminPageError } from "../../lib/logging/error-log";
import { getTranslatorFor } from "../../lib/i18n";
import {
  commerceLabel,
  createCommerceLabels
} from "../../lib/ui/commerce-admin-labels";
import { decodeKeysetCursor } from "../../modules/_shared/keyset-pagination";
import { fetchCommerceFeatures } from "../../modules/commerce/application/commerce-feature-gate";
import {
  listRegisterSessions,
  type RegisterSessionRecord
} from "../../modules/commerce/application/register-session-directory";
import {
  listPosOrders,
  type PosOrderListPage
} from "../../modules/commerce/application/pos-directory";
import {
  listHeldSales,
  type HeldSaleRecord
} from "../../modules/commerce/application/held-sale-directory";
import { POS_WALK_IN_CUSTOMER_NAME } from "../../modules/commerce/domain/pos-order-validation";
import { fetchTenantShortcutOverrides } from "../../modules/commerce/application/barcode-http";
import {
  DEFAULT_POS_SHORTCUTS,
  POS_SHORTCUT_ACTIONS,
  type PosShortcutAction
} from "../../modules/commerce/domain/pos-shortcuts";

const ssr = Astro.locals.ssrContext!;
const { t, tn } = getTranslatorFor(Astro.locals.locale);
const labels = createCommerceLabels(t);

const tab =
  Astro.url.searchParams.get("tab") === "history" ? "history" : "sale";
const dateFromParam = Astro.url.searchParams.get("dateFrom") ?? "";
const dateToParam = Astro.url.searchParams.get("dateTo") ?? "";
const cashierParam = Astro.url.searchParams.get("cashier") ?? "";
const cursorParam = Astro.url.searchParams.get("cursor");

const DAY_PATTERN = /^\d{4}-\d{2}-\d{2}$/;
const UUID_PATTERN =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const dateFrom = DAY_PATTERN.test(dateFromParam)
  ? new Date(`${dateFromParam}T00:00:00.000Z`)
  : undefined;
const dateTo = DAY_PATTERN.test(dateToParam)
  ? new Date(`${dateToParam}T23:59:59.999Z`)
  : undefined;
const cashierFilter = UUID_PATTERN.test(cashierParam)
  ? cashierParam
  : undefined;
const cursor = cursorParam ? decodeKeysetCursor(cursorParam) : null;

const SALE_ENTRY = {
  moduleKey: "commerce",
  activityCode: "pos",
  action: "create"
} as const;
const HISTORY_ENTRY = {
  moduleKey: "commerce",
  activityCode: "orders",
  action: "read"
} as const;
/** Issue #285 — finalizing a sale with a balance due (credit); a SECOND permission beyond `commerce.pos.create`. */
const DUE_ENTRY = {
  moduleKey: "commerce",
  activityCode: "pos_due",
  action: "create"
} as const;

const screen = await loadAdminScreen({
  ssr,
  workClass: "interactive",
  authorize: [SALE_ENTRY, HISTORY_ENTRY, DUE_ENTRY],
  load: async ({ tx, entry, can }) => {
    const features = await fetchCommerceFeatures(tx, ssr.tenantId);
    const canSell = entry[0] === true;
    const canReadHistory = entry[1] === true;
    const canSellOnCredit = entry[2] === true;
    const history: PosOrderListPage | null =
      features.pos && canReadHistory && tab === "history"
        ? await listPosOrders(tx, ssr.tenantId, cursor, {
            dateFrom,
            dateTo,
            cashierTenantUserId: cashierFilter
          })
        : null;
    // Issue #284 - the cashier's OWN open register sessions (never another
    // cashier's), only while the register feature is on and the sale form shows.
    const registerSessions: RegisterSessionRecord[] =
      features.pos && features.register && canSell && tab === "sale"
        ? (
            await listRegisterSessions(tx, ssr.tenantId, null, {
              status: "open",
              cashierTenantUserId: ssr.tenantUserId
            })
          ).items
        : [];
    // Issue #286 (ADR-0029) - the cashier's OWN parked carts, only while the
    // `documents` feature is on; resuming/holding need their own keys.
    const heldAvailable =
      features.pos && features.documents && canSell && tab === "sale";
    const canHold =
      heldAvailable &&
      (await can({
        moduleKey: "commerce",
        activityCode: "held_sales",
        action: "create"
      }));
    const canResumeHeld =
      heldAvailable &&
      (await can({
        moduleKey: "commerce",
        activityCode: "held_sales",
        action: "update"
      }));
    const heldSales: HeldSaleRecord[] = canResumeHeld
      ? (
          await listHeldSales(
            tx,
            ssr.tenantId,
            { actorTenantUserId: ssr.tenantUserId, all: false },
            null,
            "held"
          )
        ).items
      : [];
    // Issue #292 (ADR-0032) - scanner input and the shortcut layer, only while
    // the `barcode` feature is on and the sale form shows. The scan field
    // needs its own key (`commerce.barcodes.read`); the shortcuts do not.
    const barcodeAvailable =
      features.pos && features.barcode && canSell && tab === "sale";
    const canLookup =
      barcodeAvailable &&
      (await can({
        moduleKey: "commerce",
        activityCode: "barcodes",
        action: "read"
      }));
    const tenantShortcuts = barcodeAvailable
      ? await fetchTenantShortcutOverrides(tx, ssr.tenantId)
      : {};
    return {
      barcodeAvailable,
      canLookup,
      tenantShortcuts,
      posEnabled: features.pos,
      registerEnabled: features.register,
      storedValueEnabled: features.storedValue,
      registerSessions,
      canHold,
      canResumeHeld,
      heldSales,
      canSell,
      canReadHistory,
      canSellOnCredit,
      history
    };
  },
  onError: (error) => {
    logAdminPageError("admin/commerce-pos.astro: failed to load", error, {
      correlationId: Astro.locals.correlationId
    });
  }
});

const allowed = screen.state === "allowed";
const denied = screen.state === "denied";
const loadError = screen.state === "error";
const posEnabled = allowed && screen.data.posEnabled;
const registerEnabled = allowed && screen.data.registerEnabled;
// Issue #288 - gift card / store credit tenders appear only while the tenant's
// `storedValue` feature is on (the server refuses them otherwise).
const storedValueEnabled = allowed && screen.data.storedValueEnabled;
const registerSessions = allowed ? screen.data.registerSessions : [];
const canSell = allowed && screen.data.canSell;
const canReadHistory = allowed && screen.data.canReadHistory;
// The checkbox is only a convenience: the endpoint re-checks `pos_due.create`.
const canSellOnCredit = allowed && screen.data.canSellOnCredit && canSell;
const history = allowed ? screen.data.history : null;
const canHold = allowed && screen.data.canHold;
const canResumeHeld = allowed && screen.data.canResumeHeld;
const heldSales = allowed ? screen.data.heldSales : [];
const barcodeAvailable = allowed && screen.data.barcodeAvailable;
const canLookup = allowed && screen.data.canLookup;
const tenantShortcuts = allowed ? screen.data.tenantShortcuts : {};
/** Human label per shortcut action (Issue #292). */
const SHORTCUT_LABELS: Record<PosShortcutAction, string> = {
  focusScan: t("Focus the scan field"),
  focusSearch: t("Focus product search"),
  editQuantity: t("Edit the quantity of a cart line"),
  removeLine: t("Remove a cart line"),
  focusCustomer: t("Go to the customer field"),
  focusPayment: t("Go to the payment lines"),
  hold: t("Hold the sale"),
  resume: t("Resume a held sale"),
  finalize: t("Finalize the sale"),
  printReceipt: t("Print the receipt"),
  newSale: t("Start a new sale"),
  showHelp: t("Show keyboard shortcuts")
};
const cashierTenantUserId = ssr.tenantUserId;
const storeName = ssr.display.tenantName?.trim() || "";

function historyHref(next: { cursor?: string | null } = {}): string {
  const params = new URLSearchParams({ tab: "history" });
  if (dateFromParam) params.set("dateFrom", dateFromParam);
  if (dateToParam) params.set("dateTo", dateToParam);
  if (cashierParam) params.set("cashier", cashierParam);
  if (next.cursor) params.set("cursor", next.cursor);
  return `/admin/commerce-pos?${params.toString()}`;
}

/** `orders.payment_method` is a legacy summary hint (the tender with the largest applied amount); it maps onto the tender labels. */
const METHOD_TO_TENDER: Record<string, string> = {
  cash: "cash",
  manual_qris: "manual_qris",
  manual_bank: "manual_bank_transfer",
  gateway: "gateway"
};
const tenderLabel = (method: string): string =>
  commerceLabel(labels.paymentTenderType, METHOD_TO_TENDER[method] ?? method);
---

<AdminLayout
  title={t("Point of Sale")}
  description={t(
    "Ring up a counter sale — cash, QRIS or bank transfer, in one or more payments — and browse past POS sales."
  )}
>
  {denied && (
    <p class="state-notice fade-in-up" id="pos-denied" role="status">
      {t("You do not have permission to use the POS screen.")}
    </p>
  )}
  {loadError && (
    <p class="state-notice fade-in-up" id="pos-error" role="alert">
      {t(
        "The POS screen could not be loaded right now. Please try again later."
      )}
    </p>
  )}
  {allowed && !posEnabled && (
    <p class="state-notice fade-in-up" id="pos-feature-disabled" role="status">
      {t("Point of sale is turned off for this store.")}{" "}
      <a class="quick-link" href="/admin/commerce-settings">
        {t("Turn it on under Features in the store settings.")}
      </a>
    </p>
  )}

  {allowed && posEnabled && (
    <nav class="row-actions fade-in-up" aria-label={t("POS sections")}>
      {canSell && (
        <a
          href="/admin/commerce-pos"
          class={tab === "sale" ? "module-toggle" : ""}
          aria-current={tab === "sale" ? "page" : undefined}
        >
          {t("New sale")}
        </a>
      )}
      {canReadHistory && (
        <a
          href={historyHref()}
          class={tab === "history" ? "module-toggle" : ""}
          aria-current={tab === "history" ? "page" : undefined}
        >
          {t("History")}
        </a>
      )}
    </nav>
  )}

  {allowed && posEnabled && tab === "sale" && !canSell && (
    <p class="state-notice fade-in-up" id="pos-sale-denied" role="status">
      {t(
        "You can browse POS history but do not have permission to ring up a sale."
      )}
    </p>
  )}

  {allowed && posEnabled && tab === "sale" && canSell && (
    <section
      class="fade-in-up pos-sale"
      id="pos-sale"
      aria-labelledby="pos-sale-heading"
      data-walk-in-name={POS_WALK_IN_CUSTOMER_NAME}
      data-msg-hold-failed={t("Could not hold the sale. Please try again.")}
      data-msg-resume-failed={t(
        "Could not resume the held sale. Please try again."
      )}
      data-msg-held-expired={t("That held sale has expired.")}
      data-msg-held-gone={t("That held sale was already resumed or discarded.")}
      data-msg-held-limit={t(
        "Too many parked sales; resume or discard some first."
      )}
      data-register-mode={registerEnabled ? "true" : "false"}
      data-barcode-mode={barcodeAvailable ? "true" : "false"}
      data-tenant-shortcuts={JSON.stringify(tenantShortcuts)}
      data-msg-scan-failed={t(
        "Could not look up that barcode. Please try again."
      )}
      data-msg-scan-unknown={t("No product has the barcode {code}.")}
      data-msg-scan-invalid={t(
        "That is not a valid barcode. Use a code, or a quantity and a code like 3*CODE."
      )}
      data-msg-scan-requires-variant={t(
        "{name} has variants; search for it and pick one."
      )}
      data-msg-scan-out-of-stock={t("{name} is out of stock.")}
      data-msg-scan-not-for-sale={t("{name} is not for sale.")}
      data-msg-scan-stock={t("Only {stock} of {name} in stock.")}
      data-msg-scan-added={t("Added {quantity} x {name}.")}
      data-msg-line-removed={t("Removed {name}.")}
      data-label-rebind={t("Change")}
      data-label-press-keys={t("Press keys…")}
      data-msg-press-keys={t(
        "Press the new key combination, or Escape to cancel."
      )}
      data-msg-record-cancelled={t("Cancelled. The shortcut is unchanged.")}
      data-msg-combo-bare={t(
        "A shortcut must include a modifier key such as Alt+Shift, or be a function key."
      )}
      data-msg-combo-reserved={t(
        "That combination is reserved by the browser or your assistive technology. Try another."
      )}
      data-msg-combo-conflict={t(
        "That combination is already used for: {action}."
      )}
      data-msg-combo-saved={t("Shortcut saved on this device.")}
      data-msg-shortcuts-reset={t("Shortcuts reset to the store defaults.")}
      data-msg-register-required={t("Choose the register you are selling on.")}
      data-msg-register-session-required={t(
        "This register has no open session. Open one on the Registers screen first."
      )}
      data-msg-register-session-closing={t(
        "This register's session is being closed and accepts no sales."
      )}
      data-msg-not-session-cashier={t(
        "This register's session belongs to another cashier. Ask for a handover."
      )}
      data-msg-register-not-found={t("That register no longer exists.")}
      data-msg-empty-cart={t("Add at least one product to the cart.")}
      data-msg-cart-changed={t(
        "One or more items changed price or stock. Search for them again and retry."
      )}
      data-msg-insufficient={t(
        "The payments entered do not cover the total. Add a payment or leave the balance due."
      )}
      data-msg-overpayment={t(
        "The non-cash payments are more than the total. Only a cash payment may exceed it, as change."
      )}
      data-msg-two-cash={t("Only one cash line is allowed per sale.")}
      data-msg-bad-amount={t(
        "Every payment line needs an amount greater than zero, like 25000 or 25000.50."
      )}
      data-msg-due-phone={t(
        "A sale left with a balance due needs a customer phone number."
      )}
      data-msg-due-denied={t(
        "You do not have permission to leave a balance due."
      )}
      data-msg-no-tender={t(
        "Add at least one payment line, or leave the balance due."
      )}
      data-msg-code-required={t(
        "Enter the gift card or credit code for that payment line."
      )}
      data-msg-sv-not-found={t(
        "That gift card or credit code was not recognised."
      )}
      data-msg-sv-unavailable={t(
        "That gift card or credit is disabled or has expired."
      )}
      data-msg-sv-insufficient={t(
        "That gift card or credit does not have enough balance for the amount entered."
      )}
      data-msg-sv-throttled={t(
        "Too many code lookups. Wait a moment and try again."
      )}
      data-msg-feature-disabled={t(
        "Point of sale is turned off for this store."
      )}
      data-msg-invalid-phone={t("The customer phone number is not valid.")}
      data-msg-generic={t("Could not complete the sale. Please try again.")}
      data-msg-search-failed={t("Product search failed. Please try again.")}
      data-msg-no-results={t("No products match.")}
      data-msg-out-of-stock={t("out of stock")}
      data-msg-cart-empty-row={t("Cart is empty.")}
      data-label-remove={t("Remove")}
      data-label-cash={t("Cash")}
      data-label-qris={t("QRIS")}
      data-label-bank={t("Bank transfer")}
      data-label-gift-card={t("Gift card")}
      data-label-store-credit={t("Store credit")}
      data-label-code={t("Gift card or credit code")}
      data-label-tender={t("Payment line")}
      data-label-amount={t("Amount")}
      data-label-amount-cash={t("Amount handed over")}
      data-label-reference={t("Reference (optional)")}
      data-label-method={t("Payment method")}
      data-label-balance-due={t("Balance due")}
      data-label-tendered={t("Amount tendered")}
      data-label-change={t("Change")}
      data-label-walk-in={t("Walk-in customer")}
      data-busy-label={t("Completing…")}
    >
      <h2 id="pos-sale-heading">{t("New sale")}</h2>

      <p id="pos-sale-error" class="admin-create-error" role="alert" hidden />

      {registerEnabled && (
        <section
          class="admin-panel pos-register"
          id="pos-register-banner"
          aria-labelledby="pos-register-heading"
          data-session-count={registerSessions.length}
        >
          <h3 id="pos-register-heading">{t("Cash register")}</h3>
          {registerSessions.length === 0 ? (
            <p id="pos-register-none" role="status">
              <span class="admin-status-pill" data-tone="warning">
                <span class="admin-status-pill-dot" aria-hidden="true" />
                {t("No open session")}
              </span>{" "}
              {t(
                "Register mode is on: open a register session before ringing up a sale."
              )}{" "}
              <a class="quick-link" href="/admin/commerce-registers">
                {t("Open a register session")}
              </a>
            </p>
          ) : (
            <div id="pos-register-open">
              <p role="status">
                <span class="admin-status-pill" data-tone="success">
                  <span class="admin-status-pill-dot" aria-hidden="true" />
                  {t("Session open")}
                </span>{" "}
                {registerSessions.length === 1
                  ? t("Selling on {register}.", {
                      register: `${registerSessions[0]!.registerCode} · ${registerSessions[0]!.registerName}`
                    })
                  : t("You have several open register sessions.")}
              </p>
              {registerSessions.length === 1 ? (
                <input
                  type="hidden"
                  id="pos-register"
                  value={registerSessions[0]!.registerId}
                />
              ) : (
                <label for="pos-register">
                  {t("Sell on register")}
                  <select id="pos-register">
                    {registerSessions.map((session) => (
                      <option value={session.registerId}>
                        {session.registerCode} · {session.registerName}
                      </option>
                    ))}
                  </select>
                </label>
              )}
              <p class="form-hint">
                {registerSessions.map((session, index) => (
                  <>
                    {index > 0 ? " · " : ""}
                    <a
                      class="quick-link"
                      href={`/admin/commerce-registers/${session.id}`}
                    >
                      {t("Drawer and cash-up")}
                      {registerSessions.length > 1
                        ? ` (${session.registerCode})`
                        : ""}
                    </a>
                  </>
                ))}
              </p>
            </div>
          )}
        </section>
      )}

      <div class="pos-layout">
        <div class="admin-panel pos-panel">
          {barcodeAvailable && (
            <div class="admin-form pos-scan">
              {canLookup && (
                <>
                  <label for="pos-scan-input">
                    {t("Scan a barcode")}
                    <input
                      type="text"
                      id="pos-scan-input"
                      autocomplete="off"
                      autocapitalize="off"
                      spellcheck="false"
                      maxlength="60"
                      aria-describedby="pos-scan-hint pos-scan-status pos-scan-error"
                    />
                  </label>
                  <p class="form-hint" id="pos-scan-hint">
                    {t(
                      "Scan, or type a code and press Enter. Use 3*CODE to add three."
                    )}
                  </p>
                </>
              )}
              <p
                class="form-hint"
                id="pos-scan-status"
                role="status"
                aria-live="polite"
              />
              <p
                class="admin-create-error"
                id="pos-scan-error"
                role="alert"
                hidden
              />
              <button type="button" class="btn-inline" id="pos-shortcuts-open">
                {t("Keyboard shortcuts")}
              </button>
            </div>
          )}
          <div class="admin-form">
            <label for="pos-search-input">
              {t("Product search")}
              <input
                type="search"
                id="pos-search-input"
                placeholder={t("Search by name or SKU…")}
                autocomplete="off"
                aria-controls="pos-search-results"
              />
            </label>
            <p class="form-hint">
              {t(
                "Type at least two characters. Pick a product to add one unit; products with variants list each variant."
              )}
            </p>
          </div>
          <ul
            id="pos-search-results"
            class="pos-search-results"
            aria-live="polite"
            aria-label={t("Search results")}
          />

          <div class="data-table-scroll">
            <table class="data-table" id="pos-cart-table">
              <caption>{t("Cart")}</caption>
              <thead>
                <tr>
                  <th scope="col">{t("Product")}</th>
                  <th scope="col">{t("Unit price")}</th>
                  <th scope="col">{t("Quantity")}</th>
                  <th scope="col">{t("Line total")}</th>
                  <th scope="col">
                    <span class="visually-hidden">{t("Actions")}</span>
                  </th>
                </tr>
              </thead>
              <tbody id="pos-cart-body">
                <tr id="pos-cart-empty-row">
                  <td class="data-table-empty" colspan="5">
                    {t("Cart is empty.")}
                  </td>
                </tr>
              </tbody>
              <tfoot>
                <tr>
                  <th scope="row" colspan="3">
                    {t("Subtotal")}
                  </th>
                  <td class="pos-money" id="pos-cart-subtotal" colspan="2">
                    0.00
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
          <p class="form-hint">
            {t(
              "The server re-prices every line when the sale is completed; tax from the store settings is added to the total there."
            )}
          </p>
        </div>

        <form class="admin-panel pos-panel admin-form" id="pos-checkout-form">
          <fieldset>
            <legend>{t("Customer (optional)")}</legend>
            <label for="pos-customer-name">
              {t("Name")}
              <input
                type="text"
                id="pos-customer-name"
                name="name"
                maxlength="200"
                placeholder={t("Walk-in customer")}
                autocomplete="off"
              />
            </label>
            <label for="pos-customer-phone">
              {t("Phone")}
              <input
                type="tel"
                id="pos-customer-phone"
                name="phone"
                maxlength="30"
                placeholder="08…"
                autocomplete="off"
              />
