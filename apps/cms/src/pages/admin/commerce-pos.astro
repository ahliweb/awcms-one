<script>
  import {
    lockElement,
    messageBox,
    sendJsonForData
  } from "../../lib/ui/admin-form-client";
  import { initPosKeyboard } from "../../lib/ui/pos-keyboard-client";

  type CartLine = {
    productId: string;
    variantId: string | null;
    name: string;
    price: string;
    stock: number;
    quantity: number;
  };

  type ProductVariant = {
    id: string;
    name: string;
    value: string;
    sku: string | null;
    price: string | null;
    stock: number;
  };
  type ProductHit = {
    id: string;
    name: string;
    sku: string;
    finalPrice: string;
    stock: number;
    status: string;
    variants: ProductVariant[];
  };

  type PosPayment = {
    kind: "payment" | "reversal";
    status: string;
    tenderType: string;
    amount: string;
    tenderedAmount: string | null;
    changeAmount: string | null;
    /** Issue #288 - the MASKED code of the gift card / credit a leg drew from; the plaintext is never stored or returned. */
    storedValue?: { maskedCode: string } | null;
  };

  type PosOrderResponse = {
    orderCode: string;
    createdAt: string;
    paymentMethod: string;
    subtotal: string;
    tax: string;
    total: string;
    change: string | null;
    amountTendered: string | null;
    settlement: { outstanding: string };
    payments?: PosPayment[];
    customer: { name: string; phone: string };
    lines: {
      name: string;
      variantName: string | null;
      quantity: number;
      lineTotal: string;
    }[];
  };

  const root = document.getElementById("pos-sale");
  const msg = (key: string): string => root?.dataset[key] ?? "";

  // ADR-0003 — `numeric(14,2)` strings in, `bigint` cents inside, strings
  // out. Mirrors `domain/price-calculation.ts`'s `toCents`/`fromCents`.
  const MONEY = /^\d{1,12}(\.\d{1,2})?$/;
  function toCents(value: string): bigint {
    const [whole, fraction = ""] = value.split(".");
    return BigInt(whole || "0") * 100n + BigInt((fraction + "00").slice(0, 2));
  }
  function fromCents(cents: bigint): string {
    const negative = cents < 0n;
    const abs = negative ? -cents : cents;
    return `${negative ? "-" : ""}${abs / 100n}.${(abs % 100n).toString().padStart(2, "0")}`;
  }

  const cart: CartLine[] = [];
  const el = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T | null;
  const saleError = messageBox("pos-sale-error");
  const cartBody = el<HTMLTableSectionElement>("pos-cart-body");
  const subtotalEl = el<HTMLElement>("pos-cart-subtotal");
  const changeEl = el<HTMLElement>("pos-change");
  const tendersEl = el<HTMLElement>("pos-tenders");
  const tenderRowTemplate = el<HTMLTemplateElement>("pos-tender-row-template");
  const sumTotalEl = el<HTMLElement>("pos-sum-total");
  const sumAppliedEl = el<HTMLElement>("pos-sum-applied");
  const sumDueEl = el<HTMLElement>("pos-sum-due");
  const allowDueInput = el<HTMLInputElement>("pos-allow-due");
  const registerEl = el<HTMLInputElement | HTMLSelectElement>("pos-register");
  const registerMode = root?.dataset.registerMode === "true";
  const searchInput = el<HTMLInputElement>("pos-search-input");
  const searchResults = el<HTMLUListElement>("pos-search-results");
  const resultTemplate = el<HTMLTemplateElement>("pos-result-template");
  const cartRowTemplate = el<HTMLTemplateElement>("pos-cart-row-template");
  const checkoutForm = el<HTMLFormElement>("pos-checkout-form");
  const receiptWrapper = el<HTMLElement>("pos-receipt-wrapper");

  function cartSubtotalCents(): bigint {
    return cart.reduce(
      (sum, line) => sum + toCents(line.price) * BigInt(line.quantity),
      0n
    );
  }

  function setField(scope: ParentNode, name: string, text: string): void {
    const node = scope.querySelector<HTMLElement>(`[data-field="${name}"]`);
    if (node) node.textContent = text;
  }

  function renderCart(): void {
    if (!cartBody || !subtotalEl || !cartRowTemplate) return;
    cartBody.textContent = "";

    if (cart.length === 0) {
      const row = document.createElement("tr");
      row.id = "pos-cart-empty-row";
      const cell = document.createElement("td");
      cell.className = "data-table-empty";
      cell.colSpan = 5;
      cell.textContent = msg("msgCartEmptyRow");
      row.appendChild(cell);
      cartBody.appendChild(row);
    }

    cart.forEach((line, index) => {
      const fragment = cartRowTemplate.content.cloneNode(
        true
      ) as DocumentFragment;
      const row = fragment.querySelector("tr");
      if (!row) return;
      setField(row, "name", line.name);
      setField(row, "price", line.price);
      setField(
        row,
        "lineTotal",
        fromCents(toCents(line.price) * BigInt(line.quantity))
      );
      const qty = row.querySelector<HTMLInputElement>(".pos-qty-input");
      if (qty) {
        qty.value = String(line.quantity);
        qty.max = String(Math.max(1, Math.min(10000, line.stock)));
        qty.setAttribute("aria-label", line.name);
        qty.addEventListener("change", () => {
          const next = Math.trunc(Number(qty.value));
          cart[index]!.quantity =
            Number.isFinite(next) && next >= 1 ? Math.min(next, 10000) : 1;
          renderCart();
        });
      }
      const remove = row.querySelector<HTMLButtonElement>(".pos-remove-btn");
      if (remove) {
        remove.textContent = msg("labelRemove");
        remove.setAttribute(
          "aria-label",
          `${msg("labelRemove")}: ${line.name}`
        );
        remove.addEventListener("click", () => {
          cart.splice(index, 1);
          renderCart();
        });
      }
      cartBody.appendChild(fragment);
    });

    subtotalEl.textContent = fromCents(cartSubtotalCents());
    recomputeSummary();
  }

  // ---- tender lines (Issue #285) ----------------------------------------
  type TenderLine = {
    row: HTMLElement;
    type: HTMLSelectElement;
    amount: HTMLInputElement;
    reference: HTMLInputElement;
    referenceWrap: HTMLElement;
    code: HTMLInputElement;
    codeWrap: HTMLElement;
    remove: HTMLButtonElement;
    amountLabel: HTMLElement;
  };

  /** Issue #288 - a gift card / store credit line names its account by code. */
  const isStoredValue = (type: string): boolean =>
    type === "gift_card" || type === "store_credit";
  const tenderLines: TenderLine[] = [];

  function tenderLine(row: HTMLElement): TenderLine {
    const q = <T extends HTMLElement>(name: string) =>
      row.querySelector(`[data-field="${name}"]`) as T;
    return {
      row,
      type: q<HTMLSelectElement>("type"),
      amount: q<HTMLInputElement>("amount"),
      reference: q<HTMLInputElement>("reference"),
      referenceWrap: q<HTMLElement>("reference-wrap"),
      code: q<HTMLInputElement>("code"),
      codeWrap: q<HTMLElement>("code-wrap"),
      remove: q<HTMLButtonElement>("remove"),
      amountLabel: q<HTMLElement>("amount-label")
    };
  }

  /** Re-labels every line (ordinal, cash vs non-cash amount wording, reference only for non-cash) and re-runs the summary. */
  function syncTenderLines(): void {
    tenderLines.forEach((line, index) => {
      const cash = line.type.value === "cash";
      line.row.setAttribute("aria-label", `${msg("labelTender")} ${index + 1}`);
      line.amountLabel.textContent = cash
        ? msg("labelAmountCash")
        : msg("labelAmount");
      const stored = isStoredValue(line.type.value);
      line.referenceWrap.hidden = cash || stored;
      line.codeWrap.hidden = !stored;
      if (!stored) line.code.value = "";
      line.remove.textContent = msg("labelRemove");
      line.remove.setAttribute(
        "aria-label",
        `${msg("labelRemove")}: ${msg("labelTender")} ${index + 1}`
      );
      line.remove.hidden = tenderLines.length <= 1 && !allowDueInput?.checked;
    });
    recomputeSummary();
  }

  function addTenderLine(type: string, focus: boolean): void {
    if (!tendersEl || !tenderRowTemplate) return;
    const fragment = tenderRowTemplate.content.cloneNode(
      true
    ) as DocumentFragment;
    const row = fragment.querySelector<HTMLElement>(".pos-tender-row");
    if (!row) return;
    const line = tenderLine(row);
    const methodLabel = row.querySelector<HTMLElement>(
      '[data-field="type-label"]'
    );
    const referenceLabel = row.querySelector<HTMLElement>(
      '[data-field="reference-label"]'
    );
    if (methodLabel) methodLabel.textContent = msg("labelMethod");
    if (referenceLabel) referenceLabel.textContent = msg("labelReference");
    const codeLabel = row.querySelector<HTMLElement>(
      '[data-field="code-label"]'
    );
    if (codeLabel) codeLabel.textContent = msg("labelCode");
    line.type.value = type;
    line.type.addEventListener("change", syncTenderLines);
    line.amount.addEventListener("input", recomputeSummary);
    line.remove.addEventListener("click", () => {
      const index = tenderLines.indexOf(line);
      if (index >= 0) tenderLines.splice(index, 1);
      line.row.remove();
      syncTenderLines();
    });
    tenderLines.push(line);
    tendersEl.appendChild(fragment);
    syncTenderLines();
    if (focus) line.amount.focus();
  }

  function resetTenderLines(): void {
    tenderLines.length = 0;
    if (tendersEl) tendersEl.textContent = "";
    addTenderLine("cash", false);
  }

  type Plan = {
    totalCents: bigint;
    nonCashCents: bigint;
    cashCount: number;
    cashHandedCents: bigint;
    appliedCashCents: bigint;
    changeCents: bigint;
    dueCents: bigint;
    overpaid: boolean;
    badAmount: boolean;
  };

  /**
   * Mirrors `domain/payment-allocation.ts`'s `planTenders` in `bigint` cents
   * (ADR-0003): non-cash lines first, cash applied to what is left, change
   * from the cash line only. The preview runs against the cart SUBTOTAL; the
   * server adds store tax and its own plan is what the receipt prints.
   */
  function planFromLines(): Plan {
    const totalCents = cartSubtotalCents();
    let nonCash = 0n;
    let cashHanded = 0n;
    let cashCount = 0;
    let badAmount = false;
    for (const line of tenderLines) {
      const raw = line.amount.value.trim();
      if (raw === "") continue;
      if (!MONEY.test(raw) || toCents(raw) <= 0n) {
        badAmount = true;
        continue;
      }
      if (line.type.value === "cash") {
        cashCount += 1;
        cashHanded += toCents(raw);
      } else {
        nonCash += toCents(raw);
      }
    }
    const remaining = totalCents > nonCash ? totalCents - nonCash : 0n;
    const appliedCash = cashHanded >= remaining ? remaining : cashHanded;
    const change = cashHanded - appliedCash;
    const due = totalCents - nonCash - appliedCash;
    return {
      totalCents,
      nonCashCents: nonCash,
      cashCount,
      cashHandedCents: cashHanded,
      appliedCashCents: appliedCash,
      changeCents: change,
      dueCents: due > 0n ? due : 0n,
      overpaid: nonCash > totalCents,
      badAmount
    };
  }

  function recomputeSummary(): void {
    const plan = planFromLines();
    if (sumTotalEl) sumTotalEl.textContent = fromCents(plan.totalCents);
    if (sumAppliedEl) {
      sumAppliedEl.textContent = fromCents(
        plan.nonCashCents + plan.appliedCashCents
      );
    }
    if (changeEl) {
      changeEl.textContent = fromCents(plan.changeCents);
      changeEl.dataset.tone = plan.changeCents > 0n ? "success" : "neutral";
    }
    if (sumDueEl) {
      sumDueEl.textContent = fromCents(plan.dueCents);
      sumDueEl.dataset.tone =
        plan.dueCents === 0n
          ? "neutral"
          : allowDueInput?.checked
            ? "warning"
            : "danger";
    }
  }

  function addToCart(line: Omit<CartLine, "quantity">): void {
    const existing = cart.find(
      (entry) =>
        entry.productId === line.productId && entry.variantId === line.variantId
    );
    if (existing) existing.quantity += 1;
    else cart.push({ ...line, quantity: 1 });
    renderCart();
    if (searchResults) searchResults.textContent = "";
    if (searchInput) {
      searchInput.value = "";
      searchInput.focus();
    }
  }

  // Issue #292 (ADR-0032) - the scan/shortcut layer lives in
  // `lib/ui/pos-keyboard-client.ts`; the cart only exposes this one hook.
  if (root?.dataset.barcodeMode === "true") {
    initPosKeyboard({
      root,
      addScanned: (item, quantity) => {
        const existing = cart.find(
          (entry) =>
            entry.productId === item.productId &&
            entry.variantId === item.variantId
        );
        if ((existing?.quantity ?? 0) + quantity > item.stock) return "stock";
        if (existing) existing.quantity += quantity;
        else cart.push({ ...item, quantity });
        renderCart();
        return "added";
      }
    });
  }

  function renderResults(items: ProductHit[]): void {
    if (!searchResults || !resultTemplate) return;
    searchResults.textContent = "";
    const sellable = items.filter((item) => item.status === "active");
    if (sellable.length === 0) {
      const li = document.createElement("li");
      li.className = "cell-muted";
      li.textContent = msg("msgNoResults");
      searchResults.appendChild(li);
      return;
    }
    for (const item of sellable.slice(0, 20)) {
      const options =
        item.variants.length > 0
          ? item.variants.map((variant) => ({
              variantId: variant.id,
              name: `${item.name} — ${variant.name}: ${variant.value}`,
              sku: variant.sku ?? item.sku,
              price: variant.price ?? item.finalPrice,
              stock: variant.stock
            }))
          : [
              {
                variantId: null,
                name: item.name,
                sku: item.sku,
                price: item.finalPrice,
                stock: item.stock
              }
            ];
      for (const option of options) {
        const fragment = resultTemplate.content.cloneNode(
          true
        ) as DocumentFragment;
        const button =
          fragment.querySelector<HTMLButtonElement>(".pos-result-btn");
        if (!button) continue;
        setField(button, "name", option.name);
        setField(button, "sku", option.sku);
        setField(button, "price", option.price);
        setField(
          button,
          "stock",
          option.stock > 0 ? `×${option.stock}` : msg("msgOutOfStock")
        );
        button.disabled = option.stock <= 0;
        button.addEventListener("click", () =>
          addToCart({
            productId: item.id,
            variantId: option.variantId,
            name: option.name,
            price: option.price,
            stock: option.stock
          })
        );
        searchResults.appendChild(fragment);
      }
    }
  }

  let searchTimer: ReturnType<typeof setTimeout> | null = null;
  let searchSequence = 0;
  searchInput?.addEventListener("input", () => {
    if (searchTimer) clearTimeout(searchTimer);
    const query = searchInput.value.trim();
    if (query.length < 2) {
      if (searchResults) searchResults.textContent = "";
      return;
    }
    searchTimer = setTimeout(async () => {
      const sequence = ++searchSequence;
      try {
        // A read, so the shared mutation helpers do not apply — the same
        // same-origin GET `commerce-orders.astro` uses for its detail panel.
        const response = await fetch(
          `/api/v1/commerce/products?q=${encodeURIComponent(query)}&status=active`,
          { credentials: "same-origin" }
        );
        const payload = (await response.json().catch(() => null)) as {
          success?: boolean;
          data?: { items?: ProductHit[] };
        } | null;
        if (sequence !== searchSequence) return;
        if (!response.ok || !payload?.success) {
          saleError.show(msg("msgSearchFailed"));
          return;
        }
        saleError.clear();
        renderResults(payload.data?.items ?? []);
      } catch {
        if (sequence === searchSequence) saleError.show(msg("msgSearchFailed"));
      }
    }, 250);
  });

  el<HTMLButtonElement>("pos-add-tender")?.addEventListener("click", () => {
    // New lines default to QRIS: the first line is cash, and a second cash
    // line is refused (one cash tender per sale).
    addTenderLine("manual_qris", true);
  });
  allowDueInput?.addEventListener("change", syncTenderLines);

  el<HTMLButtonElement>("pos-clear")?.addEventListener("click", () => {
    cart.length = 0;
    renderCart();
  });

  // Issue #286 (ADR-0029) - hold / resume. A held sale stores lines only (no
  // prices, no stock reservation); resuming puts the lines back in the cart
  // and the ordinary checkout re-prices them.
  el<HTMLButtonElement>("pos-hold")?.addEventListener(
    "click",
    async (event) => {
      saleError.clear();
      if (cart.length === 0) {
        saleError.show(msg("msgEmptyCart"));
        return;
      }
      const button = event.currentTarget as HTMLButtonElement;
      const unlock = lockElement(button, button.textContent ?? "");
      try {
        const name = (
          el<HTMLInputElement>("pos-customer-name")?.value ?? ""
        ).trim();
        const phone = (
          el<HTMLInputElement>("pos-customer-phone")?.value ?? ""
        ).trim();
        const notes = (
          el<HTMLTextAreaElement>("pos-notes")?.value ?? ""
        ).trim();
        const registerId = registerEl?.value ?? "";
        const { ok, errorCode } = await sendJsonForData(
          "POST",
          "/api/v1/commerce/held-sales",
          {
            lines: cart.map((line) => ({
              productId: line.productId,
              variantId: line.variantId,
              quantity: line.quantity
            })),
            customer:
              name || phone
                ? { name: name || null, phone: phone || null }
                : null,
            notes: notes || null,
            ...(registerId !== "" ? { registerId } : {})
          },
          { "Idempotency-Key": crypto.randomUUID() }
        );
        if (!ok) {
          saleError.show(
            errorCode === "HELD_SALE_LIMIT"
              ? msg("msgHeldLimit")
              : msg("msgHoldFailed")
          );
          return;
        }
        window.location.reload();
      } finally {
        unlock();
      }
    }
  );

  el<HTMLButtonElement>("pos-resume")?.addEventListener(
    "click",
    async (event) => {
      saleError.clear();
      const id = el<HTMLSelectElement>("pos-held-select")?.value ?? "";
      if (id === "") return;
      const button = event.currentTarget as HTMLButtonElement;
      const unlock = lockElement(button, button.textContent ?? "");
      try {
        const { ok, errorCode, data } = await sendJsonForData<{
          cart: {
            lines: {
              productId: string;
              variantId: string | null;
              quantity: number;
            }[];
            customer: { name: string | null; phone: string | null } | null;
            notes: string | null;
          };
        }>(
          "POST",
          `/api/v1/commerce/held-sales/${id}/resume`,
          {},
          {
            "Idempotency-Key": crypto.randomUUID()
          }
        );
        if (!ok || !data) {
          saleError.show(
            errorCode === "HELD_SALE_EXPIRED"
              ? msg("msgHeldExpired")
              : errorCode === "HELD_SALE_NOT_HELD"
                ? msg("msgHeldGone")
                : msg("msgResumeFailed")
          );
          return;
        }
        // Re-read each product (price, stock, variants) rather than trusting
        // anything stored: the cart comes back as ids and quantities only.
        const hits = new Map<string, ProductHit>();
        for (const line of data.cart.lines) {
          if (hits.has(line.productId)) continue;
          const response = await fetch(
            `/api/v1/commerce/products/${line.productId}`,
            {
              credentials: "same-origin"
            }
          );
          const payload = (await response.json().catch(() => null)) as {
            success?: boolean;
            data?: ProductHit;
          } | null;
          if (response.ok && payload?.success && payload.data) {
            hits.set(line.productId, payload.data);
          }
        }
        cart.length = 0;
        for (const line of data.cart.lines) {
          const hit = hits.get(line.productId);
          if (!hit) continue;
          const variant = hit.variants.find(
            (entry) => entry.id === line.variantId
          );
          cart.push({
            productId: hit.id,
            variantId: line.variantId,
            name: variant
              ? `${hit.name} — ${variant.name}: ${variant.value}`
              : hit.name,
            price: variant?.price ?? hit.finalPrice,
            stock: variant ? variant.stock : hit.stock,
            quantity: line.quantity
          });
        }
        const nameInput = el<HTMLInputElement>("pos-customer-name");
        const phoneInput = el<HTMLInputElement>("pos-customer-phone");
        const notesInput = el<HTMLTextAreaElement>("pos-notes");
        if (nameInput) nameInput.value = data.cart.customer?.name ?? "";
        if (phoneInput) phoneInput.value = data.cart.customer?.phone ?? "";
        if (notesInput) notesInput.value = data.cart.notes ?? "";
        el<HTMLElement>("pos-held")
          ?.querySelector<HTMLOptionElement>(`option[value="${id}"]`)
          ?.remove();
        renderCart();
      } finally {
        unlock();
      }
    }
  );

  function renderReceipt(order: PosOrderResponse): void {
    if (!receiptWrapper) return;
    const set = (name: string, text: string) => {
      const node = receiptWrapper.querySelector<HTMLElement>(
        `[data-receipt="${name}"]`
      );
      if (node) node.textContent = text;
    };
    set("orderCode", order.orderCode);
    set("createdAt", new Date(order.createdAt).toLocaleString());
    set(
      "customer",
      order.customer.name === msg("walkInName")
        ? msg("labelWalkIn")
        : `${order.customer.name} ${order.customer.phone}`
    );
    set("subtotal", order.subtotal);
    set("tax", order.tax);
    set("total", order.total);
    set("change", order.change ?? "—");

    // One entry per tender (Issue #285): the amount APPLIED, and for the cash
    // leg what was handed over. Built with `textContent` (never `innerHTML`).
    const payments = receiptWrapper.querySelector<HTMLElement>(
      '[data-receipt="payments"]'
    );
    if (payments) {
      payments.textContent = "";
      const methodNames: Record<string, string> = {
        cash: msg("labelCash"),
        manual_qris: msg("labelQris"),
        manual_bank_transfer: msg("labelBank"),
        gift_card: msg("labelGiftCard"),
        store_credit: msg("labelStoreCredit")
      };
      const addRow = (label: string, value: string) => {
        const dt = document.createElement("dt");
        dt.textContent = label;
        const dd = document.createElement("dd");
        dd.textContent = value;
        payments.append(dt, dd);
      };
      for (const payment of order.payments ?? []) {
        if (payment.kind !== "payment" || payment.status !== "succeeded") {
          continue;
        }
        addRow(
          `${methodNames[payment.tenderType] ?? payment.tenderType}${
            payment.storedValue ? ` ${payment.storedValue.maskedCode}` : ""
          }`,
          payment.amount
        );
        if (payment.tenderedAmount !== null) {
          addRow(msg("labelTendered"), payment.tenderedAmount);
        }
      }
    }
    const outstanding = order.settlement.outstanding;
    const owing = outstanding !== "0.00";
    const outstandingLabel = receiptWrapper.querySelector<HTMLElement>(
      '[data-receipt="outstanding-label"]'
    );
    const outstandingValue = receiptWrapper.querySelector<HTMLElement>(
      '[data-receipt="outstanding"]'
    );
    if (outstandingLabel) outstandingLabel.hidden = !owing;
    if (outstandingValue) {
      outstandingValue.hidden = !owing;
      outstandingValue.textContent = outstanding;
    }

    const lines = receiptWrapper.querySelector<HTMLElement>(
      '[data-receipt="lines"]'
    );
    if (lines) {
      lines.textContent = "";
      for (const line of order.lines) {
        const row = document.createElement("tr");
        const name = document.createElement("td");
        name.textContent = line.variantName
          ? `${line.name} — ${line.variantName}`
          : line.name;
        const qty = document.createElement("td");
        qty.textContent = String(line.quantity);
        const amount = document.createElement("td");
        amount.textContent = line.lineTotal;
        row.append(name, qty, amount);
        lines.appendChild(row);
      }
    }
    receiptWrapper.hidden = false;
    receiptWrapper.scrollIntoView({ block: "start" });
  }

  checkoutForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    saleError.clear();

    if (cart.length === 0) {
      saleError.show(msg("msgEmptyCart"));
      return;
    }
    const submit = el<HTMLButtonElement>("pos-submit");
    if (!submit) return;

    const data = new FormData(checkoutForm);
    const name = String(data.get("name") ?? "").trim();
    const phone = String(data.get("phone") ?? "").trim();
    const notes = String(data.get("notes") ?? "").trim();
    const allowDue = allowDueInput?.checked === true;

    // Issue #284 - with register mode on, the sale names the register it is
    // rung up on (the server re-checks the open session and the cashier).
    const registerId = registerEl?.value ?? "";
    if (registerMode && registerId === "") {
      saleError.show(msg("msgRegisterRequired"));
      return;
    }

    const plan = planFromLines();
    const filled = tenderLines.filter(
      (line) => line.amount.value.trim() !== ""
    );
    if (plan.badAmount) {
      saleError.show(msg("msgBadAmount"));
      return;
    }
    if (plan.cashCount > 1) {
      saleError.show(msg("msgTwoCash"));
      return;
    }
    if (
      filled.some(
        (line) =>
          isStoredValue(line.type.value) && line.code.value.trim() === ""
      )
    ) {
      saleError.show(msg("msgCodeRequired"));
      return;
    }
    if (plan.overpaid) {
      saleError.show(msg("msgOverpayment"));
      return;
    }
    if (filled.length === 0 && !allowDue) {
      saleError.show(msg("msgNoTender"));
      return;
    }
    if (plan.dueCents > 0n && !allowDue) {
      saleError.show(msg("msgInsufficient"));
      return;
    }
    if (plan.dueCents > 0n && phone === "") {
      saleError.show(msg("msgDuePhone"));
      el<HTMLInputElement>("pos-customer-phone")?.focus();
      return;
    }

    // ONE key per attempt-set: a network retry of this same submission
    // replays the same sale; a fresh submission (after the cart changed)
    // gets a fresh key. `admin-form-client`'s own idiom.
    const idempotencyKey = crypto.randomUUID();
    const unlock = lockElement(submit, msg("busyLabel"));
    try {
      const {
        ok,
        errorCode,
        data: order
      } = await sendJsonForData<PosOrderResponse>(
        "POST",
        "/api/v1/commerce/pos/orders",
        {
          customer: { name: name || null, phone: phone || null },
          lines: cart.map((line) => ({
            productId: line.productId,
            variantId: line.variantId,
            quantity: line.quantity
          })),
          // The explicit multi-tender contract (Issue #285). Non-cash: the
          // amount applied; cash: the amount handed over — the server derives
          // the applied amount and the change from the cash line only.
          tenders: filled.map((line) => ({
            tenderType: line.type.value,
            amount: fromCents(toCents(line.amount.value.trim())),
            reference:
              line.type.value === "cash" || isStoredValue(line.type.value)
                ? null
                : line.reference.value.trim() || null,
            // Issue #288 - the code is sent once, in this request, and
            // resolved server-side; it is never stored or echoed back.
            ...(isStoredValue(line.type.value)
              ? { storedValueCode: line.code.value.trim() }
              : {})
          })),
          ...(allowDue ? { allowDue: true } : {}),
          ...(registerId !== "" ? { registerId } : {}),
          notes: notes || null
        },
        { "Idempotency-Key": idempotencyKey }
      );

      if (!ok || !order) {
        const messages: Record<string, string> = {
          CART_CHANGED: msg("msgCartChanged"),
          INSUFFICIENT_TENDER: msg("msgInsufficient"),
          OVERPAYMENT: msg("msgOverpayment"),
          ACCESS_DENIED: msg("msgDueDenied"),
          FEATURE_DISABLED: msg("msgFeatureDisabled"),
          STORED_VALUE_NOT_FOUND: msg("msgSvNotFound"),
          STORED_VALUE_UNAVAILABLE: msg("msgSvUnavailable"),
          STORED_VALUE_INSUFFICIENT: msg("msgSvInsufficient"),
          STORED_VALUE_LOOKUP_THROTTLED: msg("msgSvThrottled"),
          REGISTER_SESSION_REQUIRED: msg("msgRegisterSessionRequired"),
          REGISTER_SESSION_CLOSING: msg("msgRegisterSessionClosing"),
          NOT_SESSION_CASHIER: msg("msgNotSessionCashier"),
          RESOURCE_NOT_FOUND: msg("msgRegisterNotFound"),
          VALIDATION_ERROR: phone ? msg("msgInvalidPhone") : msg("msgGeneric")
        };
        saleError.show(messages[errorCode ?? ""] ?? msg("msgGeneric"));
        return;
      }

      renderReceipt(order);
      cart.length = 0;
      renderCart();
      checkoutForm.reset();
      resetTenderLines();
    } finally {
      unlock();
    }
  });

  el<HTMLButtonElement>("pos-print")?.addEventListener("click", () => {
    window.print();
  });
  el<HTMLButtonElement>("pos-new-sale")?.addEventListener("click", () => {
    if (receiptWrapper) receiptWrapper.hidden = true;
    searchInput?.focus();
  });

  resetTenderLines();
  renderCart();
</script>
