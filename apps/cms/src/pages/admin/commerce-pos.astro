  {allowed && posEnabled && tab === "history" && canReadHistory && history && (
    <section
      class="fade-in-up"
      id="pos-history"
      aria-labelledby="pos-history-heading"
    >
      <h2 id="pos-history-heading">{t("History")}</h2>

      <form
        class="admin-create-form"
        method="get"
        role="search"
        id="pos-history-filter"
