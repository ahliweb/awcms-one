                </select>
              </label>
              <button type="button" class="btn-inline" id="pos-resume">
                {t("Resume held sale")}
              </button>
            </div>
          )}
        </form>
      </div>

      <section
        class="admin-panel pos-receipt-wrapper"
        id="pos-receipt-wrapper"
        aria-labelledby="pos-receipt-heading"
        hidden
      >
        <div class="row-actions pos-receipt-actions">
          <h2 id="pos-receipt-heading">{t("Receipt")}</h2>
          <button type="button" class="module-toggle" id="pos-print">
            {t("Print receipt")}
          </button>
          <button type="button" class="btn-inline" id="pos-new-sale">
            {t("Start another sale")}
          </button>
        </div>
        <div class="pos-receipt" id="pos-receipt">
          <p class="pos-receipt-store" id="pos-receipt-store">
            {storeName}
          </p>
          <p class="pos-receipt-meta">
            <span>{t("Order")}</span> <span data-receipt="orderCode" />
          </p>
          <p class="pos-receipt-meta">
            <span>{t("Date")}</span> <span data-receipt="createdAt" />
          </p>
          <p class="pos-receipt-meta">
            <span>{t("Customer")}</span> <span data-receipt="customer" />
          </p>
          <table class="pos-receipt-lines">
            <thead>
              <tr>
                <th scope="col">{t("Item")}</th>
                <th scope="col">{t("Qty")}</th>
                <th scope="col">{t("Amount")}</th>
              </tr>
            </thead>
            <tbody data-receipt="lines" />
          </table>
          <dl class="pos-receipt-totals">
            <dt>{t("Subtotal")}</dt>
            <dd data-receipt="subtotal" />
            <dt>{t("Tax")}</dt>
            <dd data-receipt="tax" />
            <dt>{t("Total")}</dt>
            <dd data-receipt="total" />
          </dl>
          <dl class="pos-receipt-totals" data-receipt="payments" />
          <dl class="pos-receipt-totals">
            <dt>{t("Change")}</dt>
            <dd data-receipt="change" />
