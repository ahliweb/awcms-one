              </label>
            )}
            <label for="pos-notes">
              {t("Notes")}
              <textarea id="pos-notes" name="notes" rows="2" maxlength="1000" />
            </label>
          </fieldset>

          <div class="admin-form-actions">
            <button type="submit" class="module-toggle" id="pos-submit">
              {t("Complete sale")}
            </button>
            <button type="button" class="btn-inline" id="pos-clear">
              {t("Clear cart")}
            </button>
            {canHold && (
              <button type="button" class="btn-inline" id="pos-hold">
                {t("Hold sale")}
              </button>
            )}
          </div>
          {canResumeHeld && heldSales.length > 0 && (
            <div class="admin-form-actions" id="pos-held">
              <label for="pos-held-select">
                {t("Held sales")}
                <select id="pos-held-select">
                  {heldSales.map((sale) => (
                    <option value={sale.id}>
                      {sale.label ?? sale.id.slice(0, 8)} · {sale.lineCount}
                    </option>
