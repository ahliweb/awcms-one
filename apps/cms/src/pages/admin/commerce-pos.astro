              aria-live="polite"
              aria-label={t("Payment summary")}
            >
              <dt>{t("Total")}</dt>
              <dd>
                <output class="pos-money" id="pos-sum-total">
                  0.00
                </output>
              </dd>
              <dt>{t("Applied to the sale")}</dt>
              <dd>
                <output class="pos-money" id="pos-sum-applied">
                  0.00
                </output>
              </dd>
              <dt>{t("Change")}</dt>
              <dd>
                <output
                  class="admin-status-pill pos-money"
                  data-tone="neutral"
                  id="pos-change"
                >
                  0.00
                </output>
              </dd>
              <dt>{t("Balance due")}</dt>
              <dd>
                <output
                  class="admin-status-pill pos-money"
                  data-tone="neutral"
                  id="pos-sum-due"
