---
/**
 * `/admin/commerce-reports` — sales reports (Issue #117, epic #33 C8,
 * contract #106 / ADR-0017 D7). Three tables over one date range, read
 * straight from the `commerce.sales_*` projection tables the `reporting`
 * engine maintains (sql/933): sales by day, by product, by category.
 *
 * Entry is `reporting.dashboard.read` — the same permission the three
 * `GET /api/v1/reports/commerce/*` routes gate on. Three OPTIONAL panels ride
 * on the reporting module's own permissions and appear only when held:
 *
 *   - freshness of each projection (`reporting.projections.read`), read
 *     through the same `projection-directory.ts` `/admin/reporting` uses;
 *   - "Export CSV" per projection (`reporting.exports.export`) — a POST to the
 *     REAL `/api/v1/reports/exports/trigger` endpoint with a fresh
 *     `Idempotency-Key`, exactly as `/admin/reporting`'s on-demand export
 *     does, never a bespoke download route: the artifact is written by the
 *     same generator, checksummed, and served by the same download endpoint
 *     that re-checks RBAC/ABAC and refuses an expired file;
 *   - the most recent export runs of the three projections with their
 *     download links (`reporting.exports.read`).
 *
 * The date range is a plain GET form (works without JavaScript, ships no
 * bundle for the filter itself) validated by the same
 * `validateSalesReportRange` the API routes use, so the screen and the API
 * can never disagree about defaults or bounds. Money renders through
 * `formatCurrency` in IDR: the projection stores `numeric(14,2)` strings and
 * the wire keeps them as strings (ADR-0003); only the presentation formats.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import CommerceOperationalReports from "../../components/CommerceOperationalReports.astro";
import CommerceRetentionReport from "../../components/CommerceRetentionReport.astro";
import "../../styles/admin-screens.css";
import { loadAdminScreen } from "../../lib/auth/admin-screen";
import { logAdminPageError } from "../../lib/logging/error-log";
import { getTranslatorFor } from "../../lib/i18n";
import { formatCurrency, formatNumber } from "../../lib/i18n/format";
import {
  commerceLabel,
  createCommerceLabels,
  reportFreshnessTone,
  reportRunStatusTone
} from "../../lib/ui/commerce-admin-labels";
import {
  listSalesByCategory,
  listSalesByProduct,
  listSalesDaily
} from "../../modules/commerce/application/sales-report-directory";
import {
  MAX_SALES_BY_PRODUCT_LIMIT,
  validateSalesReportRange
} from "../../modules/commerce/domain/sales-report-query";
import {
  SALES_BY_CATEGORY_PROJECTION_KEY,
  SALES_BY_PRODUCT_PROJECTION_KEY,
  SALES_DAILY_PROJECTION_KEY,
  SALES_REPORT_PROJECTION_KEYS
} from "../../modules/commerce/domain/sales-report-keys";
import { SALES_REPORT_TIME_ZONE } from "../../modules/commerce/domain/sales-report-deltas";
import {
  fetchCashUpReport,
  fetchExpenseReport,
  fetchLoyaltyReport,
  fetchReturnsReport,
  fetchStoredValueDailyReport,
  fetchTenderReport
} from "../../modules/commerce/application/operational-report-directory";
import { fetchRetentionReport } from "../../modules/commerce/application/retention-report-directory";
import { RETENTION_PROJECTION_KEY } from "../../modules/commerce/domain/retention";
import {
  OPERATIONAL_REPORT_PROJECTION_KEYS,
  POS_CASH_UP_VARIANCE_PROJECTION_KEY,
  POS_EXPENSE_DAILY_PROJECTION_KEY,
  POS_LOYALTY_DAILY_PROJECTION_KEY,
  POS_RETURNS_DAILY_PROJECTION_KEY,
  POS_STORED_VALUE_DAILY_PROJECTION_KEY,
  POS_TENDER_DAILY_PROJECTION_KEY
} from "../../modules/commerce/domain/operational-report-keys";
import {
  listOutstandingBalances,
  listTenderMix,
  type OutstandingBalancesReport,
  type TenderMixReport
} from "../../modules/commerce/application/payment-allocation-directory";
import { listProjectionSummariesForTenant } from "../../modules/reporting/application/projection-directory";
import type { ProjectionSummaryView } from "../../modules/reporting/application/projection-directory";
import {
  listExportRuns,
  type ExportRunRow
} from "../../modules/reporting/application/export-run-store";

const ssr = Astro.locals.ssrContext!;
const locale = Astro.locals.locale;
const { t } = getTranslatorFor(locale);
const labels = createCommerceLabels(t);

const rangeInput = {
  from: Astro.url.searchParams.get("from"),
  to: Astro.url.searchParams.get("to")
};
const rangeValidation = validateSalesReportRange(rangeInput);
// An invalid query falls back to the default window (and says so below)
// rather than rendering an error page — the same range the API defaults to.
const defaultRange = validateSalesReportRange({});
const range = rangeValidation.valid
  ? rangeValidation.value
  : defaultRange.valid
    ? defaultRange.value
    : { from: "", to: "" };
const rangeErrors = rangeValidation.valid ? [] : rangeValidation.errors;

const PRODUCT_LIMIT = 50;
// The sales projections and the POS operational ones share this screen's
// freshness and export-run panels; each projection is still listed only when
// its own `requiredPermission` is held (projection-directory filters on it).
const REPORT_PROJECTION_KEYS: readonly string[] = [
  ...SALES_REPORT_PROJECTION_KEYS,
  ...OPERATIONAL_REPORT_PROJECTION_KEYS,
  RETENTION_PROJECTION_KEY
];
const OUTSTANDING_LIMIT = 50;

const screen = await loadAdminScreen({
  ssr,
  workClass: "reporting",
  authorize: {
    moduleKey: "reporting",
    activityCode: "dashboard",
    action: "read"
  },
  load: async ({ tx, auth, can }) => {
    const [daily, byProduct, byCategory] = [
      await listSalesDaily(tx, ssr.tenantId, range),
      await listSalesByProduct(tx, ssr.tenantId, range, PRODUCT_LIMIT),
      await listSalesByCategory(tx, ssr.tenantId, range)
    ];

    const canReadProjections = await can({
      moduleKey: "reporting",
      activityCode: "projections",
      action: "read"
    });
    const canReadExports = await can({
      moduleKey: "reporting",
      activityCode: "exports",
      action: "read"
    });
    const canTriggerExport = await can({
      moduleKey: "reporting",
      activityCode: "exports",
      action: "export"
    });
    // Issue #285 — tender mix and outstanding balances read the payment
    // ledger directly; a figure about money by tender is a payments read, so
    // the two panels need `commerce.payments.read` on top of this screen's
    // own `reporting.dashboard.read` entry.
    const canReadPayments = await can({
      moduleKey: "commerce",
      activityCode: "payments",
      action: "read"
    });
    const tenderMix: TenderMixReport | null = canReadPayments
      ? await listTenderMix(tx, ssr.tenantId, range, SALES_REPORT_TIME_ZONE)
      : null;
    const outstanding: OutstandingBalancesReport | null = canReadPayments
      ? await listOutstandingBalances(tx, ssr.tenantId, {
          channel: null,
          limit: OUTSTANDING_LIMIT
        })
      : null;

    // Issue #296 (ADR-0035) - the POS operational panels. Each family needs
    // its OWN report permission on top of this screen's `reporting.dashboard
    // .read` entry; a family the caller may not read is `null` (not rendered),
    // and one whose source feature is off comes back `enabled: false` (also
    // not rendered).
    const canReadTenders = await can({
      moduleKey: "commerce",
      activityCode: "report_tenders",
      action: "read"
    });
    const canExportTenders = await can({
      moduleKey: "commerce",
      activityCode: "report_tenders",
      action: "export"
    });
    const canReadCashUps = await can({
      moduleKey: "commerce",
      activityCode: "report_cash_ups",
      action: "read"
    });
    const canExportCashUps = await can({
      moduleKey: "commerce",
      activityCode: "report_cash_ups",
      action: "export"
    });
    const canReadExpenses = await can({
      moduleKey: "commerce",
      activityCode: "report_expenses",
      action: "read"
    });
    const canExportExpenses = await can({
      moduleKey: "commerce",
      activityCode: "report_expenses",
      action: "export"
    });
    const canReadLoyalty = await can({
      moduleKey: "commerce",
      activityCode: "report_loyalty",
      action: "read"
    });
    const canExportLoyalty = await can({
      moduleKey: "commerce",
      activityCode: "report_loyalty",
      action: "export"
    });
    const canReadStoredValue = await can({
      moduleKey: "commerce",
      activityCode: "report_stored_value",
      action: "read"
    });
    const canExportStoredValue = await can({
      moduleKey: "commerce",
      activityCode: "report_stored_value",
      action: "export"
    });
    const canReadReturns = await can({
      moduleKey: "commerce",
      activityCode: "report_returns",
      action: "read"
    });
    const canExportReturns = await can({
      moduleKey: "commerce",
      activityCode: "report_returns",
      action: "export"
    });
    const operational = {
      tenders: canReadTenders
        ? await fetchTenderReport(tx, ssr.tenantId, range)
        : null,
      cashUps: canReadCashUps
        ? await fetchCashUpReport(tx, ssr.tenantId, range)
        : null,
      expenses: canReadExpenses
        ? await fetchExpenseReport(tx, ssr.tenantId, range)
        : null,
      loyalty: canReadLoyalty
        ? await fetchLoyaltyReport(tx, ssr.tenantId, range)
        : null,
      storedValue: canReadStoredValue
        ? await fetchStoredValueDailyReport(tx, ssr.tenantId, range)
        : null,
      returns: canReadReturns
        ? await fetchReturnsReport(tx, ssr.tenantId, range)
        : null,
      canExport: {
        tenders: canExportTenders,
        cashUps: canExportCashUps,
        expenses: canExportExpenses,
        loyalty: canExportLoyalty,
        storedValue: canExportStoredValue,
        returns: canExportReturns
      }
    };

    // Issue #364 (ADR-0044) - the customer-retention panel: its own read key,
    // hidden while the tenant's `retention` feature is off (the default).
    const canReadRetention = await can({
      moduleKey: "commerce",
      activityCode: "report_retention",
      action: "read"
    });
    const canExportRetention = await can({
      moduleKey: "commerce",
      activityCode: "report_retention",
      action: "export"
    });
    const retention = canReadRetention
      ? {
          report: await fetchRetentionReport(tx, ssr.tenantId, { months: 12 }),
          canExport: canExportRetention
        }
      : null;

    const projections = canReadProjections
      ? (
          await listProjectionSummariesForTenant(
            tx,
            ssr.tenantId,
            auth.grantedPermissionKeys
          )
        ).filter((projection) =>
          (REPORT_PROJECTION_KEYS as readonly string[]).includes(projection.key)
        )
      : [];

    const exportRuns = canReadExports
      ? (await listExportRuns(tx, ssr.tenantId))
          .filter((run) =>
            (REPORT_PROJECTION_KEYS as readonly string[]).includes(
              run.projectionKey
            )
          )
          .slice(0, 10)
      : [];

    return {
      daily,
      byProduct,
      byCategory,
      projections,
      exportRuns,
      canTriggerExport,
      canReadExports,
      tenderMix,
      outstanding,
      operational,
      retention
    };
  },
  onError: (error) => {
    logAdminPageError(
      "admin/commerce-reports.astro: failed to load sales reports",
      error,
      { correlationId: Astro.locals.correlationId }
    );
  }
});

const canRead = screen.state !== "denied";
const loadError = screen.state === "error";
const daily = screen.state === "allowed" ? screen.data.daily : [];
const byProduct = screen.state === "allowed" ? screen.data.byProduct : [];
const byCategory = screen.state === "allowed" ? screen.data.byCategory : [];
const projections: ProjectionSummaryView[] =
  screen.state === "allowed" ? screen.data.projections : [];
const exportRuns: ExportRunRow[] =
  screen.state === "allowed" ? screen.data.exportRuns : [];
const canTriggerExport =
  screen.state === "allowed" && screen.data.canTriggerExport;
const canReadExports = screen.state === "allowed" && screen.data.canReadExports;
const tenderMix = screen.state === "allowed" ? screen.data.tenderMix : null;
const outstanding = screen.state === "allowed" ? screen.data.outstanding : null;
const operational = screen.state === "allowed" ? screen.data.operational : null;
const retention = screen.state === "allowed" ? screen.data.retention : null;

const CURRENCY = "IDR";
const money = (value: string) =>
  formatCurrency(locale, value, CURRENCY, { maximumFractionDigits: 0 });
const count = (value: number) => formatNumber(locale, value);

const totals = daily.reduce(
  (sum, row) => ({
    ordersPaid: sum.ordersPaid + row.ordersPaid,
    gross: sum.gross + Number(row.gross),
    discount: sum.discount + Number(row.discount),
    shipping: sum.shipping + Number(row.shipping),
    net: sum.net + Number(row.net)
  }),
  { ordersPaid: 0, gross: 0, discount: 0, shipping: 0, net: 0 }
);

const PROJECTION_LABELS: Record<string, string> = {
  [SALES_DAILY_PROJECTION_KEY]: t("Sales by day"),
  [SALES_BY_PRODUCT_PROJECTION_KEY]: t("Sales by product"),
  [SALES_BY_CATEGORY_PROJECTION_KEY]: t("Sales by category"),
  [POS_TENDER_DAILY_PROJECTION_KEY]: t("Tender mix by register"),
  [POS_CASH_UP_VARIANCE_PROJECTION_KEY]: t("Cash-up variance"),
  [POS_EXPENSE_DAILY_PROJECTION_KEY]: t("Expenses by category"),
  [POS_LOYALTY_DAILY_PROJECTION_KEY]: t("Loyalty points"),
  [POS_STORED_VALUE_DAILY_PROJECTION_KEY]: t("Stored-value liability"),
  [POS_RETURNS_DAILY_PROJECTION_KEY]: t("Returns and refunds")
};

function formatAge(ageSeconds: number | null): string {
  if (ageSeconds === null) return t("never updated");
  if (ageSeconds < 90) return t("{n}s ago", { n: Math.round(ageSeconds) });
  if (ageSeconds < 5400)
    return t("{n}m ago", { n: Math.round(ageSeconds / 60) });
  if (ageSeconds < 172800)
    return t("{n}h ago", { n: Math.round(ageSeconds / 3600) });
  return t("{n}d ago", { n: Math.round(ageSeconds / 86400) });
}

function isExpired(run: ExportRunRow): boolean {
  return run.expiresAt !== null && run.expiresAt.getTime() <= Date.now();
}

function formatTimestamp(value: Date | string | null): string {
  if (value === null) return "—";
  return typeof value === "string" ? value : value.toISOString();
}
---

<AdminLayout
  title={t("Sales reports")}
  description={t(
    "Paid sales by day, product and category, from the reporting projections over the order event log. A cancellation or refund of a paid order is subtracted from the day it was paid on."
  )}
>
  {!canRead && (
    <p class="state-notice fade-in-up" id="commerce-reports-denied">
      {t("You do not have permission to view sales reports.")}
    </p>
  )}
  {canRead && loadError && (
    <p class="state-notice fade-in-up" id="commerce-reports-error">
      {t(
        "Sales reports could not be loaded right now. Please try again later."
      )}
    </p>
  )}

  {canRead && !loadError && (
    <>
      <form
        class="admin-create-form fade-in-up"
        method="get"
        role="search"
        id="sales-range-form"
      >
        <p class="form-legend">{t("Date range")}</p>
        {rangeErrors.length > 0 && (
          <p class="admin-create-error" role="alert" id="sales-range-error">
            {t(
              "The requested range was invalid — showing the default range instead."
            )}
          </p>
        )}

        <label for="sales-from">
          {t("From")}
          <input type="date" id="sales-from" name="from" value={range.from} />
        </label>

        <label for="sales-to">
          {t("To")}
          <input type="date" id="sales-to" name="to" value={range.to} />
        </label>

        <button type="submit" class="module-toggle">
          {t("Apply range")}
        </button>
        <span class="cell-muted">
          {t("Days are counted in {timeZone}.", {
            timeZone: SALES_REPORT_TIME_ZONE
          })}
        </span>
      </form>

      <p
        id="sales-export-error"
        class="admin-create-error"
        role="alert"
        hidden
      />

      <section
        class="admin-dashboard-stats fade-in-up"
        aria-label={t("Totals for the selected range")}
      >
        <div class="admin-stat-card">
          <span class="admin-stat-card-label">{t("Orders paid")}</span>
          <span class="admin-stat-card-value">{count(totals.ordersPaid)}</span>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-card-label">{t("Gross")}</span>
          <span class="admin-stat-card-value">
            {money(String(totals.gross))}
          </span>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-card-label">{t("Net")}</span>
          <span class="admin-stat-card-value">{money(String(totals.net))}</span>
        </div>
      </section>

      {projections.length > 0 && (
        <section
          class="admin-section fade-in-up"
          id="sales-projection-freshness"
          aria-labelledby="sales-freshness-title"
        >
          <h2 class="admin-section-title" id="sales-freshness-title">
            {t("Projection freshness")}
          </h2>
          <div class="admin-stat-card-grid">
            {projections.map((projection) => (
              <article class="admin-panel" data-projection-key={projection.key}>
                <h3>
                  {PROJECTION_LABELS[projection.key] ?? projection.key}
                  <span
                    class="admin-status-pill"
                    data-tone={
                      reportFreshnessTone[projection.freshness.status] ??
                      "neutral"
                    }
                    data-status={projection.freshness.status}
                  >
                    <span class="admin-status-pill-dot" aria-hidden="true" />
                    {commerceLabel(
                      labels.reportFreshnessStatus,
                      projection.freshness.status
                    )}
                  </span>
                </h3>
                <p class="cell-muted">
                  {t("Last updated {age}.", {
                    age: formatAge(projection.freshness.ageSeconds)
                  })}{" "}
                  <a class="quick-link" href="/admin/reporting">
                    {t("Rebuild or reconcile")}
                  </a>
                </p>
              </article>
            ))}
          </div>
        </section>
      )}

      <section
        class="admin-section fade-in-up"
        id="sales-daily"
        aria-labelledby="sales-daily-title"
      >
        <h2 class="admin-section-title" id="sales-daily-title">
          {t("Sales by day")}
          <span class="count-pill">{daily.length}</span>
          {canTriggerExport && (
            <button
              type="button"
              class="btn-inline sales-export-btn"
              data-projection-key={SALES_DAILY_PROJECTION_KEY}
            >
              {t("Export CSV")}
            </button>
          )}
        </h2>
        <div
          class="data-table-scroll"
          role="region"
          tabindex="0"
          aria-label={t("Sales by day")}
        >
          <table class="data-table data-table--stack" id="sales-daily-table">
            <caption>
              {t("Paid orders per day, {from} to {to}.", {
                from: range.from,
                to: range.to
              })}
            </caption>
            <thead>
              <tr>
                <th scope="col">{t("Day")}</th>
                <th scope="col">{t("Paid orders")}</th>
                <th scope="col">{t("Gross")}</th>
                <th scope="col">{t("Discount")}</th>
                <th scope="col">{t("Shipping")}</th>
                <th scope="col">{t("Net")}</th>
              </tr>
            </thead>
            <tbody>
              {daily.length === 0 ? (
                <tr>
                  <td class="data-table-empty" colspan="6">
                    <div class="empty-state">
                      <span class="empty-state-icon" aria-hidden="true">
                        ◇
                      </span>
                      <span class="empty-state-title">
                        {t("No paid sales in this range")}
                      </span>
                      <span class="empty-state-text">
                        {t(
                          "Figures appear a few minutes after an order is paid, once the projection worker has run."
                        )}
                      </span>
                    </div>
                  </td>
                </tr>
              ) : (
                daily.map((row) => (
                  <tr data-sales-day={row.day}>
                    <td data-label={t("Day")}>
                      <span class="cell-code">{row.day}</span>
                    </td>
                    <td data-label={t("Paid orders")}>
                      {count(row.ordersPaid)}
                    </td>
                    <td data-label={t("Gross")}>{money(row.gross)}</td>
                    <td data-label={t("Discount")}>{money(row.discount)}</td>
                    <td data-label={t("Shipping")}>{money(row.shipping)}</td>
                    <td data-label={t("Net")}>{money(row.net)}</td>
                  </tr>
                ))
              )}
            </tbody>
            {daily.length > 0 && (
              <tfoot>
                <tr>
                  <th scope="row">{t("Total")}</th>
                  <td data-label={t("Paid orders")}>
                    {count(totals.ordersPaid)}
                  </td>
                  <td data-label={t("Gross")}>{money(String(totals.gross))}</td>
                  <td data-label={t("Discount")}>
                    {money(String(totals.discount))}
                  </td>
                  <td data-label={t("Shipping")}>
                    {money(String(totals.shipping))}
                  </td>
                  <td data-label={t("Net")}>{money(String(totals.net))}</td>
                </tr>
              </tfoot>
            )}
          </table>
        </div>
      </section>

      {/* CSS-only tab switch (no JS, same "checkbox/radio + label" pattern
            `AdminLayout.astro`'s own sidebar drawer already uses for a
            no-script interactive control) between the two sections below —
            a `sr-only` radio pair driving `~` sibling visibility. */}
      <div
        class="admin-segmented fade-in-up"
        role="radiogroup"
        aria-label={t("Report breakdown")}
      >
        <input
          type="radio"
          name="sales-report-tab"
          id="sales-tab-product"
          class="sr-only"
          checked
        />
        <label class="admin-segmented-option" for="sales-tab-product">
          {t("Per product")}
        </label>
        <input
          type="radio"
          name="sales-report-tab"
          id="sales-tab-category"
          class="sr-only"
        />
        <label class="admin-segmented-option" for="sales-tab-category">
          {t("Per category")}
        </label>
      </div>

      <section
        class="admin-section fade-in-up"
        id="sales-by-product"
        aria-labelledby="sales-by-product-title"
      >
        <h2 class="admin-section-title" id="sales-by-product-title">
          {t("Sales by product")}
          <span class="count-pill">{byProduct.length}</span>
          {canTriggerExport && (
            <button
              type="button"
              class="btn-inline sales-export-btn"
              data-projection-key={SALES_BY_PRODUCT_PROJECTION_KEY}
            >
              {t("Export CSV")}
            </button>
          )}
        </h2>
        <div
          class="data-table-scroll"
          role="region"
          tabindex="0"
          aria-label={t("Sales by product")}
        >
          <table
            class="data-table data-table--stack"
            id="sales-by-product-table"
          >
            <caption>
              {t("Top {limit} products by gross, {from} to {to}.", {
                limit: Math.min(PRODUCT_LIMIT, MAX_SALES_BY_PRODUCT_LIMIT),
                from: range.from,
                to: range.to
              })}
            </caption>
            <thead>
              <tr>
                <th scope="col">{t("Product")}</th>
                <th scope="col">{t("Quantity")}</th>
                <th scope="col">{t("Gross")}</th>
              </tr>
            </thead>
            <tbody>
              {byProduct.length === 0 ? (
                <tr>
                  <td class="data-table-empty" colspan="3">
                    <div class="empty-state">
                      <span class="empty-state-icon" aria-hidden="true">
                        ◇
                      </span>
                      <span class="empty-state-title">
                        {t("No products sold in this range")}
                      </span>
                    </div>
                  </td>
                </tr>
              ) : (
                byProduct.map((row) => (
                  <tr data-sales-product={row.productId}>
                    <td data-label={t("Product")}>{row.productName}</td>
                    <td data-label={t("Quantity")}>{count(row.qty)}</td>
                    <td data-label={t("Gross")}>{money(row.gross)}</td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </section>

      <section
        class="admin-section fade-in-up"
        id="sales-by-category"
        aria-labelledby="sales-by-category-title"
      >
        <h2 class="admin-section-title" id="sales-by-category-title">
          {t("Sales by category")}
          <span class="count-pill">{byCategory.length}</span>
          {canTriggerExport && (
            <button
              type="button"
              class="btn-inline sales-export-btn"
              data-projection-key={SALES_BY_CATEGORY_PROJECTION_KEY}
            >
              {t("Export CSV")}
            </button>
          )}
        </h2>
        <div
          class="data-table-scroll"
          role="region"
          tabindex="0"
          aria-label={t("Sales by category")}
        >
          <table
            class="data-table data-table--stack"
            id="sales-by-category-table"
          >
            <caption>
              {t("Categories by gross, {from} to {to}.", {
                from: range.from,
                to: range.to
              })}
            </caption>
            <thead>
              <tr>
                <th scope="col">{t("Category")}</th>
                <th scope="col">{t("Quantity")}</th>
                <th scope="col">{t("Gross")}</th>
              </tr>
            </thead>
            <tbody>
              {byCategory.length === 0 ? (
                <tr>
                  <td class="data-table-empty" colspan="3">
                    <div class="empty-state">
                      <span class="empty-state-icon" aria-hidden="true">
                        ◇
                      </span>
                      <span class="empty-state-title">
                        {t("No categories sold in this range")}
                      </span>
                    </div>
                  </td>
                </tr>
              ) : (
                byCategory.map((row) => (
                  <tr data-sales-category={row.categoryId ?? "uncategorised"}>
                    <td data-label={t("Category")}>
                      {row.categoryId === null
                        ? t("Uncategorised")
                        : row.categoryName}
                    </td>
                    <td data-label={t("Quantity")}>{count(row.qty)}</td>
                    <td data-label={t("Gross")}>{money(row.gross)}</td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </section>

      {tenderMix && (
        <section
          class="admin-section fade-in-up"
          id="sales-tender-mix"
          aria-labelledby="sales-tender-mix-title"
        >
          <h2 class="admin-section-title" id="sales-tender-mix-title">
            {t("Payments by tender")}
            <span class="count-pill">{tenderMix.items.length}</span>
          </h2>
          <div
            class="data-table-scroll"
            role="region"
            tabindex="0"
            aria-label={t("Payments by tender")}
          >
            <table
              class="data-table data-table--stack"
              id="sales-tender-mix-table"
            >
              <caption>
                {t(
                  "Money received and given back per payment method, {from} to {to}, by the day each payment was recorded.",
                  { from: range.from, to: range.to }
                )}
              </caption>
              <thead>
                <tr>
                  <th scope="col">{t("Payment method")}</th>
                  <th scope="col">{t("Payments")}</th>
                  <th scope="col">{t("Received")}</th>
                  <th scope="col">{t("Reversals")}</th>
                  <th scope="col">{t("Given back")}</th>
                  <th scope="col">{t("Net")}</th>
                </tr>
              </thead>
              <tbody>
                {tenderMix.items.length === 0 ? (
                  <tr>
                    <td class="data-table-empty" colspan="6">
                      <div class="empty-state">
                        <span class="empty-state-icon" aria-hidden="true">
                          ◇
                        </span>
                        <span class="empty-state-title">
                          {t("No payments recorded in this range")}
                        </span>
                      </div>
                    </td>
                  </tr>
                ) : (
                  tenderMix.items.map((row) => (
                    <tr data-tender={row.tenderType}>
                      <th scope="row" data-label={t("Payment method")}>
                        {commerceLabel(
                          labels.paymentTenderType,
                          row.tenderType
                        )}
                      </th>
                      <td data-label={t("Payments")}>
                        {count(row.paymentCount)}
                      </td>
                      <td data-label={t("Received")}>{money(row.payments)}</td>
                      <td data-label={t("Reversals")}>
                        {count(row.reversalCount)}
                      </td>
                      <td data-label={t("Given back")}>
                        {money(row.reversals)}
                      </td>
                      <td data-label={t("Net")}>{money(row.net)}</td>
                    </tr>
                  ))
                )}
              </tbody>
              {tenderMix.items.length > 0 && (
                <tfoot>
                  <tr>
                    <th scope="row">{t("Total")}</th>
                    <td></td>
                    <td data-label={t("Received")}>
                      {money(tenderMix.totalPayments)}
                    </td>
                    <td></td>
                    <td data-label={t("Given back")}>
                      {money(tenderMix.totalReversals)}
                    </td>
                    <td data-label={t("Net")}>{money(tenderMix.totalNet)}</td>
                  </tr>
                </tfoot>
              )}
            </table>
          </div>
        </section>
      )}

      {operational && (
        <CommerceOperationalReports
          reports={operational}
          range={range}
          locale={locale}
        />
      )}

      <CommerceRetentionReport view={retention} locale={locale} />

      {outstanding && (
        <section
          class="admin-section fade-in-up"
          id="sales-outstanding"
          aria-labelledby="sales-outstanding-title"
        >
          <h2 class="admin-section-title" id="sales-outstanding-title">
            {t("Outstanding balances")}
            <span class="count-pill">{outstanding.count}</span>
          </h2>
          <p class="admin-stat-card-caption">
            {t("Total still owed across {n} orders: {amount}.", {
              n: outstanding.count,
              amount: money(outstanding.totalOutstanding)
            })}
            {outstanding.truncated && (
              <>
                {" "}
                {t("Showing the {n} largest.", { n: outstanding.items.length })}
              </>
            )}
          </p>
          <div
            class="data-table-scroll"
            role="region"
            tabindex="0"
            aria-label={t("Outstanding balances")}
          >
            <table
              class="data-table data-table--stack"
              id="sales-outstanding-table"
            >
              <caption>
                {t(
                  "Orders that still owe money, largest balance first (not cancelled or expired)."
                )}
              </caption>
              <thead>
                <tr>
                  <th scope="col">{t("Order code")}</th>
                  <th scope="col">{t("Channel")}</th>
                  <th scope="col">{t("Payment status")}</th>
                  <th scope="col">{t("Total")}</th>
                  <th scope="col">{t("Paid")}</th>
                  <th scope="col">{t("Balance due")}</th>
                </tr>
              </thead>
              <tbody>
                {outstanding.items.length === 0 ? (
                  <tr>
                    <td class="data-table-empty" colspan="6">
                      <div class="empty-state">
                        <span class="empty-state-icon" aria-hidden="true">
                          ◇
                        </span>
                        <span class="empty-state-title">
                          {t("No outstanding balances")}
                        </span>
                      </div>
                    </td>
                  </tr>
                ) : (
                  outstanding.items.map((row) => (
                    <tr data-outstanding-order={row.orderId}>
                      <th scope="row" data-label={t("Order code")}>
                        <a href={`/admin/commerce-orders/${row.orderId}`}>
                          {row.orderCode}
                        </a>
                      </th>
                      <td data-label={t("Channel")}>
                        {commerceLabel(labels.orderChannel, row.channel)}
                      </td>
                      <td data-label={t("Payment status")}>
                        {commerceLabel(labels.paymentStatus, row.paymentStatus)}
                      </td>
                      <td data-label={t("Total")}>{money(row.total)}</td>
                      <td data-label={t("Paid")}>{money(row.settled)}</td>
                      <td data-label={t("Balance due")}>
                        {money(row.outstanding)}
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {canReadExports && (
        <section
          class="admin-section fade-in-up"
          id="sales-export-runs"
          aria-labelledby="sales-export-runs-title"
        >
          <h2 class="admin-section-title" id="sales-export-runs-title">
            {t("Recent CSV exports")}
            <span class="count-pill">{exportRuns.length}</span>
          </h2>
          <p class="page-description">
            {t(
              "Each export is the full projection (every day, not just the range shown), written and checksummed by the reporting export mechanism. Downloads re-check your permission and refuse an expired file."
            )}{" "}
            <a class="quick-link" href="/admin/reporting">
              {t("Schedule recurring exports")}
            </a>
          </p>
          <div
            class="data-table-scroll"
            role="region"
            tabindex="0"
            aria-label={t("Recent CSV exports")}
          >
            <table
              class="data-table data-table--stack"
              id="sales-export-runs-table"
            >
              <caption>
                {t("Export runs of the three sales projections.")}
              </caption>
              <thead>
                <tr>
                  <th scope="col">{t("Report")}</th>
                  <th scope="col">{t("Format")}</th>
                  <th scope="col">{t("Status")}</th>
                  <th scope="col">{t("Rows")}</th>
                  <th scope="col">{t("Generated")}</th>
                  <th scope="col">{t("Artifact")}</th>
                </tr>
              </thead>
              <tbody>
                {exportRuns.length === 0 ? (
                  <tr>
                    <td class="data-table-empty" colspan="6">
                      <div class="empty-state">
                        <span class="empty-state-icon" aria-hidden="true">
                          ◇
                        </span>
                        <span class="empty-state-title">
                          {t("No exports yet")}
                        </span>
                        <span class="empty-state-text">
                          {t("Use an Export CSV button above to generate one.")}
                        </span>
                      </div>
                    </td>
                  </tr>
                ) : (
                  exportRuns.map((run) => (
                    <tr data-export-run={run.id}>
                      <td data-label={t("Report")}>
                        {PROJECTION_LABELS[run.projectionKey] ??
                          run.projectionKey}
                      </td>
                      <td data-label={t("Format")}>
                        <span class="cell-code">{run.format}</span>
                      </td>
                      <td data-label={t("Status")}>
                        <span
                          class="admin-status-pill"
                          data-tone={
                            reportRunStatusTone[run.status] ?? "neutral"
                          }
                          data-status={run.status}
                        >
                          <span
                            class="admin-status-pill-dot"
                            aria-hidden="true"
                          />
                          {commerceLabel(labels.reportRunStatus, run.status)}
                        </span>
                      </td>
                      <td data-label={t("Rows")}>{count(run.rowCount)}</td>
                      <td data-label={t("Generated")}>
                        <span class="cell-muted">
                          {formatTimestamp(run.createdAt)}
                        </span>
                      </td>
                      <td data-label={t("Artifact")}>
                        {run.status === "completed" && !isExpired(run) ? (
                          <a
                            class="quick-link"
                            href={`/api/v1/reports/exports/runs/${run.id}/download`}
                          >
                            {t("Download")}
                            <span class="quick-link-arrow" aria-hidden="true">
                              →
                            </span>
                          </a>
                        ) : (
                          <span class="cell-muted">
                            {isExpired(run) ? t("expired") : t("unavailable")}
                          </span>
                        )}
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </section>
      )}
    </>
  )}
</AdminLayout>

<script>
  // The import is load-bearing for CSP (`default-src 'self'`, no
  // `'unsafe-inline'`): it forces an external `/_astro/*.js` bundle.
  import {
    messageBox,
    mutateAndReload,
    onAction,
    sendJson
  } from "../../lib/ui/admin-form-client";

  const exportError = messageBox("sales-export-error");

  onAction(".sales-export-btn", async (button) => {
    const projectionKey = button.dataset.projectionKey;
    if (!projectionKey) return;

    await mutateAndReload(
      button,
      exportError,
      () =>
        sendJson(
          "POST",
          "/api/v1/reports/exports/trigger",
          { projectionKey, format: "csv" },
          // Fresh per click: reusing one key would replay the first response.
          { "Idempotency-Key": crypto.randomUUID() }
        ),
      "Could not generate the export. Please try again.",
      "Exporting…"
    );
  });
</script>
