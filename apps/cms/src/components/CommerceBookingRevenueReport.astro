---
/**
 * The booking revenue and hold pipeline panel (Issue #389 and #478, ADR-0045;
 * metrics spec sections 3, 3.7, 3.9 and 8.2) on `/admin/commerce-reports`:
 * the booking-sourced revenue waterfall per paid day (gross, discounts, refunds
 * counted when DECIDED and split into "paid back", "payable" and "uncollected
 * balance (no money moved)", net), the tax / shipping / insurance companions
 * after their refunded share, the balance still outstanding on open orders, the
 * refund still payable and the no-show figures, plus the live hold pipeline and
 * the separate CASH view of refunds by the day they were paid out (never mixed
 * into the waterfall). Rendered from the `commerce.booking_revenue` projection
 * and the live pipeline query through `application/booking-revenue-report.ts`
 * and `application/booking-pipeline.ts`; the page passes `null` when the caller
 * lacks `reporting.dashboard.read`, and a tenant whose `booking` feature is OFF
 * (the default) comes back `enabled: false` - both render nothing at all,
 * hidden rather than an error.
 *
 * Honesty rules from the spec show up here: a day is the day of the order's
 * first paid transition (a deposit order's whole gross lands on the deposit
 * day, and the balance still owed is shown BESIDE the waterfall, never
 * subtracted); the unpaid part of a closed order sits inside Refunds on the
 * ORIGINAL day, labelled "no money moved"; a closed day that a late event
 * changed is flagged "Restated". Held space is a pipeline line of its own - not
 * occupancy and not revenue.
 *
 * Lives under `src/components/` like `CommerceRetentionReport.astro`
 * (`access-chokepoint-check.ts` reads every `.astro` under `pages/admin/` as a
 * screen that must call `loadAdminScreen`). It does no loading of its own and
 * holds no script: the CSV link is a plain GET navigation to the waterfall
 * export route (`booking-revenue.csv`), shown only to a viewer holding its own
 * `commerce.report_booking_revenue.export` (the route re-checks it; the screen
 * itself is `reporting.dashboard.read`); the freshness panel's generic projection export stays too.
 */
import { getTranslatorFor } from "../lib/i18n";
import type { Locale } from "../lib/i18n/locales";
import { formatCurrency, formatNumber } from "../lib/i18n/format";
import type { BookingCashRefundReport } from "../modules/commerce/application/booking-cash-view";
import type { BookingPipelineReport } from "../modules/commerce/application/booking-pipeline";
import type { BookingRevenueReport } from "../modules/commerce/application/booking-revenue-report";

export type BookingRevenueView = {
  report: BookingRevenueReport;
  pipeline: BookingPipelineReport;
  cash: BookingCashRefundReport;
  canExport: boolean;
};

const { view, locale } = Astro.props as {
  view: BookingRevenueView | null;
  locale: Locale;
};

const { t } = getTranslatorFor(locale);
const count = (value: number) => formatNumber(locale, value);
const money = (value: string) =>
  formatCurrency(locale, value, "IDR", { maximumFractionDigits: 0 });
const report = view?.report ?? null;
const pipeline = view?.pipeline ?? null;
const rows = report?.enabled ? report.days : [];
const totals = report?.enabled ? report.totals : null;
const cash = view?.cash ?? null;
const cashRows = cash?.enabled ? cash.days : [];
const csvHref = report
  ? `/api/v1/reports/commerce/booking-revenue.csv?from=${report.from}&to=${report.to}`
  : "";
const hasValue = (value: string) => Number(value) !== 0;

function formatAge(seconds: number | null): string {
  if (seconds === null) return "—";
  if (seconds < 5400) return t("{n}m ago", { n: Math.round(seconds / 60) });
  if (seconds < 172800) {
    return t("{n}h ago", { n: Math.round(seconds / 3600) });
  }
  return t("{n}d ago", { n: Math.round(seconds / 86400) });
}
---

{report?.enabled && (
  <section
    class="admin-section fade-in-up"
    id="ops-booking-revenue"
    aria-labelledby="ops-booking-revenue-title"
  >
    <h2 class="admin-section-title" id="ops-booking-revenue-title">
      {t("Booking revenue")}
      <span class="count-pill">{rows.length}</span>
    </h2>
    {pipeline?.enabled && (
      <section class="admin-stat-card-grid" aria-label={t("Hold pipeline")}>
        <div class="admin-stat-card">
          <span class="admin-stat-card-label">{t("Holds")}</span>
          <span class="admin-stat-card-value" id="ops-booking-holds">
            {count(pipeline.pipeline.holds)}
          </span>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-card-label">
            {t("Held nights and slots")}
          </span>
          <span class="admin-stat-card-value" id="ops-booking-held-units">
            {count(pipeline.pipeline.units)}
          </span>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-card-label">{t("Value on hold")}</span>
          <span class="admin-stat-card-value" id="ops-booking-held-value">
            {money(pipeline.pipeline.value)}
          </span>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-card-label">{t("Oldest hold")}</span>
          <span class="admin-stat-card-value" id="ops-booking-oldest-hold">
            {formatAge(pipeline.pipeline.oldestHoldAgeSeconds)}
          </span>
        </div>
      </section>
    )}
    <div
      class="data-table-scroll"
      role="region"
      tabindex="0"
      aria-label={t("Booking revenue")}
    >
      <table
        class="data-table data-table--stack"
        id="ops-booking-revenue-table"
      >
        <caption>
          {t(
            "Revenue of orders that carry a Booking reservation, by the day the order was first paid. A refund counts when it is decided, not when the money moves, and lands on that same day with any cancellation or no-show. Tax, shipping and insurance are lowered by their share of a refund and are not revenue. The balance still owed on open orders and the refund still to be paid out are shown beside the waterfall, not subtracted. This is an operational sales measure, not a financial-statement figure: the books of record are your accounting system. Held space is not revenue."
          )}
        </caption>
        <thead>
          <tr>
            <th scope="col">{t("Day")}</th>
            <th scope="col">{t("Orders")}</th>
            <th scope="col">{t("Gross")}</th>
            <th scope="col">{t("Discounts")}</th>
            <th scope="col">{t("Refunds")}</th>
            <th scope="col">{t("Net")}</th>
            <th scope="col">{t("Companions")}</th>
            <th scope="col">{t("Balance outstanding")}</th>
            <th scope="col">{t("Refund payable")}</th>
            <th scope="col">{t("No-shows")}</th>
            <th scope="col">{t("Status")}</th>
          </tr>
        </thead>
        <tbody>
          {rows.length === 0 ? (
            <tr>
              <td class="data-table-empty" colspan="11">
                <div class="empty-state">
                  <span class="empty-state-icon" aria-hidden="true">
                    ◇
                  </span>
                  <span class="empty-state-title">
                    {t("No booking orders were paid in this period")}
                  </span>
                </div>
              </td>
            </tr>
          ) : (
            rows.map((day) => (
              <tr data-ops-booking-day={day.day}>
                <th scope="row" data-label={t("Day")}>
                  {day.day}
                </th>
                <td data-label={t("Orders")}>{count(day.orders)}</td>
                <td data-label={t("Gross")}>{money(day.gross)}</td>
                <td data-label={t("Discounts")}>{money(day.discounts)}</td>
                <td data-label={t("Refunds")}>
                  {money(day.refunds)}
                  {Number(day.refunds) > 0 && (
                    <small class="muted">
                      {t(
                        "{paidBack} paid back, {payable} payable, {uncollected} uncollected (no money moved)",
                        {
                          paidBack: money(day.refundsPaidBack),
                          payable: money(day.refundsPayable),
                          uncollected: money(day.refundsUncollected)
                        }
                      )}
                    </small>
                  )}
                </td>
                <td data-label={t("Net")}>{money(day.net)}</td>
                <td data-label={t("Companions")}>
                  {hasValue(day.tax) ||
                  hasValue(day.shipping) ||
                  hasValue(day.insurance) ? (
                    <>
                      {hasValue(day.tax) && (
                        <small class="muted">
                          {t("Tax {amount}", { amount: money(day.tax) })}
                        </small>
                      )}
                      {hasValue(day.shipping) && (
                        <small class="muted">
                          {t("Shipping {amount}", {
                            amount: money(day.shipping)
                          })}
                        </small>
                      )}
                      {hasValue(day.insurance) && (
                        <small class="muted">
                          {t("Insurance {amount}", {
                            amount: money(day.insurance)
                          })}
                        </small>
                      )}
                    </>
                  ) : (
                    "—"
                  )}
                </td>
                <td data-label={t("Balance outstanding")}>
                  {money(day.balanceOutstanding)}
                </td>
                <td data-label={t("Refund payable")}>
                  {money(day.refundPayableBalance)}
                </td>
                <td data-label={t("No-shows")}>
                  {day.noShowRatePercent === null
                    ? count(day.noShows)
                    : t("{count} of {stays} ({percent}%)", {
                        count: String(day.noShows),
                        stays: String(day.stays),
                        percent: day.noShowRatePercent
                      })}
                </td>
                <td data-label={t("Status")}>
                  {day.restated && (
                    <span class="admin-status-pill" data-tone="danger">
                      {t("Restated")}
                    </span>
                  )}
                </td>
              </tr>
            ))
          )}
        </tbody>
        {totals && rows.length > 0 && (
          <tfoot>
            <tr>
              <th scope="row">{t("Total")}</th>
              <td>{count(totals.orders)}</td>
              <td>{money(totals.gross)}</td>
              <td>{money(totals.discounts)}</td>
              <td>{money(totals.refunds)}</td>
              <td>{money(totals.net)}</td>
              <td>
                {hasValue(totals.tax) ||
                hasValue(totals.shipping) ||
                hasValue(totals.insurance)
                  ? t("Tax {amount}", { amount: money(totals.tax) })
                  : "—"}
              </td>
              <td>{money(totals.balanceOutstanding)}</td>
              <td>{money(totals.refundPayableBalance)}</td>
              <td>{count(totals.noShows)}</td>
              <td />
            </tr>
          </tfoot>
        )}
      </table>
    </div>
    {view?.canExport && (
      <p>
        <a class="module-toggle" id="ops-booking-revenue-csv" href={csvHref}>
          {t("Download CSV")}
        </a>
      </p>
    )}
    <div
      class="data-table-scroll"
      role="region"
      tabindex="0"
      aria-label={t("Refunds paid out (cash view)")}
    >
      <table class="data-table data-table--stack" id="ops-booking-cash-table">
        <caption>
          {t(
            "Refunds paid out (cash view): money that went back to customers, by the day it was paid out. This is a cash view and is separate from the table above, which counts a refund on the day the order was paid."
          )}
        </caption>
        <thead>
          <tr>
            <th scope="col">{t("Day paid out")}</th>
            <th scope="col">{t("Refund payments")}</th>
            <th scope="col">{t("Paid out")}</th>
          </tr>
        </thead>
        <tbody>
          {cashRows.length === 0 ? (
            <tr>
              <td class="data-table-empty" colspan="3">
                <div class="empty-state">
                  <span class="empty-state-icon" aria-hidden="true">
                    ◇
                  </span>
                  <span class="empty-state-title">
                    {t("No booking refunds were paid out in this period")}
                  </span>
                </div>
              </td>
            </tr>
          ) : (
            cashRows.map((day) => (
              <tr data-ops-booking-cash-day={day.day}>
                <th scope="row" data-label={t("Day paid out")}>
                  {day.day}
                </th>
                <td data-label={t("Refund payments")}>{count(day.legs)}</td>
                <td data-label={t("Paid out")}>{money(day.refundsPaidOut)}</td>
              </tr>
            ))
          )}
        </tbody>
        {cash?.enabled && cashRows.length > 0 && (
          <tfoot>
            <tr>
              <th scope="row">{t("Total")}</th>
              <td>{count(cash.totals.legs)}</td>
              <td>{money(cash.totals.refundsPaidOut)}</td>
            </tr>
          </tfoot>
        )}
      </table>
    </div>
  </section>
)}
