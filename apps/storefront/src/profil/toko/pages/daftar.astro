---
/**
 * `/daftar` — register a new account with name + phone + e-mail OTP (issue
 * #88, S1). Same two-step shape as `/masuk`; `?email=` pre-fills the e-mail
 * field (the link `/masuk`'s own `ACCOUNT_NOT_FOUND` message offers).
 *
 * `noindex, follow`; degrades to a `<noscript>` WhatsApp fallback.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getSiteIdentity } from "../../../lib/awcms/profil";
import { getStoreSettings } from "../../../lib/awcms/pemasaran";
import { ROUTES } from "../../../config/routes";
import "../../../styles/toko.css";
import "../../../styles/akun.css";

const identity = await getSiteIdentity();
const storeSettings = await getStoreSettings();
const whatsappNumber = storeSettings.whatsapp ?? identity.whatsappNumber ?? "";
const whatsappOtpEnabled = storeSettings.whatsappOtpEnabled ?? false;
---

<BaseLayout title="Daftar" description="Buat akun baru." canonicalPath="/daftar">
  <meta slot="head" name="robots" content="noindex, follow" />

  <noscript>
    <div class="container">
      <div class="toko-banner toko-banner--info">
        Pendaftaran memerlukan JavaScript aktif di peramban Anda. Anda tetap bisa menghubungi kami
        langsung melalui WhatsApp:
        {whatsappNumber && (
          <a class="toko-wa-fallback" href={`https://wa.me/${whatsappNumber.replace(/\D/g, "")}`}>
            Hubungi WhatsApp
          </a>
        )}
      </div>
    </div>
  </noscript>

  <div
    class="container"
    data-daftar-root
    data-whatsapp-number={whatsappNumber}
    data-store-name={identity.name}
    data-login-href={ROUTES.login}
  >
    <div class="page-heading">
      <h1>Daftar</h1>
    </div>

    <div data-status class="toko-banner toko-banner--info" role="status" aria-live="polite" hidden></div>

    <div data-submit-error class="toko-banner toko-banner--danger" hidden>
      <p data-submit-error-message></p>
      <p data-submit-error-link></p>
      <div class="toko-actions">
        <a data-wa-fallback-link class="toko-wa-fallback" hidden>Hubungi via WhatsApp</a>
      </div>
    </div>

    <form data-daftar-form novalidate class="akun-card">
      <section data-step="data">
        <p class="toko-field-hint" data-email-only-note>
          {
            whatsappOtpEnabled
              ? (
                <>
                  Pendaftaran akun baru menggunakan kode OTP lewat e-mail. Sudah punya akun? Anda bisa masuk lewat
                  WhatsApp di halaman <a href={ROUTES.login}>Masuk</a>.
                </>
              )
              : "Pendaftaran akun baru menggunakan kode OTP lewat e-mail."
          }
        </p>

        <div class="toko-field">
          <label for="daftar-name" class="field-label">Nama lengkap</label>
          <input type="text" id="daftar-name" name="name" required autocomplete="name" />
          <p class="toko-field-error" data-error-for="name"></p>
        </div>

        <div class="toko-field">
          <label for="daftar-phone" class="field-label">Nomor telepon</label>
          <input type="tel" id="daftar-phone" name="phone" required autocomplete="tel" class="is-mono" />
          <p class="toko-field-error" data-error-for="phone"></p>
        </div>

        <div class="toko-field">
          <label for="daftar-email" class="field-label">Alamat e-mail</label>
          <input type="email" id="daftar-email" name="email" required autocomplete="email" />
          <p class="toko-field-error" data-error-for="email"></p>
        </div>

        <div class="akun-actions">
          <button type="button" class="btn btn--primary btn--sm" data-kirim-kode>Kirim kode</button>
        </div>
      </section>

      <section data-step="code" hidden>
        <p>Kode telah dikirim ke e-mail Anda.</p>

        <div class="toko-field">
          <label for="daftar-code" class="field-label">Kode 6 digit</label>
          <input
            type="text"
            id="daftar-code"
            name="code"
            required
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]{6}"
            maxlength="6"
            class="akun-otp-input is-mono"
          />
          <p class="toko-field-error" data-error-for="code"></p>
        </div>

        <div class="akun-actions">
          <button type="submit" class="btn btn--primary btn--sm" data-verifikasi>Daftar</button>
          <button type="button" class="btn btn--quiet btn--sm" data-kirim-ulang disabled>
            Kirim ulang (<span data-countdown>60</span> detik)
          </button>
        </div>
      </section>
    </form>
  </div>

  <script>
    import "../../../scripts/daftar";
  </script>
</BaseLayout>
