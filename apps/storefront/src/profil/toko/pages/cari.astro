---
/**
 * `/cari` — the search results page. Issue #24 shipped the URL
 * (`ROUTES.search`, `?q=`) and the header's no-JS `GET` search form; this
 * issue (#27) replaces the placeholder body with a real, client-side search
 * over the build-time index `/index/produk.json` — see `src/scripts/
 * cari-listing.ts` for why the query can only be read in the BROWSER (this
 * page is prerendered ONCE, `output: "static"`) and how it re-renders this
 * page's grid from that index.
 *
 * `noindex` BOTH ways, because the two do different things: `robots.txt`'s
 * `Disallow: /cari` (see `src/pages/robots.txt.ts`) asks a crawler not to
 * FETCH this URL, while the `<meta name="robots">` below — through
 * `BaseLayout.astro`'s `head` slot (issue #27) — tells one that already has
 * the page not to INDEX it. A URL that was indexed before the rule existed,
 * or is linked from elsewhere, needs the second; a search-results page with
 * no stable content of its own should be in neither index.
 *
 * `follow` is deliberate: the product links on a results page are real
 * catalog URLs that SHOULD be crawled — it is this page, not its links,
 * that has nothing to index.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SearchForm from "../../../components/SearchForm.astro";
// Issue #137: this page IS `/cari`, so its own form always searches
// products (`PROFILE_SEARCH.toko`), whatever the header's profile-chosen
// surface is.
import { PROFILE_SEARCH } from "../../../config/profil";
---

<BaseLayout
  title="Cari Produk"
  description="Cari produk di katalog."
  canonicalPath="/cari"
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <div class="container">
    <div class="page-heading">
      <h1 data-search-heading>Cari Produk</h1>
      <SearchForm idPrefix="page-search" surface={PROFILE_SEARCH.toko} />
    </div>

    <ul class="grid-cards" data-produk-grid hidden></ul>
    <p class="empty-state" data-produk-empty>Ketik kata kunci untuk mencari produk.</p>
    <nav class="pagination" data-produk-pagination aria-label="Halaman hasil pencarian"></nav>
  </div>
</BaseLayout>

<script>
  import "../../../scripts/cari-listing";
</script>
