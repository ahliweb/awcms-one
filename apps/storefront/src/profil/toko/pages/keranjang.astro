---
/**
 * `/keranjang` — the cart page (issue #30, ADR-0007 revised).
 *
 * A static SHELL only: every number a shopper sees comes from the CMS's
 * live `POST …/cart/quote` (`src/lib/toko-klien.ts`), never computed here —
 * "Totals shown are the quote's, never computed client-side" is the
 * issue's own acceptance rule, mirroring `harga.ts`'s ADR-0003 posture one
 * layer up (this page does not even attempt the arithmetic `harga.ts`
 * would otherwise have to own). All interactivity is `src/scripts/
 * keranjang.ts`, an external module (`script-src 'self'`).
 *
 * `noindex, follow` — a cart is per-visitor state, not indexable content
 * (`robots.txt.ts` also `Disallow`s this path outright, for a crawler that
 * has not seen this meta tag yet).
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getSiteIdentity } from "../../../lib/awcms/profil";
import { getStoreSettings } from "../../../lib/awcms/pemasaran";
import "../../../styles/katalog.css";
import "../../../styles/toko.css";

const identity = await getSiteIdentity();
const storeSettings = await getStoreSettings();
const whatsappNumber = storeSettings.whatsapp ?? identity.whatsappNumber ?? "";
---

<BaseLayout title="Keranjang" description="Tinjau keranjang belanja Anda." canonicalPath="/keranjang">
  <meta slot="head" name="robots" content="noindex, follow" />

  <noscript>
    <div class="container">
      <div class="toko-banner toko-banner--info">
        Keranjang dan checkout memerlukan JavaScript aktif di peramban Anda. Anda tetap bisa memesan
        langsung melalui WhatsApp:
        {whatsappNumber && (
          <a class="toko-wa-fallback" href={`https://wa.me/${whatsappNumber.replace(/\D/g, "")}`}>
            Pesan lewat WhatsApp
          </a>
        )}
      </div>
    </div>
  </noscript>

  <div class="container" data-keranjang-root data-whatsapp-number={whatsappNumber} data-store-name={identity.name}>
    <div class="page-heading">
      <h1>Keranjang Belanja</h1>
    </div>

    <div data-quote-error class="toko-banner toko-banner--danger" hidden>
      <p data-quote-error-message>Gagal memuat harga terbaru.</p>
      <div class="toko-actions">
        <button type="button" data-quote-retry>Coba lagi</button>
        <a data-wa-fallback-link class="toko-wa-fallback" hidden>Pesan lewat WhatsApp</a>
      </div>
    </div>

    <div class="empty-state" data-keranjang-empty hidden>
      <p>Keranjang masih kosong</p>
      <p>Keranjang disimpan di peramban ini dan dikutip ulang ke server saat checkout.</p>
      <a class="btn btn--primary" href="/produk">Mulai belanja</a>
    </div>

    <div data-keranjang-body hidden class="cart-layout">
      <div class="cart-main">
        <ul class="toko-lines" data-keranjang-lines aria-live="polite"></ul>

        <div class="toko-section">
          <label class="field-label" for="voucher-code">
            Kode voucher
            <div class="toko-qty">
              <input type="text" id="voucher-code" name="voucherCode" data-voucher-input autocomplete="off" class="is-mono" />
              <button type="button" class="btn btn--secondary btn--md" data-voucher-apply>Terapkan</button>
            </div>
          </label>
          <p class="toko-field-hint" data-voucher-message></p>
        </div>
      </div>

      <aside class="cart-summary">
        <div class="toko-section" aria-live="polite" data-quote-summary>
          <h2>Ringkasan</h2>
          <div class="toko-summary" data-summary-body></div>
          <p class="toko-field-hint">Ongkir dihitung setelah kecamatan tujuan dipilih di checkout.</p>
          <div class="toko-actions">
            <a href="/checkout" class="btn btn--primary" data-checkout-link aria-disabled="true">Lanjut ke checkout</a>
            <a href="/produk" class="btn btn--secondary">Tambah produk lain</a>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script>
    import "../../../scripts/keranjang";
  </script>
</BaseLayout>
