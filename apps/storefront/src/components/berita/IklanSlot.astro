---
/**
 * One ad placement slot (issue #28, `<img>` added by issue #47) —
 * "render nothing when no placement" is simply this component rendering
 * nothing when `getAdSlot` answers `[]`.
 *
 * `PublicAdPlacement.mediaPublicUrl` (`src/lib/awcms/blog.ts`) is a real,
 * already-resolved absolute URL — issue #28 could not render it because
 * this app's CSP (`img-src 'self'`, `server/penyaji.mjs`) had no exemption
 * for the CMS's media origin. Issue #47 widens `img-src` with that origin
 * (`src/pages/csp.json.ts`, from `GET /api/v1/media/public-origin`), so the
 * creative now renders as a real `<img>` — re-verified as an absolute
 * `http(s)` URL here regardless (never trust a string from the network into
 * a `src` attribute unchecked), falling back to the original name/link text
 * for anything that does not parse. The editorial-disclosure label is
 * unchanged either way.
 */
import { getAdSlot } from "../../lib/awcms/iklan";
import type { AdPlacementKey } from "../../lib/awcms/blog";

interface Props {
  placement: AdPlacementKey;
  /** The visible section label — "Iklan" by default, matching every disclosure convention this app otherwise renders in Indonesian. */
  label?: string;
}

const { placement, label = "Iklan" } = Astro.props;
const ads = await getAdSlot(placement);

const disclosureLabel = {
  standard: null,
  advertorial: "Advertorial",
  sponsored: "Konten Bersponsor"
} as const;

/** `mediaPublicUrl` re-checked as a real `http(s)` absolute URL — see this file's own docblock. */
function creativeImageUrl(url: string): string | null {
  try {
    const parsed = new URL(url);
    return parsed.protocol === "https:" || parsed.protocol === "http:" ? url : null;
  } catch {
    return null;
  }
}
---

{ads.length > 0 && (
  <div class="ad-slot" data-placement={placement}>
    <p class="ad-slot-label">{label}</p>
    <ul class="ad-slot-list">
      {ads.map((ad) => {
        const imageUrl = creativeImageUrl(ad.mediaPublicUrl);
        return (
          <li class="ad-slot-item">
            {ad.linkUrl ? (
              <a href={ad.linkUrl} rel="noopener noreferrer sponsored" target="_blank">
                {imageUrl ? (
                  <img
                    src={imageUrl}
                    alt={ad.mediaAltText ?? ad.name}
                    loading="lazy"
                    decoding="async"
                    width="300"
                    height="250"
                    class="ad-slot-image"
                  />
                ) : (
                  ad.name
                )}
              </a>
            ) : imageUrl ? (
              <img
                src={imageUrl}
                alt={ad.mediaAltText ?? ad.name}
                loading="lazy"
                decoding="async"
                width="300"
                height="250"
                class="ad-slot-image"
              />
            ) : (
              <span>{ad.name}</span>
            )}
            {disclosureLabel[ad.contentClass] && (
              <span class="ad-slot-disclosure">{disclosureLabel[ad.contentClass]}</span>
            )}
          </li>
        );
      })}
    </ul>
  </div>
)}
