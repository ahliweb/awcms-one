---
/**
 * The news masthead + primary nav + Daerah panel (issue #48) — ported from
 * seputarborneo.com v2.4.0's `include/layout_header.php` (the `.sb-masthead`/
 * `.sb-nav`/`.sb-rel` blocks) and `js/main.js`'s `initDaerah()`.
 *
 * ## No `<img>` logo yet — TODO for A1/A8/D1
 *
 * `identity.logoMediaId` is real (`src/lib/awcms/profil.ts`), but this app
 * carries no media-object client this wave — issue #47 (A1, this same wave)
 * adds one for ARTICLE images only, and issue #48's own brief marks the
 * masthead logo explicitly OUT OF SCOPE for this issue ("the masthead logo
 * `<img>` is out of scope for you this wave — text brand mark; A8/D1
 * revisit"). The brand mark below is the site NAME, styled as a wordmark —
 * the same choice `Header.astro` already made for the commerce chrome, for
 * the same underlying reason (see that file's own docblock).
 *
 * TODO(A8/D1, issue #54/#60): once a media client resolves
 * `identity.logoMediaId` to a URL, replace the text wordmark below with
 * `<img src=... alt={identity.name} width=... height=...>`, matching
 * `layout_header.php`'s own `<img>`-or-text-fallback branch.
 *
 * ## The primary nav is rendered TWICE — issue #230
 *
 * `navUtama` is mapped into markup twice, from the same array: a desktop
 * `.primary-nav`, always open, and the mobile copy inside `.mobile-nav-
 * toggle` below (the native `<details>`/`<summary>` disclosure this
 * component always had). This mirrors `Header.astro`'s own fix for the
 * same underlying bug: a *closed* `<details>` hides its own content
 * (everything but `<summary>`) through the UA stylesheet's own
 * `::details-content { content-visibility: hidden }` rule, which no
 * author CSS on the hidden content's children can override — so, before
 * this issue, this component's ONE nav (living only inside the
 * `<details>`, reusing `global.css`'s `.mobile-nav-toggle` class the same
 * way `Header.astro` did) was never actually visible above 720px either,
 * on a `berita`-profile page. `global.css` shows exactly one of the two
 * copies by viewport width (`.primary-nav` / `.mobile-nav-toggle`, shared
 * with `Header.astro`), `display: none`-ing the other out of the
 * accessibility tree — see `global.css`'s own docblock on the rule.
 *
 * ## The Daerah panel needs no JavaScript to be COMPLETE
 *
 * All 14 links (`getDaerahList()`) render unconditionally, with no `hidden`
 * attribute in the server-rendered markup — a crawler or a no-JS reader sees
 * every one of them. The `<script>` below only ever ADDS a `hidden`
 * attribute at runtime (never the reverse on load), and only when the
 * current page is not itself a `/daerah/*` page — mirroring
 * `js/main.js`'s own `initDaerah()`, which folds the panel on init unless
 * `$sb_active_daerah` (here: `daerahActive`) says the reader is already on
 * one. This is a normal ES module Astro compiles to an external,
 * content-hashed file (not `is:inline`) — see `Header.astro`'s own docblock
 * for why that distinction is what satisfies `script-src 'self'`.
 */
import type { SiteIdentity } from "../../lib/awcms/profil";
import { getNavUtama, getDaerahList, DAERAH_PANEL_ID, type NavUtamaItem } from "../../lib/navigasi-berita";
import { ROUTES } from "../../config/routes";

interface Props {
  identity: SiteIdentity;
  /** `BeritaLayout`'s own `canonicalPath` prop, forwarded — the ONLY signal this component has for "what page is this", since no calling page passes an explicit active-rubrik flag (unlike seputarborneo's `$sb_active_rubrik`/`$sb_active_daerah` globals). */
  currentPath: string;
}

const { identity, currentPath } = Astro.props;

const navUtama = await getNavUtama();
const daerahList = await getDaerahList();

const daerahActive = currentPath.startsWith(ROUTES.region(""));

function isActive(item: NavUtamaItem): boolean {
  if (item.activePathPrefix === null) return daerahActive;
  if (item.activePathPrefix === ROUTES.home) return currentPath === ROUTES.home;
  return currentPath === item.activePathPrefix || currentPath.startsWith(`${item.activePathPrefix}/`);
}

const TOGGLE_ID = "nav-daerah-toggle";
---

<div class="nav-berita">
  <div class="container nav-berita__masthead">
    <div class="nav-berita__jenama">
      <a href={ROUTES.home} class="nav-berita__merek">{identity.name}</a>
      {/* `identity.description` — `SiteIdentity`'s own name for the CMS's
          `tagline` field (see `src/lib/awcms/profil.ts`'s docblock: "standing
          in for a description field the endpoint does not have"). Falls back
          to `DEFAULT_IDENTITY.description` when the CMS has none configured
          (`src/config/site.ts`), same as every other identity-driven page —
          never blank, never an invented string. */}
      {identity.description && <span class="nav-berita__kicker">{identity.description}</span>}
    </div>

    <form class="nav-berita__cari" action={ROUTES.newsSearch} method="get" role="search">
      <label for="nav-berita-cari" class="visually-hidden">Cari berita</label>
      <input
        id="nav-berita-cari"
        type="search"
        name="q"
        placeholder="Cari berita…"
        autocomplete="off"
      />
      <button type="submit">Cari</button>
    </form>

    <nav class="primary-nav" aria-label="Navigasi utama">
      {navUtama.map((item) => {
        const active = isActive(item);
        return item.controls ? (
          <a
            href={item.href}
            aria-expanded="true"
            aria-controls={item.controls}
            data-active={String(active)}
            aria-current={active ? "page" : undefined}
          >
            {item.label}
          </a>
        ) : (
          <a href={item.href} aria-current={active ? "page" : undefined}>
            {item.label}
          </a>
        );
      })}
    </nav>

    <details class="mobile-nav-toggle">
      <summary aria-label="Buka menu navigasi">
        <span aria-hidden="true">☰</span>
        <span class="visually-hidden">Menu</span>
      </summary>

      <nav aria-label="Navigasi utama">
        {navUtama.map((item) => {
          const active = isActive(item);
          return item.controls ? (
            <a
              href={item.href}
              id={TOGGLE_ID}
              aria-expanded="true"
              aria-controls={item.controls}
              data-active={String(active)}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          ) : (
            <a href={item.href} aria-current={active ? "page" : undefined}>
              {item.label}
            </a>
          );
        })}
      </nav>
    </details>
  </div>

  <div class="nav-berita__rel" id={DAERAH_PANEL_ID} role="region" aria-labelledby="nav-berita-rel-label">
    <div class="container nav-berita__rel-isi">
      <span class="nav-berita__rel-label" id="nav-berita-rel-label">Daerah</span>
      <div class="nav-berita__rel-tautan">
        {daerahList.map((daerah) => (
          <a
            href={ROUTES.region(daerah.slug)}
            aria-current={currentPath === ROUTES.region(daerah.slug) ? "page" : undefined}
          >
            {daerah.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  /**
   * Ported from `js/main.js`'s `initDaerah()` — see this file's own docblock
   * for why the panel is always in the DOM, `hidden` only ever ADDED here.
   */
  function initDaerahPanel(): void {
    const button = document.getElementById("nav-daerah-toggle");
    const panel = document.getElementById("panel-daerah");
    if (!(button instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;

    function setOpen(open: boolean): void {
      panel!.hidden = !open;
      button!.setAttribute("aria-expanded", String(open));
    }

    setOpen(button.dataset.active === "true");

    button.addEventListener("click", (event) => {
      event.preventDefault();
      setOpen(Boolean(panel!.hidden));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel!.hidden) {
        setOpen(false);
        button!.focus();
      }
    });
  }

  initDaerahPanel();
</script>
