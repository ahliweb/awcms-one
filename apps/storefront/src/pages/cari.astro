---
/**
 * `/cari` — the search results page (issue #24). Minimal on purpose: a
 * heading, the query echoed back safely, and a placeholder where results
 * will render. #27 replaces this page's BODY once a searchable product
 * index exists; the URL (`ROUTES.search`, `?q=`) and the header's search
 * form (`GET`, no JS) are this issue's to get right so #27 only has to fill
 * the body in.
 *
 * ## Why the query is echoed by a `<script>`, not read from `Astro.url`
 *
 * This page is prerendered (`output: "static"`, `astro.config.mjs`) — it is
 * built ONCE, with no request in flight, so `Astro.url.searchParams` is
 * always empty at build time no matter what a future visitor's URL holds.
 * A static file server also serves the SAME `cari.html` for every `?q=`
 * value (query strings do not affect which file is served). The only place
 * that can read the real query is the BROWSER, after the page loads — so
 * this file ships the "ketik kata kunci" empty state by default (correct
 * with no JavaScript at all) and a normal, externally-bundled `<script>`
 * (never `is:inline` — see `Header.astro`'s cart-count script for the same
 * CSP reasoning) swaps in the echoed query via `textContent`, which is
 * assignment, not markup — there is no HTML-injection path through it even
 * though `q` is untrusted input.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchForm from "../components/SearchForm.astro";
---

<BaseLayout
  title="Cari Produk"
  description="Cari produk di katalog."
  canonicalPath="/cari"
>
  <div class="container">
    <div class="page-heading">
      <h1>Cari Produk</h1>
      <SearchForm idPrefix="page-search" />
    </div>

    <p data-search-result class="empty-state">Ketik kata kunci untuk mencari produk.</p>
  </div>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const query = params.get("q")?.trim();

  if (query) {
    const input = document.getElementById("page-search-q");
    if (input instanceof HTMLInputElement) input.value = query;

    const result = document.querySelector("[data-search-result]");
    if (result) {
      result.classList.remove("empty-state");
      result.textContent = `Menampilkan hasil untuk "${query}" — hasil akan muncul di sini.`;
    }
  }
</script>
