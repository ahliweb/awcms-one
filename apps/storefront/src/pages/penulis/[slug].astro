---
/**
 * `/penulis/[slug]` — author archive (issue #28), byline-based: there is no
 * author entity or route in `blog_content` — `RawPost.authorTenantUserId`
 * (`src/lib/awcms/blog.ts`) is an internal account id this app never
 * surfaces, so a "penulis" page only ever exists for a post that opted in
 * to a public byline (ADR-0109). A post attributed to the publisher (no
 * byline) has no author page at all — there is nothing to slug it by.
 */
import BeritaLayout from "../../layouts/BeritaLayout.astro";
import ArtikelCard from "../../components/berita/ArtikelCard.astro";
import Sidebar from "../../components/berita/Sidebar.astro";
import { ROUTES } from "../../config/routes";
import { listAuthors, getAuthor } from "../../lib/berita";

export async function getStaticPaths() {
  const authors = await listAuthors();
  return authors.map((author) => ({ params: { slug: author.slug } }));
}

const { slug } = Astro.params as { slug: string };
const archive = await getAuthor(slug);

if (!archive) {
  throw new Error(
    `No author byline resolves to slug "${slug}". getStaticPaths() only ` +
      `ever requests a slug listAuthors() just returned, so this can only ` +
      `happen if this route is reached with a slug from somewhere else.`
  );
}

const canonicalPath = ROUTES.author(slug);
---

<BeritaLayout
  title={archive.name}
  description={`Berita oleh ${archive.name}.`}
  canonicalPath={canonicalPath}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Remah roti">
      <a href={ROUTES.home}>Beranda</a>
      <span aria-hidden="true">/</span>
      <a href={ROUTES.news}>Berita</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{archive.name}</span>
    </nav>

    <h1>{archive.name}</h1>

    {/* Issue #49: the grid sits beside the shared `Sidebar.astro`. */}
    <div class="layout-with-sidebar">
      <ul class="grid-cards">
        {archive.posts.map((post) => <ArtikelCard post={post} />)}
      </ul>

      <Sidebar />
    </div>
  </div>
</BeritaLayout>
