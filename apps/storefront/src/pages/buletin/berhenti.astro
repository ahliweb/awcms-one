---
/**
 * `/buletin/berhenti` — where the unsubscribe link in every newsletter
 * e-mail's footer lands (issue #50). Same shell/shape as `konfirmasi.astro`
 * — see that file's own docblock for the `noindex`/token/script reasoning,
 * all identical here — but the CMS route needs nothing but the token
 * (PRD §30: no session, no address).
 *
 * ## Path note (flagged in the PR, not fixed here)
 *
 * Same caveat as `konfirmasi.astro`: the CMS bakes this link from the fixed
 * `NEWSLETTER_UNSUBSCRIBE_PATH = "/newsletter/unsubscribe"`
 * (`apps/cms/src/modules/newsletter/domain/newsletter-mail.ts`), not this
 * URL. See the PR body.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/toko.css";
---

<BaseLayout
  title="Berhenti Berlangganan Buletin"
  description="Berhenti berlangganan buletin email."
  canonicalPath="/buletin/berhenti"
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <div class="container" data-buletin-unsubscribe>
    <div class="page-heading">
      <h1>Berhenti Berlangganan</h1>
    </div>

    <p data-buletin-status role="status" aria-live="polite" hidden></p>

    <noscript>
      <p class="toko-field-hint">Berhenti berlangganan memerlukan JavaScript aktif di peramban Anda.</p>
    </noscript>
  </div>
</BaseLayout>

<script>
  import "../../scripts/buletin";
</script>
