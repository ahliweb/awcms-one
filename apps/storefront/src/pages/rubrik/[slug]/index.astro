---
/**
 * `/rubrik/[slug]` — rubrik index, page 1 (issue #28). Hierarchical: a
 * child rubrik lists under its parent's breadcrumb, and the parent index
 * INCLUDES every child rubrik's posts (`getRubrik()`'s own `posts` field
 * already does this walk — see `src/lib/berita.ts`).
 */
import BeritaLayout from "../../../layouts/BeritaLayout.astro";
import RubrikBody from "../../../components/berita/RubrikBody.astro";
import { ROUTES } from "../../../config/routes";
import { getRubrikTree, getRubrik, paginate, flattenRubrikTree } from "../../../lib/berita";

export async function getStaticPaths() {
  const tree = await getRubrikTree();
  return flattenRubrikTree(tree).map((node) => ({ params: { slug: node.slug } }));
}

const { slug } = Astro.params as { slug: string };
const archive = await getRubrik(slug);

if (!archive) {
  throw new Error(
    `No rubrik with slug "${slug}" in the cached taxonomy. getStaticPaths() ` +
      `only ever requests a slug getRubrikTree() just returned, so this can ` +
      `only happen if this route is reached with a slug from somewhere else.`
  );
}

const paged = paginate(archive.posts, 1);
const canonicalPath = ROUTES.rubric(slug);
---

<BeritaLayout
  title={archive.term.name}
  description={`Berita rubrik ${archive.term.name}.`}
  canonicalPath={canonicalPath}
>
  <RubrikBody archive={archive} paged={paged} slug={slug} />
</BeritaLayout>
