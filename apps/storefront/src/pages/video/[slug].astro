---
/**
 * `/video/[slug]` — one video post's own page (issue #28). A video post is
 * still just a post — rendered through the exact same
 * `src/components/berita/ArtikelView.astro` `/berita/[slug]` uses — the
 * only difference is which posts land on which route (`isVideo`, see
 * `src/lib/berita.ts`'s `getPosts()`/`getVideo()`).
 *
 * Issue #47: this is the ONLY route a playable `videoNews` block can ever
 * render on (a video post never gets a plain `/berita/{slug}` page — see
 * the docblock above), so `src/scripts/video-facade.ts` — the click-to-load
 * swap for `src/lib/portable-text.ts`'s poster/button markup — is loaded
 * from here and nowhere else.
 *
 * Issue #54 (A8): `og:type=video.other`, `og:image` (the post's own
 * featured image when it resolved, else the SAME `hqdefault.jpg` YouTube
 * poster the card and the facade render — `post.video.thumbnail`),
 * `og:video:url` (the SAME `youtube-nocookie.com/embed/{id}` URL the facade
 * swaps in on click), `video:release_date`/`video:tag`, and a
 * `summary_large_image` Twitter card — all built by
 * `src/lib/meta-sosial.ts`'s `videoSocialMeta(post)` and passed through
 * `BeritaLayout` to `BaseLayout.astro`'s `ogType`/`meta` props. See that
 * builder's docblock for why the poster is `hqdefault`, never
 * `maxresdefault`.
 */
import BeritaLayout from "../../layouts/BeritaLayout.astro";
import ArtikelView from "../../components/berita/ArtikelView.astro";
import { ROUTES } from "../../config/routes";
import { getVideo, getPost, getRelatedPosts, getDaerah } from "../../lib/berita";
import { newsArticleSchema, breadcrumbListSchema, combineSchemas } from "../../lib/jsonld-berita";
import { videoSocialMeta, postSeoText } from "../../lib/meta-sosial";
import { getSiteIdentity } from "../../lib/awcms/profil";

export async function getStaticPaths() {
  const posts = await getVideo();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params as { slug: string };
const post = await getPost(slug);

if (!post || !post.isVideo) {
  throw new Error(
    `No video post with slug "${slug}" in the cached index. ` +
      `getStaticPaths() only ever requests a slug getVideo() just returned, ` +
      `so this can only happen if this route is reached with a slug from ` +
      `somewhere else.`
  );
}

const identity = await getSiteIdentity();
const related = await getRelatedPosts(post, 3);
const canonicalPath = ROUTES.videoArticle(post.slug);

const daerahLainnya = post.region ? await getDaerah(post.region.slug) : null;
const daerahLainnyaPosts = daerahLainnya
  ? daerahLainnya.posts.filter((p) => p.id !== post.id).slice(0, 3)
  : [];

const breadcrumbItems = [
  { name: "Beranda", path: ROUTES.home },
  { name: "Video", path: ROUTES.video },
  { name: post.title, path: canonicalPath }
];

const schema = combineSchemas(
  newsArticleSchema({
    headline: post.title,
    description: post.excerpt ?? post.metaDescription,
    canonicalPath,
    publishedAt: post.publishedAt,
    updatedAt: post.updatedAt,
    authorByline: post.authorByline,
    publisherName: identity.name,
    rubricName: post.rubric?.name ?? null
  }),
  breadcrumbListSchema(breadcrumbItems)
);

// Issue #54 (A8) — same pairing as `src/pages/berita/[slug].astro`: one
// helper for the SEO text, one builder for the OG/Twitter tags.
const seo = postSeoText(post);
const social = videoSocialMeta(post);
---

<BeritaLayout
  title={seo.title}
  description={seo.description ?? undefined}
  canonicalPath={canonicalPath}
  schema={schema}
  ogType={social.ogType}
  meta={social.meta}
>
  <ArtikelView
    post={post}
    related={related}
    daerahLainnyaPosts={daerahLainnyaPosts}
    canonicalPath={canonicalPath}
    parentLabel="Video"
    parentPath={ROUTES.video}
    videoMode="facade"
  />
</BeritaLayout>

<script>
  import "../../scripts/video-facade";
</script>
