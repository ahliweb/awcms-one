---
/**
 * The contact page. Issue #24 built the email/phone/address/WhatsApp cards
 * from `GET /api/v1/site-profile/composed` — that endpoint has neither a
 * maps-embed URL nor an FAQ list, so #24 deliberately left both out rather
 * than invent a field awcms did not send.
 *
 * Issue #27 adds both, from the SEPARATE `store-settings/public` read model
 * (`src/lib/awcms/pemasaran.ts`, per the #26⇄#27 contract) rather than from
 * `site-profile` — a different module owns this data. The maps iframe is
 * SANDBOXED and rendered ONLY when `mapsEmbedUrl` is set AND verified to be
 * a genuine Google Maps embed origin (`isGoogleMapsEmbedUrl`) — never an
 * arbitrary URL a compromised/misconfigured admin session could point at an
 * attacker-controlled page framed inside this site. The FAQ list is a plain
 * `<details>`/`<summary>` accordion — the same native, JS-free disclosure
 * pattern `Header.astro`'s mobile nav already uses.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteIdentity } from "../lib/awcms/profil";
import { getStoreSettings, isGoogleMapsEmbedUrl } from "../lib/awcms/pemasaran";
import { isGroupActive } from "../config/profil";
import "../styles/katalog.css";

const identity = await getSiteIdentity();
const storeSettings = await getStoreSettings();

const whatsappHref = identity.whatsappNumber
  ? `https://wa.me/${identity.whatsappNumber.replace(/[^\d]/g, "")}`
  : null;

const mapsEmbedUrl = isGoogleMapsEmbedUrl(storeSettings.mapsEmbedUrl) ? storeSettings.mapsEmbedUrl : null;

// Issue #137: the intro line mentions orders and products only on a build
// that sells anything (`toko` group active); a `berita`/`landing`
// deployment's contact page asks the neutral question.
const intro = isGroupActive("toko")
  ? "Ada pertanyaan tentang pesanan atau produk? Hubungi kami melalui salah satu cara di bawah ini."
  : "Ada pertanyaan atau ingin bekerja sama? Hubungi kami melalui salah satu cara di bawah ini.";
---

<BaseLayout
  title="Kontak"
  description={`Hubungi ${identity.name} melalui e-mail, telepon, atau WhatsApp.`}
  canonicalPath="/kontak"
>
  <div class="container">
    <div class="page-heading">
      <h1>Kontak {identity.name}</h1>
      <p>{intro}</p>
    </div>

    <div class="contact-grid">
      <div class="contact-card">
        <h2>Alamat</h2>
        <p>{identity.address}</p>
      </div>

      {identity.contactPhone && (
        <div class="contact-card">
          <h2>Telepon</h2>
          <p><a href={`tel:${identity.contactPhone.replace(/[^+\d]/g, "")}`}>{identity.contactPhone}</a></p>
        </div>
      )}

      {identity.contactEmail && (
        <div class="contact-card">
          <h2>E-mail</h2>
          <p><a href={`mailto:${identity.contactEmail}`}>{identity.contactEmail}</a></p>
        </div>
      )}
    </div>

    <div class="contact-actions">
      {identity.contactEmail && (
        <a class="button-primary" href={`mailto:${identity.contactEmail}`}>Kirim E-mail</a>
      )}
      {whatsappHref && (
        <a class="button-primary" href={whatsappHref} rel="noopener noreferrer" target="_blank">
          Chat WhatsApp
        </a>
      )}
    </div>

    {mapsEmbedUrl && (
      <iframe
        class="maps-embed"
        src={mapsEmbedUrl}
        title={`Peta lokasi ${identity.name}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        sandbox="allow-scripts allow-same-origin allow-popups"
      />
    )}

    {storeSettings.faqs.length > 0 && (
      <div class="faq-list">
        <h2>Pertanyaan yang Sering Diajukan</h2>
        {storeSettings.faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
