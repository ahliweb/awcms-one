---
/**
 * `/pesanan` — order tracking (issue #30, ADR-0007 revised). The order code
 * comes from `?kode=` (set by `checkout.ts` on success, or typed/bookmarked
 * by a shopper); the phone comes from `sessionStorage`
 * (`src/scripts/checkout.ts`'s `PESANAN_PHONE_KEY`) or, failing that, a
 * form on THIS page — **never the URL**, so a shared/bookmarked link never
 * leaks a phone number.
 *
 * A single static shell — `GET …/orders/{code}?phone=` is a cross-origin
 * CMS call, so there is nothing to prerender per code (the issue's own
 * text: "cannot be prerendered per code"). `/pesanan/[kode]` is
 * DELIBERATELY not built: `output: "static"` cannot express "redirect
 * `/pesanan/{any code}` to `/pesanan?kode={that code}`" without either a
 * server-side catch-all (which this app's runtime does not have — ADR-0002)
 * or enumerating every possible order code at build time (impossible, and
 * wrong even if it were, since it would need the CMS to hand out codes in
 * advance) — the documented deviation this issue anticipated.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteIdentity } from "../lib/awcms/profil";
import { getStoreSettings } from "../lib/awcms/pemasaran";
import "../styles/katalog.css";
import "../styles/toko.css";

const identity = await getSiteIdentity();
const storeSettings = await getStoreSettings();
const whatsappNumber = storeSettings.whatsapp ?? identity.whatsappNumber ?? "";
---

<BaseLayout title="Lacak Pesanan" description="Lacak status pesanan Anda." canonicalPath="/pesanan">
  <meta slot="head" name="robots" content="noindex, follow" />

  <noscript>
    <div class="container">
      <div class="toko-banner toko-banner--info">
        Melacak pesanan memerlukan JavaScript aktif di peramban Anda. Anda tetap bisa menghubungi kami
        langsung melalui WhatsApp:
        {whatsappNumber && (
          <a class="toko-wa-fallback" href={`https://wa.me/${whatsappNumber.replace(/\D/g, "")}`}>
            Hubungi WhatsApp
          </a>
        )}
      </div>
    </div>
  </noscript>

  <div class="container" data-pesanan-root data-whatsapp-number={whatsappNumber}>
    <div class="page-heading">
      <h1>Lacak Pesanan</h1>
    </div>

    <p class="toko-empty" data-no-code hidden>
      Tidak ada kode pesanan. Gunakan tautan yang dikirimkan setelah Anda memesan, atau hubungi kami jika
      kehilangan tautan tersebut.
    </p>

    <form class="toko-section" data-phone-form hidden>
      <div class="toko-field">
        <label for="pesanan-phone">Nomor WhatsApp yang digunakan saat memesan</label>
        <input type="tel" id="pesanan-phone" name="phone" required autocomplete="tel" />
      </div>
      <button type="submit">Lihat Pesanan</button>
    </form>

    <div data-order-error class="toko-banner toko-banner--danger" hidden>
      <p>Pesanan tidak ditemukan. Periksa kembali kode dan nomor WhatsApp Anda.</p>
    </div>

    <div data-order-body hidden aria-live="polite">
      <div class="toko-section">
        <h2>Status: <span data-order-status></span></h2>
        <p data-order-code></p>
        <p data-order-countdown></p>
        <ol class="toko-timeline" data-order-timeline></ol>
      </div>

      <div class="toko-section" data-payment-section hidden>
        <h2>Instruksi Pembayaran</h2>
        <div data-payment-instructions></div>
      </div>

      <div class="toko-section">
        <h2>Item</h2>
        <ul class="toko-lines" data-order-lines></ul>
        <div class="toko-summary" data-order-summary></div>
      </div>

      <div class="toko-section" data-confirm-payment-section hidden>
        <h2>Konfirmasi Pembayaran</h2>
        <form data-confirm-payment-form>
          <div class="toko-field">
            <label for="confirm-method">Metode</label>
            <select id="confirm-method" name="method">
              <option value="manual_qris">QRIS</option>
              <option value="manual_bank">Transfer Bank</option>
            </select>
          </div>
          <div class="toko-field">
            <label for="confirm-amount">Jumlah ditransfer</label>
            <input type="text" id="confirm-amount" name="amount" required />
          </div>
          <div class="toko-field" data-confirm-bank-fields>
            <label for="confirm-bank-name">Nama bank</label>
            <input type="text" id="confirm-bank-name" name="bankName" />
            <label for="confirm-account-name">Nama pemilik rekening</label>
            <input type="text" id="confirm-account-name" name="accountName" />
          </div>
          <div class="toko-field">
            <label for="confirm-transferred-at">Waktu transfer</label>
            <input type="datetime-local" id="confirm-transferred-at" name="transferredAt" required />
          </div>
          <p class="toko-field-hint" data-proof-upload-hint hidden>
            Unggah bukti pembayaran belum tersedia saat ini — cukup isi form ini, tim kami akan memverifikasi.
          </p>
          <button type="submit">Kirim Konfirmasi</button>
          <p class="toko-field-error" data-confirm-error></p>
        </form>
      </div>

      <div class="toko-actions">
        <button type="button" data-cancel-order hidden>Batalkan Pesanan</button>
        <a data-contact-wa class="toko-wa-fallback">Hubungi toko via WhatsApp</a>
      </div>
    </div>
  </div>

  <script>
    import "../scripts/pesanan";
  </script>
</BaseLayout>
