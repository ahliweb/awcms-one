---
/**
 * `/newsletter/confirm` — where the confirmation link in a subscriber's
 * inbox lands (issue #50). `?token=` is read client-side by
 * `src/scripts/buletin.ts`, which reveals the button below and POSTS only
 * when it is actually CLICKED — never on page load. A mail gateway's
 * link-scanner routinely fetches and fully renders (executes JS on) every
 * link in an incoming e-mail before the recipient sees it; an eager POST on
 * load would let the SCANNER confirm the subscription, not the reader. See
 * `buletin.ts`'s own `wireTokenPage` docblock for the full reasoning.
 *
 * `noindex, follow`: a URL that only makes sense carrying one specific
 * reader's own token has no content of its own to index, the same reasoning
 * `/cari`/`/pesanan` already give for the identical tag (see those pages'
 * own docblocks) — and `robots.txt.ts`'s `Disallow` stops a crawler
 * FETCHING it at all, belt and suspenders for the same reason.
 *
 * ## The path is a CMS CONTRACT, not this app's naming choice
 *
 * `apps/cms/src/modules/newsletter/domain/newsletter-mail.ts` bakes the
 * confirmation link from a FIXED constant, `NEWSLETTER_CONFIRM_PATH =
 * "/newsletter/confirm"` — not configurable, and not the storefront's own
 * `/buletin/*` naming convention. `subscribe.ts`'s own docblock says
 * explicitly that "the family's public surface" (this storefront, per
 * ADR-0070) is expected to serve exactly this path. This file exists at
 * `/newsletter/confirm`, honouring that contract, rather than at a
 * storefront-chosen path with a redirect layered in front of it — see
 * `apps/storefront/README.md`'s "Newsletter" section for the rest of what
 * makes an e-mailed link actually resolve to THIS storefront's origin.
 * `tests/newsletter-path-contract.test.ts` guards this path string against a
 * future upstream rename.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/toko.css";
---

<BaseLayout
  title="Konfirmasi Buletin"
  description="Konfirmasi pendaftaran buletin email Anda."
  canonicalPath="/newsletter/confirm"
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <div class="container" data-buletin-confirm>
    <div class="page-heading">
      <h1>Konfirmasi Buletin</h1>
    </div>

    <p data-buletin-status role="status" aria-live="polite" hidden></p>

    <button type="button" data-buletin-action hidden>Konfirmasi Langganan</button>

    <noscript>
      <p class="toko-field-hint">Mengonfirmasi langganan memerlukan JavaScript aktif di peramban Anda.</p>
    </noscript>
  </div>
</BaseLayout>

<script>
  import "../../scripts/buletin";
</script>
