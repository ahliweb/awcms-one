---
/**
 * `/akun/pesanan` — the signed-in shopper's own order history (issue #90,
 * S2 of #32). List view (keyset, "Muat lebih banyak") with no `?kode=`;
 * detail view, reusing `/pesanan`'s own renderer
 * (`src/lib/pesanan-render.ts`) with NO phone prompt, with one. See
 * `src/scripts/akun-pesanan.ts`'s own docblock for the full behaviour.
 *
 * `noindex, follow` — the `/akun` prefix already covers this in
 * `robots.txt.ts`'s `Disallow` list (verified, not assumed — see that
 * file).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSiteIdentity } from "../../lib/awcms/profil";
import { getStoreSettings } from "../../lib/awcms/pemasaran";
import { ROUTES } from "../../config/routes";
import "../../styles/toko.css";
import "../../styles/akun.css";

const identity = await getSiteIdentity();
const storeSettings = await getStoreSettings();
const whatsappNumber = storeSettings.whatsapp ?? identity.whatsappNumber ?? "";
---

<BaseLayout title="Pesanan Saya" description="Riwayat pesanan akun Anda." canonicalPath="/akun/pesanan">
  <meta slot="head" name="robots" content="noindex, follow" />

  <noscript>
    <div class="container">
      <div class="toko-banner toko-banner--info">
        Halaman pesanan memerlukan JavaScript aktif di peramban Anda. Anda tetap bisa menghubungi kami
        langsung melalui WhatsApp:
        {whatsappNumber && (
          <a class="toko-wa-fallback" href={`https://wa.me/${whatsappNumber.replace(/\D/g, "")}`}>
            Hubungi WhatsApp
          </a>
        )}
      </div>
    </div>
  </noscript>

  <div
    class="container"
    data-akun-pesanan-root
    data-whatsapp-number={whatsappNumber}
    data-store-name={identity.name}
  >
    <div class="page-heading">
      <h1>Pesanan Saya</h1>
      <p><a href={ROUTES.account}>&larr; Kembali ke Akun Saya</a></p>
    </div>

    <div data-submit-error class="toko-banner toko-banner--danger" hidden>
      <p data-submit-error-message></p>
      <div class="toko-actions">
        <a data-wa-fallback-link class="toko-wa-fallback" hidden>Hubungi via WhatsApp</a>
      </div>
    </div>

    <div data-guest-view class="akun-card" hidden>
      <p>Anda belum masuk.</p>
      <div class="akun-actions">
        <a href={ROUTES.login}>Masuk</a>
      </div>
    </div>

    <div data-list-view hidden>
      <p class="toko-empty" data-order-list-empty hidden>Anda belum memiliki pesanan.</p>
      <ul class="akun-nav-grid" data-order-list aria-live="polite"></ul>
      <div class="akun-actions">
        <button type="button" data-load-more hidden>Muat lebih banyak</button>
      </div>
    </div>

    <div data-detail-view hidden>
      <p><a data-back-to-list href={ROUTES.accountOrders}>&larr; Kembali ke daftar pesanan</a></p>

      <div data-order-error class="toko-banner toko-banner--danger" hidden>
        <p>Pesanan tidak ditemukan, atau bukan milik akun Anda.</p>
      </div>

      <div data-order-body hidden aria-live="polite">
        <div class="toko-section">
          <h2>Status: <span data-order-status></span></h2>
          <p data-order-code></p>
          <p data-order-countdown></p>
          <ol class="toko-timeline" data-order-timeline></ol>
        </div>

        <div class="toko-section" data-payment-section hidden>
          <h2>Pembayaran</h2>
          <div data-payment-instructions></div>
          <button type="button" data-gateway-pay hidden>Bayar sekarang</button>
          <p data-gateway-status aria-live="polite"></p>
        </div>

        <div class="toko-section">
          <h2>Item</h2>
          <ul class="toko-lines" data-order-lines></ul>
          <div class="toko-summary" data-order-summary></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import "../../scripts/akun-pesanan";
  </script>
</BaseLayout>
