---
/**
 * The page shell for every news-surface page (issue #28's page family;
 * issue #48 gives it real news chrome). Wraps `BaseLayout.astro` — which
 * owns `<head>`, `<main id="konten">`, and every other page's SEO/
 * accessibility surface — and fills its `header`/`footer` named slots with
 * the news chrome instead of the store's `Header`/`Footer`.
 *
 * ## Why named slots, not a duplicated `<head>`
 *
 * An earlier version of this file stopped wrapping `BaseLayout.astro`
 * entirely and re-implemented `<html>/<head>/<body>` itself, because
 * `BaseLayout.astro` hard-coded `<Header>`/`<Footer>` with nothing to swap
 * either. That traded one real problem for a worse one: issue #54 (A8) adds
 * OG/Twitter meta to `BaseLayout.astro`'s `<head>` and issue #56 (A10) mounts
 * the visitor-analytics beacon there, and a second, hand-duplicated `<head>`
 * in this file would silently never receive either — exactly the
 * "two copies to keep in sync by hand" trap this repo's docblock culture
 * warns about. `BaseLayout.astro`'s `header`/`footer` named slots (added by
 * this issue, see that file's own two-line change) default to the store
 * `Header`/`Footer` when a caller fills nothing — every non-news page's
 * rendered HTML is unaffected — and this file fills them with the news
 * chrome instead, while `<head>`/`<main id="konten">` stay the single,
 * shared implementation every page gets.
 *
 * `identity` is fetched here independently of `BaseLayout.astro`'s own copy
 * (`getSiteIdentity()`, `src/lib/awcms/profil.ts`) rather than threaded
 * through as a prop — that function is memoized per build
 * (`identityCache`), so this costs no second network request, the same way
 * `Ticker.astro`/`BilahUtilitas.astro`/`FooterBerita.astro` already fetch
 * their own data independently rather than receiving it from a parent.
 *
 * ## The footer newsletter box (issue #49) — one form per page, by construction
 *
 * `FooterBerita.astro`'s `<slot name="buletin" />` is filled from HERE, for
 * every news page, with issue #50's `<FormBuletin variant="footer" />` —
 * and its script, `src/scripts/buletin.ts`, is mounted from here too, once,
 * so the footer form works on every news page without each page importing
 * it. But that script wires the FIRST `[data-buletin-form]` on the page and
 * no other (`document.querySelector`, its own design for a page with one
 * form), and `src/components/berita/Sidebar.astro` renders its OWN
 * `FormBuletin variant="sidebar"` on every page that has the sidebar —
 * which comes before the footer in DOM order. Mounting the footer form
 * unconditionally would therefore ship, on every sidebar page, a footer
 * form whose submit is never intercepted: a bare `<form>` with no
 * `action`/`method` GETs its fields onto the page's own URL, putting the
 * reader's e-mail address into the address bar and the server log.
 *
 * So this layout renders the page's default slot to a string first
 * (`Astro.slots.render("default")` — the same HTML `<slot />` would have
 * emitted, re-inserted with `set:html`) and looks for the sidebar's
 * newsletter box by its exported id (`BULETIN_SIDEBAR_ID`). Present: the
 * footer box gets a link to that box instead of a second form. Absent
 * (`/daerah/{slug}`, `/mitra/{slug}`, any future sidebar-less page): the
 * footer gets the form. Detected rather than declared by a prop because a
 * prop is one more thing every sidebar page must remember to pass, and the
 * failure mode of forgetting it is the e-mail-in-URL bug above, silently.
 * The permanent fix — `buletin.ts` wiring every `[data-buletin-form]` —
 * is a one-line change to issue #50's file, outside this issue's
 * ownership; once it lands this detection can go and both forms can
 * render.
 *
 * `toko.css` is imported here for the form's `.toko-field`/`.toko-field-
 * hint`/`.toko-banner` classes — the same stylesheet `/buletin` and the
 * two token pages already import for the identical markup; 3 kB, every
 * selector class-scoped, no effect on anything else on a news page.
 */
import BaseLayout from "./BaseLayout.astro";
import BilahUtilitas from "../components/berita/BilahUtilitas.astro";
import NavBerita from "../components/berita/NavBerita.astro";
import Ticker from "../components/berita/Ticker.astro";
import FooterBerita from "../components/berita/FooterBerita.astro";
import FormBuletin from "../components/berita/FormBuletin.astro";
import { BULETIN_SIDEBAR_ID } from "../components/berita/Sidebar.astro";
import { getSiteIdentity } from "../lib/awcms/profil";
import "../styles/berita.css";
import "../styles/berita-chrome.css";
import "../styles/toko.css";

interface Props {
  title: string;
  description?: string;
  canonicalPath: string;
  schema?: Record<string, unknown>;
}

const { title, description, canonicalPath, schema } = Astro.props;

const identity = await getSiteIdentity();

// See "The footer newsletter box" in this file's docblock. The id is
// matched as a whole attribute so a longer id that merely starts with the
// same string can never count.
const konten = await Astro.slots.render("default");
const buletinDiSidebar = konten.includes(`id="${BULETIN_SIDEBAR_ID}"`);
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} schema={schema}>
  <BilahUtilitas identity={identity} slot="header" />
  <NavBerita identity={identity} currentPath={canonicalPath} slot="header" />
  <Ticker slot="header" />

  <Fragment set:html={konten} />

  {/*
    Issue #50's newsletter script, mounted once for every news page — placed
    INSIDE the default slot (not after `</BaseLayout>`, which would render
    the module tag after `</html>`); Astro bundles it as an external module
    wherever the tag sits.
  */}
  <script>
    import "../scripts/buletin";
  </script>

  {/*
    Transferring a slot: `<slot name="buletin" />` receives whatever this
    layout's OWN caller passed as `<Fragment slot="buletin">`, and
    `slot="buletin"` on that same element re-targets it into
    `FooterBerita.astro`'s own `<slot name="buletin" />` — Astro's documented
    "transferring slots" pattern. Its FALLBACK content (issue #49) is what
    every page actually gets today: the footer form, or — on a page whose
    sidebar already carries the form — a link to that box instead (see this
    file's docblock for why never both).
  */}
  <FooterBerita identity={identity} slot="footer">
    <slot name="buletin" slot="buletin">
      {buletinDiSidebar ? (
        <p class="footer-berita__buletin-tautan">
          <a href={`#${BULETIN_SIDEBAR_ID}`}>Isi formulir buletin di bilah samping &uarr;</a>
        </p>
      ) : (
        <FormBuletin variant="footer" />
      )}
    </slot>
  </FooterBerita>
</BaseLayout>
